@page "/student/personal-info"
@layout MainLayout
@using Smart_Campus_PUMUB.WebApi.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

    .modern-form-card {
        background: #ffffff;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        padding: 40px 50px;
        margin-bottom: 50px;
        box-sizing: border-box;
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 40px;
    }

        .form-header i {
            color: #2563EB;
            font-size: 1.5rem;
        }

        .form-header h2 {
            margin: 0;
            font-size: 1.4rem;
            color: #0f172a;
            font-weight: 700;
        }

    .stepper-wrapper {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 50px;
        position: relative;
    }

        .stepper-wrapper::before {
            content: '';
            position: absolute;
            top: 18px;
            left: 5%;
            right: 5%;
            height: 2px;
            background: #e2e8f0;
            z-index: 1;
        }

    .stepper-progress {
        position: absolute;
        top: 18px;
        left: 5%;
        height: 2px;
        background: #2563EB;
        z-index: 2;
        transition: width 0.3s ease;
    }

    .step-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        position: relative;
        z-index: 3;
        width: 120px;
    }

    .step-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #94a3b8;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .step-block.active .step-circle {
        background: #2563EB;
        border-color: #2563EB;
        color: white;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.2);
    }

    .step-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        text-align: center;
    }

    .step-block.active .step-label {
        color: #2563EB;
    }

    .photo-upload-wrapper {
        grid-column: span 2;
        display: flex;
        justify-content: center;
        margin-bottom: 24px;
    }

    .photo-box {
        width: 130px;
        height: 160px;
        border: 2px dashed #94a3b8;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #f8fafc;
        cursor: pointer;
        transition: all 0.2s ease;
        overflow: hidden;
        position: relative;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .photo-box:hover {
            border-color: #2563EB;
            background-color: #f0f9ff;
        }

        .photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .photo-box i {
            font-size: 2rem;
            color: #94a3b8;
            margin-bottom: 8px;
        }

    .photo-text {
        font-size: 0.75rem;
        color: #64748b;
        text-align: center;
        padding: 0 8px;
        line-height: 1.4;
    }

    .input-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 24px;
        align-items: start;
        animation: fadeIn 0.4s ease-in-out;
    }
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .doc-upload-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-top: 8px;
        align-items: stretch;
    }

    .doc-upload-grid-4 {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-top: 8px;
        align-items: stretch;
    }

    .doc-card-header {
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
        white-space: nowrap;
        overflow: hidden;
    }

    .doc-card-title {
        font-size: 0.78rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .doc-card-subtitle {
        font-size: 0.68rem;
        color: #64748b;
        white-space: nowrap;
        margin-left: 4px;
        flex-shrink: 0;
    }

    .upload-dropzone {
        border-radius: 10px;
        transition: all 0.2s ease;
        box-sizing: border-box;
        height: 110px !important;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .upload-dropzone:hover {
        border-color: #2563eb !important;
        background-color: rgba(37, 99, 235, 0.05) !important;
    }

    @@media (max-width: 850px) {
        .doc-upload-grid-4 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .doc-upload-grid-3, .doc-upload-grid-4 {
            grid-template-columns: 1fr;
        }
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group.full-width {
            grid-column: span 2;
        }

    .input-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #334155;
    }

    .modern-input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.95rem;
        color: #0f172a;
        font-family: inherit;
        background: #ffffff;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .modern-input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
        }

        .modern-input::placeholder {
            color: #94a3b8;
        }

    select.modern-input {
        cursor: pointer;
    }

    textarea.modern-input {
        resize: vertical;
        min-height: 80px;
    }

    .radio-group {
        display: flex;
        gap: 20px;
        margin-top: 5px;
    }

    .radio-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        color: #475569;
        cursor: pointer;
    }

    .table-responsive {
        overflow-x: auto;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        margin-top: 10px;
    }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        .modern-table th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 12px 16px;
            border-bottom: 1px solid #e2e8f0;
        }

        .modern-table td {
            padding: 10px 16px;
            border-bottom: 1px solid #e2e8f0;
        }

            .modern-table td .modern-input {
                padding: 8px 12px;
                border-radius: 6px;
            }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-next, .btn-submit {
        background: #2563EB;
        color: white;
        border: none;
        padding: 12px 28px;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 50px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 220px;
        height: 48px;
        gap: 8px;
        transition: background 0.2s;
    }

        .btn-next:hover, .btn-submit:hover {
            background: #0284c7;
        }

        .btn-submit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .btn-prev {
        background: #f1f5f9;
        color: #475569;
        border: none;
        padding: 12px 28px;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 50px;
        cursor: pointer;
        margin-right: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 220px;
        height: 48px;
        transition: background 0.2s;
    }

        .btn-prev:hover {
            background: #e2e8f0;
        }

    /* Modal CSS */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        backdrop-filter: blur(4px);
    }

    .modal-content {
        background: #ffffff;
        padding: 30px 40px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        max-width: 400px;
        width: 90%;
        animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-icon {
        font-size: 3.5rem;
        margin-bottom: 15px;
    }

        .modal-icon.error {
            color: #ef4444;
        }

        .modal-icon.success {
            color: #10b981;
        }

    .modal-content h3 {
        margin: 0 0 10px 0;
        color: #0f172a;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .modal-content p {
        color: #475569;
        margin-bottom: 24px;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .btn-modal {
        background: #2563EB;
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 50px;
        cursor: pointer;
        transition: background 0.2s;
        width: 100%;
    }

        .btn-modal:hover {
            background: #1d4ed8;
        }

        .btn-modal.success {
            background: #10b981;
        }

            .btn-modal.success:hover {
                background: #059669;
            }

    .review-status-panel {
        border: 1px solid #dbeafe;
        border-radius: 14px;
        background: #f8fafc;
        padding: 28px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .review-status-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 8px 14px;
        font-weight: 700;
        font-size: 0.88rem;
    }

        .status-badge.pending {
            color: #92400e;
            background: #fef3c7;
        }

        .status-badge.approved {
            color: #065f46;
            background: #d1fae5;
        }

        .status-badge.rejected {
            color: #991b1b;
            background: #fee2e2;
        }

    .review-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

        .review-actions button {
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            font-weight: 700;
            cursor: pointer;
        }

    .btn-review-primary {
        background: #2563eb;
        color: white;
    }

    .btn-review-secondary {
        background: #e2e8f0;
        color: #0f172a;
    }

    @@keyframes popIn {
        0% {
            transform: scale(0.9);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@media (max-width: 768px) {
        .modern-form-card {
            padding: 30px 20px;
        }

        .input-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .input-group.full-width {
            grid-column: span 1;
        }

        .form-header h2 {
            font-size: 1.2rem;
        }

        .btn-prev, .btn-next, .btn-submit {
            width: 100%;
            min-width: unset;
            margin-bottom: 10px;
        }

        .form-footer {
            flex-direction: column;
        }
    }
</style>

<div class="modern-form-card" style="@(IsAdminView ? "margin-top: 0; padding: 0; box-shadow: none; border: none; background: transparent;" : "margin-top: 80px;")">

    <h3 style="color: #2563EB; font-weight: 700; border-bottom: 2px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 24px; line-height: 1.5;">၁။ ကိုယ်ရေးအချက်အလက်</h3>
        <div class="input-grid">
            <!-- 💡 User ID ကို ဖောင်တွင် မပြတော့ဘဲ နောက်ကွယ်မှ Auto ခေါ်ယူရန် ပြန်ဖျောက်ထားပါသည် 💡 -->
            <input type="hidden" @bind="requestModel.UserId" />

            <!-- 📷 Passport Photo Upload Dropzone -->
            <div class="photo-upload-wrapper" style="position: relative; grid-column: span 2; display: flex; justify-content: center; margin-bottom: 15px;">
                <div class="photo-box" style="@(string.IsNullOrEmpty(PreviewImageUrl) ? "border: 2px dashed #3b82f6; background: rgba(37, 99, 235, 0.03);" : "border: 2px solid #2563EB; background: #fff;") cursor: @(IsFormDisabled ? "not-allowed" : "pointer"); position: relative; width: 150px; height: 170px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 12px; transition: all 0.2s; opacity: @(IsFormDisabled ? "0.8" : "1");">
                    @if (!string.IsNullOrEmpty(PreviewImageUrl))
                    {
                        <img src="@PreviewImageUrl" alt="Student Photo" style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px;" />
                        @if (!IsFormDisabled)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger mt-1 position-absolute bottom-0 mb-2" style="z-index: 20; font-size: 0.7rem; padding: 1px 8px;" @onclick="RemovePhoto" @onclick:stopPropagation="true">
                                <i class="fas fa-trash-alt me-1"></i> ဖျက်မည်
                            </button>
                        }
                    }
                    else
                    {
                        <i class="bi bi-cloud-arrow-up text-primary d-block mb-1" style="font-size: 2.2rem;"></i>
                        <span class="photo-text" style="font-size: 0.82rem; font-weight: 600; color: #1e40af;">ပတ်စပို့စ်အရွယ်<br>ဓာတ်ပုံ <span style="color:red; font-weight: bold;">*</span></span>
                        <small class="text-muted" style="font-size: 0.72rem; margin-top: 2px;">Click to select</small>
                    }
                    @if (!IsFormDisabled)
                    {
                        <InputFile @key="PreviewImageUrl" id="photoUpload_pi" OnChange="OnPhotoSelected" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer; z-index: 10;" accept="image/*" />
                    }
                </div>
            </div>

            <!-- User ID Status Display (Only for student view, hide in admin view) -->
            @if (!IsAdminView)
            {
                <div class="input-group" style="grid-column: span 2;">
                    @if ((requestModel.UserId.HasValue && requestModel.UserId > 0) || (requestModel.NewStudentAccId.HasValue && requestModel.NewStudentAccId > 0))
                    {
                        <div style="background: #f0f9ff; padding: 12px 16px; border-radius: 10px; border: 1px solid #0ea5e9; color: #0369a1; font-size: 0.85rem; display: flex; align-items: center;">
                            <i class="fas fa-user-check me-2"></i>
                            <div>
                                <strong>User ID auto-filled successfully</strong><br>
                                <small style="opacity: 0.8;">Logged in user ID automatically loaded</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="background: #fef2f2; padding: 12px 16px; border-radius: 10px; border: 1px solid #ef4444; color: #991b1b; font-size: 0.85rem; display: flex; align-items: center;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <div>
                                <strong>User ID not found</strong><br>
                                <small>Please <a href="/login" style="color: #dc2626; text-decoration: underline;">login</a> first to access registration form.</small>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="input-group">
                <label class="input-label">အမည် (မြန်မာစာဖြင့်) <span style="color:red;">*</span></label>
                <input type="text" class="modern-input" placeholder="ကိုအောင်မင်း" @bind="requestModel.student_name_mm" oninput="this.value = this.value.replace(/[^\u1000-\u109F\s]/g, '')" required disabled="@IsFormDisabled">
            </div>

            <div class="input-group">
                <label class="input-label">အမည် (အင်္ဂလိပ်စာဖြင့်)</label>
                <input type="text" class="modern-input" placeholder="Ko Aung Min" @bind="requestModel.student_name_en" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" disabled="@IsFormDisabled">
            </div>

            <div class="input-group">
                <label class="input-label">မှတ်ပုံတင် (NRC) <span style="color:red;">*</span></label>
                <div style="display:flex; gap:8px; align-items:center;">
                    <select class="modern-input" style="width:80px; padding: 14px 8px; appearance: auto;" @onchange="OnNrcStateChanged" required disabled="@IsFormDisabled">
                        <option value="">တိုင်း</option>
                        @for (int i = 1; i <= 14; i++)
                        {
                            <option value="@i" selected="@(requestModel.nrc_state == i.ToString())">@ToMyanmarDigits(i.ToString())</option>
                        }
                    </select>
                    <span style="font-weight:bold; color:#334155;">/</span>
                    <CustomSelectDropdown Style="flex:1;"
                                          Items="CurrentTownshipList"
                                          @bind-Value="requestModel.nrc_township"
                                          Placeholder="မြို့နယ်"
                                          SearchPlaceholder="ရှာရန်..."
                                          Disabled="@IsFormDisabled"
                                          MaxHeight="190px" />
                    <select class="modern-input" style="width:85px; padding: 14px 8px;" @bind="NrcType" disabled="@IsFormDisabled">
                        <option value="(နိုင်)">(နိုင်)</option>
                        <option value="(ဧည့်)">(ဧည့်)</option>
                        <option value="(ပြု)">(ပြု)</option>
                        <option value="(စ)">(စ)</option>
                        <option value="(သီ)">(သီ)</option>
                        <option value="(သ)">(သ)</option>
                    </select>
                    <input type="text" class="modern-input" style="width:100px; padding: 14px 8px;" placeholder="၁၂၃၄၅၆" @bind="requestModel.nrc_number" maxlength="6" inputmode="numeric" pattern="[၀-၉]*" oninput="this.value = this.value.replace(/[^၀-၉]/g, '').slice(0, 6)" required disabled="@IsFormDisabled">
                </div>
            </div>

            <div class="input-group">
                <label class="input-label">မွေးသက္ကရာဇ် <span style="color:red;">*</span></label>
                <input type="date" class="modern-input" @bind="DobDate" max="@MaxAllowedDobString" required disabled="@IsFormDisabled">
            </div>

            <div class="input-group">
                <label class="input-label">ကျား / မ</label>
                <select class="modern-input" @bind="requestModel.gender_relation" disabled="@IsFormDisabled">
                    <option value="ကျား">ကျား</option>
                    <option value="မ">မ</option>
                </select>
            </div>
            <div class="input-group">
                <label class="input-label">သွေးအုပ်စု</label>
                <select class="modern-input" @bind="requestModel.blood_type" disabled="@IsFormDisabled">
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="AB">AB</option>
                    <option value="O">O</option>
                </select>
            </div>

            <div class="input-group">
                <label class="input-label">လူမျိုး နှင့် ကိုးကွယ်သည့်ဘာသာ</label>
                <div style="display: flex; gap:10px;">
                    <select class="modern-input" @bind="requestModel.ethnicity" disabled="@IsFormDisabled">
                        <option value="">-- လူမျိုး ရွေးပါ --</option>
                        <option value="ဗမာ">ဗမာ</option>
                        <option value="ကချင်">ကချင်</option>
                        <option value="ကယား">ကယား</option>
                        <option value="ကရင်">ကရင်</option>
                        <option value="ချင်း">ချင်း</option>
                        <option value="မွန်">မွန်</option>
                        <option value="ရခိုင်">ရခိုင်</option>
                        <option value="ရှမ်း">ရှမ်း</option>
                    </select>
                    <select class="modern-input" @bind="requestModel.religion" disabled="@IsFormDisabled">
                        <option value="">-- ဘာသာ ရွေးပါ --</option>
                        <option value="ဗုဒ္ဓဘာသာ">ဗုဒ္ဓဘာသာ</option>
                        <option value="ခရစ်ယာန်ဘာသာ">ခရစ်ယာန်ဘာသာ</option>
                        <option value="အစ္စလာမ်ဘာသာ">အစ္စလာမ်ဘာသာ</option>
                        <option value="ဟိန္ဒူဘာသာ">ဟိန္ဒူဘာသာ</option>
                    </select>
                </div>
            </div>
            <div class="input-group">
                <label class="input-label">နိုင်ငံသား အမျိုးအစား</label>
                <div class="radio-group" style="padding: 10px 0;">
                    <label class="radio-item"><input type="radio" name="nationality" checked="@(requestModel.nationality_status == "တိုင်းရင်းသား")" @onchange='() => { if (!IsFormDisabled) requestModel.nationality_status = "တိုင်းရင်းသား"; }' disabled="@IsFormDisabled"> တိုင်းရင်းသား</label>
