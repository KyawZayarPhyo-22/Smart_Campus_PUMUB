                <textarea class="modern-input" placeholder="Full permanent address..." @bind="requestModel.permanent_address_en" oninput="this.value = this.value.replace(/[^a-zA-Z0-9\s.,/-]/g, '')" disabled="@IsFormDisabled"></textarea>
            </div>

