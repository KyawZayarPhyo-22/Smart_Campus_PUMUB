@using Smart_Campus_PUMUB.BlazorServer.Frontend.Services
@inject HttpClientService HttpClientService

@code {
    private string username = "";
    private string password = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoggingIn = false;
    private bool isChangePasswordMode = false;
    private bool isChangingPassword = false;

    // Tab: "login" or "register"
    private string activeTab = "login";

    // Register fields
    private string reg_FullName = "";
    private string reg_Email = "";
    private string reg_Phone = "";
    private string reg_FormNo = "";
    private string reg_ExamSeatNo = "";
    private string registerError = "";
    private bool isRegistering = false;
    private bool registerSubmitted = false;

    // PASSWORD VISIBILITY ENGINE STATE
    private bool isPasswordRenderedText = false;
    private bool isNewPasswordRenderedText = false;
    private bool isConfirmPasswordRenderedText = false;

    private string PasswordInputType => isPasswordRenderedText ? "text" : "password";
    private string NewPasswordInputType => isNewPasswordRenderedText ? "text" : "password";
    private string ConfirmPasswordInputType => isConfirmPasswordRenderedText ? "text" : "password";

    private void TogglePasswordVisibility() => isPasswordRenderedText = !isPasswordRenderedText;
    private void ToggleNewPasswordVisibility() => isNewPasswordRenderedText = !isNewPasswordRenderedText;
    private void ToggleConfirmPasswordVisibility() => isConfirmPasswordRenderedText = !isConfirmPasswordRenderedText;

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        errorMessage = "";
        successMessage = "";
        registerError = "";
        registerSubmitted = false;
    }

    private void CancelChangePassword()
    {
        isChangePasswordMode = false;
        errorMessage = "";
        newPassword = "";
        confirmPassword = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.Uri.ToLower();
        if (uri.Contains("loggedout") || uri.Contains("logout"))
        {
            try
            {
                var customAuth = (CustomAuthStateProvider)AuthStateProvider;
                await customAuth.MarkUserAsLoggedOut();
            }
            catch { }
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var roleVal = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower() ?? "";
            if (roleVal.Contains("admin") || roleVal.Contains("tutor") || roleVal.Contains("super"))
                NavigationManager.NavigateTo("/admin/dashboard");
            else
                NavigationManager.NavigateTo("/");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = NavigationManager.Uri.ToLower();
            if (uri.Contains("loggedout") || uri.Contains("logout"))
            {
                try
                {
                    await JS.InvokeVoidAsync("authFunctions.logout");
                }
                catch { }
            }
        }
    }

    // ── Login ──────────────────────────────────────────────────────────────
    public class LoginResponseModel
    {
        public bool IsSuccess { get; set; }
        public bool MustChangePassword { get; set; }
        public string Message { get; set; } = string.Empty;
        public int UserId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public int RoleId { get; set; }
        public string Role { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
    }

    private async Task HandleLogin()
    {
        if (isLoggingIn) return;
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your username and security key.";
            successMessage = "";
            return;
        }

        try
        {
            isLoggingIn = true;
            errorMessage = "";
            successMessage = "";

            var requestModel = new { UserName = username, Password = password };
            var response = await HttpClientService.ExecuteAsync<LoginResponseModel>(
                "auth/login",
                EnumHttpMethod.Post,
                requestModel
            );

            if (response != null && response.IsSuccess)
            {
                if (response.MustChangePassword)
                {
                    isChangePasswordMode = true;
                    errorMessage = response.Message;
                    return;
                }

                Console.WriteLine($"====== ဒီ User ရဲ့ Role က {response.Role} ပါ ======");
                Console.WriteLine($"====== DB ထဲကနေ Permission ({response.Permissions.Count}) ခု တွေ့ပါတယ် ======");

                var customAuth = (CustomAuthStateProvider)AuthStateProvider;
                await JS.InvokeVoidAsync("authFunctions.setSecureCookie", "authToken", response.Token, 10080); // 7 days (10080 mins)
                customAuth.NotifyUserAuthentication(response.Token);

                await JS.InvokeVoidAsync("sessionStorage.setItem", "islogined", "true");
                await JS.InvokeVoidAsync("sessionStorage.setItem", "rolename", response.Role);

                string roleName = (response.Role ?? "").ToLower().Trim();
                if (roleName.Contains("admin") || roleName.Contains("super") || roleName.Contains("tutor") || roleName == "staff")
                    NavigationManager.NavigateTo("/admin/dashboard", forceLoad: true);
                else
                    NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = response?.Message ?? "Invalid login credentials. Please re-check.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"System Error: {ex.Message}";
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    // ── Register ───────────────────────────────────────────────────────────
    private class RegisterAccResponse
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
    }

    private static readonly System.Text.RegularExpressions.Regex NonMyanmarCharRegex =
        new System.Text.RegularExpressions.Regex(@"[^\u1000-\u1049\u104E\u103F\-\/\s]",
System.Text.RegularExpressions.RegexOptions.Compiled);

    public static string FilterMyanmarOnly(string? input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return NonMyanmarCharRegex.Replace(input, "");
    }

    private static bool ContainsMyanmarLetterOrDigit(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return false;
        return input.Any(c => (c >= '\u1000' && c <= '\u1049') || c == '\u104E' || c == '\u103F');
    }

    private void OnPhoneInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        reg_Phone = System.Text.RegularExpressions.Regex.Replace(raw, @"[^0-9]", "");
        registerError = "";
    }

    private void OnFormNoInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        reg_FormNo = FilterMyanmarOnly(raw);
        registerError = "";
    }

    private void OnExamSeatNoInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        reg_ExamSeatNo = FilterMyanmarOnly(raw);
        registerError = "";
    }

    private async Task HandleRegister()
    {
        if (isRegistering) return;
        registerError = "";

        if (string.IsNullOrWhiteSpace(reg_FullName)) { registerError = "Full Name ထည့်ပေးပါ။"; return; }
        if (string.IsNullOrWhiteSpace(reg_Email)) { registerError = "Email ထည့်ပေးပါ။"; return; }
        if (!reg_Email.Contains("@")) { registerError = "မှန်ကန်သော Email ထည့်ပေးပါ။"; return; }
        if (string.IsNullOrWhiteSpace(reg_Phone)) { registerError = "Phone Number (ဖုန်းနံပါတ်) ထည့်ပေးပါ။"; return; }

        var trimmedPhone = reg_Phone.Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(trimmedPhone, @"^09[2-9]\d{6,8}$"))
        {
            registerError = "မှန်ကန်သော မြန်မာနိုင်ငံ မိုဘိုင်းဖုန်းနံပါတ် (၀၉xxxxxxxxx) ကို ထည့်သွင်းပေးပါ (ဂဏန်း ၉ လုံးမှ ၁၁ လုံး)။";
            return;
        }

        // Check repeated dummy digits like 09111111111, 09999999999, etc.
        if (trimmedPhone.Length > 2 && trimmedPhone.Substring(2).Distinct().Count() <= 1)
        {
            registerError = "တရားမဝင်သော သို့မဟုတ် ထပ်ခါတလဲလဲ ဂဏန်းများဖြင့် ဖွဲ့စည်းထားသော ဖုန်းနံပါတ် ဖြစ်နေပါသည်။";
            return;
        }

        string[] dummySequences = { "09123456789", "09987654321", "09012345678", "0912345678", "0987654321" };
        if (dummySequences.Contains(trimmedPhone))
        {
            registerError = "စမ်းသပ်ဂဏန်းအစဉ်လိုက် ဖုန်းနံပါတ်များကို ထည့်သွင်းခွင့်မပြုပါ။";
            return;
        }

        if (string.IsNullOrWhiteSpace(reg_FormNo)) { registerError = "Form No (တက္ကသိုလ်ဝင်ခွင့်နံပါတ်) ထည့်ပေးပါ။"; return; }
        if (!ContainsMyanmarLetterOrDigit(reg_FormNo)) { registerError = "Form No တွင် မြန်မာအက္ခရာနှင့် မြန်မာဂဏန်းများသာ ထည့်သွင်းပေးပါ (ဥပမာ - ၁၂၃၄ သို့မဟုတ် မအူ-၁၂)။"; return; }
        if (string.IsNullOrWhiteSpace(reg_ExamSeatNo)) { registerError = "Exam Seat No (ဆယ်တန်းခုံနံပါတ်) ထည့်ပေးပါ။"; return; }
        if (!ContainsMyanmarLetterOrDigit(reg_ExamSeatNo)) { registerError = "ဆယ်တန်းခုံနံပါတ် တွင် မြန်မာအက္ခရာနှင့် မြန်မာဂဏန်းများသာ ထည့်သွင်းပေးပါ (ဥပမာ - သရ-၁၂၃၊ မအူ-၄၅၆)။"; return; }

        try
        {
            isRegistering = true;

            var payload = new
            {
                FullName = reg_FullName.Trim(),
                Email = reg_Email.Trim(),
                Phone = reg_Phone.Trim(),
                FormNo = reg_FormNo.Trim(),
                ExamSeatNo = reg_ExamSeatNo.Trim()
            };

            // Use HttpClientFactory directly — no auth token needed for public endpoint
            var client = HttpClientFactory.CreateClient("SmartCampusApi");
            var jsonStr = System.Text.Json.JsonSerializer.Serialize(payload);
            var httpContent = new System.Net.Http.StringContent(jsonStr, System.Text.Encoding.UTF8, "application/json");
            var httpResponse = await client.PostAsync("registeracc", httpContent);
            var resJson = await httpResponse.Content.ReadAsStringAsync();

            RegisterAccResponse? response = null;
            if (!string.IsNullOrWhiteSpace(resJson))
            {
                try
                {
                    response = System.Text.Json.JsonSerializer.Deserialize<RegisterAccResponse>(
                        resJson,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    );
                }
                catch (System.Text.Json.JsonException jsonEx)
                {
                    var preview = resJson.Length > 200 ? resJson[..200] + "..." : resJson;
                    registerError = $"API returned non-JSON response: \"{preview}\" (Error: {jsonEx.Message})";
                    return;
                }
            }

            if (response != null && response.IsSuccess)
            {
                registerSubmitted = true;
            }
            else
            {
                registerError = response?.Message
                    ?? $"Request တင်ရာတွင် အမှားဖြစ်ပါသည်။ (HTTP {(int)httpResponse.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            registerError = $"System Error: {ex.Message}";
        }
        finally
        {
            isRegistering = false;
        }
    }

    // ── Change Password ────────────────────────────────────────────────────
    private async Task HandleChangePassword()
    {
        if (isChangingPassword) return;
        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "Please enter and confirm your new password.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (newPassword.Length < 8)
        {
            errorMessage = "Password သည် အနည်းဆုံး ၈ လုံး ရှိရမည်။";
            return;
        }

        if (newPassword == password)
        {
            errorMessage = "စကားဝှက်အသစ်သည် လက်ရှိ (Email မှ ပေးပို့ထားသော) စကားဝှက်ဟောင်းနှင့် မတူညီရပါ။ / New password cannot be the same as the temporary password.";
            return;
        }

        try
        {
            isChangingPassword = true;
            errorMessage = "";
            successMessage = "";

            var changeRequest = new
            {
                UserName = username,
                CurrentPassword = password,
                NewPassword = newPassword
            };

            var changeResponse = await HttpClientService.ExecuteAsync<LoginResponseModel>(
                "auth/change-password",
                EnumHttpMethod.Post,
                changeRequest
            );

            if (changeResponse != null && changeResponse.IsSuccess)
            {
                successMessage = changeResponse.Message;
                isChangePasswordMode = false;
                password = "";
                newPassword = "";
                confirmPassword = "";
            }
            else
            {
                errorMessage = changeResponse?.Message ?? "Failed to change password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"System Error: {ex.Message}";
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleChangePasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleChangePassword();
    }
}