@page "/tutors"
@using Microsoft.AspNetCore.Components.Authorization
@using Smart_Campus_PUMUB.WebApi.Models
@using Smart_Campus_PUMUB.BlazorServer.Frontend.Services
@using Smart_Campus_PUMUB.Components.Shared
@inject HttpClientService HttpClientService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Tutors & Faculty – Polytechnic University (Maubin)</PageTitle>

<style>
    .tutor-custom-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .tutor-custom-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(90, 79, 207, 0.12);
        border-color: #cbd5e1;
    }

    .tutor-header-gradient {
        height: 95px;
        background: linear-gradient(135deg, #5A4FCF 0%, #3b82f6 100%);
        position: relative;
    }

    .tutor-avatar-wrap {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        border: 4px solid #ffffff;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
        position: absolute;
        bottom: -44px;
        left: 50%;
        transform: translateX(-50%);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tutor-avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .tutor-avatar-initials {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #5A4FCF, #2563eb);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: 800;
    }

    .tutor-body {
        padding: 55px 22px 22px 22px;
        text-align: center;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .tutor-name {
        font-size: 1.18rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .tutor-position-badge {
        display: inline-block;
        background: rgba(90, 79, 207, 0.09);
        color: #5A4FCF;
        font-weight: 700;
        font-size: 0.78rem;
        padding: 4px 12px;
        border-radius: 999px;
        margin-bottom: 14px;
    }

    .tutor-info-list {
        text-align: left;
        background: #f8fafc;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 0.85rem;
        margin-bottom: 18px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        border: 1px solid #f1f5f9;
    }

    .tutor-info-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #475569;
    }

    .tutor-info-item i {
        color: #5A4FCF;
        font-size: 0.9rem;
        width: 16px;
        text-align: center;
        flex-shrink: 0;
    }

    .tutor-info-item span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-view-tutor {
        background-color: #5A4FCF;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 0.88rem;
        padding: 9px 18px;
        border-radius: 12px;
        border: none;
        transition: all 0.2s ease;
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-view-tutor:hover {
        background-color: #483eb0;
        box-shadow: 0 4px 14px rgba(90, 79, 207, 0.35);
    }

    /* Auth Gate Card */
    .auth-gate-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        padding: 50px 30px;
        text-align: center;
        max-width: 540px;
        margin: 60px auto;
    }

    .auth-icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(90, 79, 207, 0.1);
        color: #5A4FCF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 20px;
    }
</style>

<section id="tutors" style="background:var(--bg2); margin-top: 50px; min-height: 80vh; padding-bottom: 60px;">
    <div class="container">
        <AuthorizeView>
            <Authorized>
                <!-- Section Header -->
                <div class="section-header">
                    <div>
                        <div class="section-tag"><i class="fas fa-chalkboard-teacher"></i> Academic Faculty</div>
                        <h2 class="section-title">University <span>Tutors & Faculty</span></h2>
                    </div>
                </div>

                <!-- Controls Bar (Tabs & Search) -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div class="programs-tabs">
                        <button class="tab-btn @(SelectedFacultyId == 0 ? "active" : "")"
                                @onclick="() => OnFacultySelected(0)">
                            All Faculties
                        </button>

                        @foreach (var faculty in Faculties)
                        {
                            <button class="tab-btn @(SelectedFacultyId == faculty.FacultyId ? "active" : "")"
                                    @onclick="() => OnFacultySelected(faculty.FacultyId)">
                                @faculty.FacultyName
                            </button>
                        }
                    </div>

                    <div class="input-group rounded-pill shadow-sm bg-white"
                         style="max-width: 380px; border: 1px solid #e0e0e0; overflow: hidden;">
                        <input type="text" class="form-control border-0 shadow-none px-4" placeholder="Search by name, department..."
                               @bind="searchQuery" @bind:event="oninput" @onkeyup="FilterData" />
                        <span class="input-group-text bg-transparent border-0 pe-4" style="color: #5A4FCF;">
                            <i class="fas fa-search"></i>
                        </span>
                    </div>
                </div>

                <!-- Tutors Grid (Using .faculties-grid identical to Activities) -->
                @if (isLoading)
                {
                    <div class="text-center w-100 my-5 py-5">
                        <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem; color: #5A4FCF !important;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-muted mt-3">ဆရာ/ဆရာမများ စာရင်းကို ဆွဲယူနေပါသည်...</div>
                    </div>
                }
                else if (PagedTutors != null && PagedTutors.Any())
                {
                    <div class="faculties-grid">
                        @foreach (var tutor in PagedTutors)
                        {
                            var deptName = GetDepartmentName(tutor.DepartmentId);
                            <div class="tutor-custom-card">
                                <!-- Card Header Gradient & Avatar -->
                                <div class="tutor-header-gradient">
                                    <div class="tutor-avatar-wrap">
                                        @if (!string.IsNullOrEmpty(tutor.Profile))
                                        {
                                            <img src="@GetFullImageUrl(tutor.Profile)" alt="@tutor.TutorName" class="tutor-avatar-img" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(tutor.TutorName ?? "T")&background=5A4FCF&color=fff&size=128';" />
                                        }
                                        else
                                        {
                                            <div class="tutor-avatar-initials">
                                                @(string.IsNullOrEmpty(tutor.TutorName) ? "T" : tutor.TutorName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="tutor-body">
                                    <h4 class="tutor-name">@tutor.TutorName</h4>
                                    <div>
                                        <span class="tutor-position-badge">
                                            @(string.IsNullOrEmpty(tutor.PositionName) ? "Faculty Member" : tutor.PositionName)
                                        </span>
                                    </div>

                                    <div class="tutor-info-list">
                                        @if (!string.IsNullOrEmpty(tutor.FacultyName))
                                        {
                                            <div class="tutor-info-item" title="@tutor.FacultyName">
                                                <i class="fas fa-university"></i>
                                                <span>@tutor.FacultyName</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(deptName))
                                        {
                                            <div class="tutor-info-item" title="@deptName">
                                                <i class="fas fa-building"></i>
                                                <span>@deptName</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(tutor.Email))
                                        {
                                            <div class="tutor-info-item" title="@tutor.Email">
                                                <i class="fas fa-envelope"></i>
                                                <span>@tutor.Email</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(tutor.Phone))
                                        {
                                            <div class="tutor-info-item" title="@tutor.Phone">
                                                <i class="fas fa-phone-alt"></i>
                                                <span>@tutor.Phone</span>
                                            </div>
                                        }
                                    </div>

                                    <button type="button" class="btn-view-tutor" @onclick="() => OpenTutorModal(tutor)">
                                        <i class="fas fa-user-circle"></i> View Profile
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination (Exact Activities Style) -->
                    <div class="mt-4">
                        <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
                    </div>
                }
                else
                {
                    <div class="w-100 text-center mt-5 py-5">
                        <i class="fas fa-user-slash fs-1 text-muted mb-3 d-block"></i>
                        <p class="text-muted fw-semibold">No faculty members found matching your criteria.</p>
                    </div>
                }
            </Authorized>

            <NotAuthorized>
                <!-- Clean Auth Gate for Guests -->
                <div class="auth-gate-card">
                    <div class="auth-icon-circle">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Login Required</h3>
                    <p class="text-muted mb-4" style="line-height: 1.6; font-size: 0.95rem;">
                        ဆရာ/ဆရာမများ၏ အချက်အလက်နှင့် Profile များကို ကြည့်ရှုရန် သင်၏ Account ဖြင့် <strong>Login</strong> အရင်ဝင်ပေးပါရန် လိုအပ်ပါသည်။
                        <br>
                        <small class="text-secondary">Please log in to your account to view Academic Faculty & Tutor information.</small>
                    </p>
                    <a href="/login" class="btn btn-primary px-4 py-2.5 rounded-pill fw-bold shadow-sm" style="background: #5A4FCF; border-color: #5A4FCF; font-size: 0.95rem;">
                        <i class="fas fa-sign-in-alt me-1.5"></i> Login ဝင်ရောက်မည်
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>

<!-- Tutor Detail Modal -->
@if (SelectedTutor != null)
{
    var modalDept = GetDepartmentName(SelectedTutor.DepartmentId);
    <div class="modal fade show d-block" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header border-0 pb-0" style="background: linear-gradient(135deg, #5A4FCF 0%, #3b82f6 100%); padding: 24px; position: relative;">
                    <button type="button" class="btn-close btn-close-white position-absolute" style="top: 16px; right: 16px;" @onclick="CloseTutorModal"></button>
                    <div class="d-flex align-items-center gap-3 text-white">
                        <div style="width: 70px; height: 70px; border-radius: 50%; border: 3px solid #ffffff; overflow: hidden; background: #ffffff; flex-shrink: 0;">
                            @if (!string.IsNullOrEmpty(SelectedTutor.Profile))
                            {
                                <img src="@GetFullImageUrl(SelectedTutor.Profile)" alt="@SelectedTutor.TutorName" style="width:100%; height:100%; object-fit:cover;" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(SelectedTutor.TutorName ?? "T")&background=5A4FCF&color=fff&size=128';" />
                            }
                            else
                            {
                                <div style="width:100%; height:100%; background:#2563eb; color:white; display:flex; align-items:center; justify-content:center; font-size:1.5rem; font-weight:bold;">
                                    @(string.IsNullOrEmpty(SelectedTutor.TutorName) ? "T" : SelectedTutor.TutorName.Substring(0, 1).ToUpper())
                                </div>
                            }
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">@SelectedTutor.TutorName</h4>
                            <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold" style="font-size: 0.78rem;">
                                @(string.IsNullOrEmpty(SelectedTutor.PositionName) ? "Faculty Member" : SelectedTutor.PositionName)
                            </span>
                        </div>
                    </div>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="text-muted small fw-bold">Faculty & Department</label>
                        <div class="d-flex flex-column gap-1 mt-1">
                            <span class="text-dark fw-semibold"><i class="fas fa-university me-1.5 text-primary"></i> @(SelectedTutor.FacultyName ?? "Faculty of Engineering")</span>
                            @if (!string.IsNullOrEmpty(modalDept))
                            {
                                <span class="text-secondary small"><i class="fas fa-building me-1.5 text-primary"></i> @modalDept</span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold">Contact Information</label>
                        <div class="d-flex flex-column gap-1.5 mt-1 bg-light p-3 rounded-3 border">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-envelope text-primary"></i>
                                <a href="mailto:@SelectedTutor.Email" class="text-decoration-none text-dark small">@(SelectedTutor.Email ?? "N/A")</a>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-phone-alt text-primary"></i>
                                <a href="tel:@SelectedTutor.Phone" class="text-decoration-none text-dark small">@(SelectedTutor.Phone ?? "N/A")</a>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(SelectedTutor.About))
                    {
                        <div class="mb-2">
                            <label class="text-muted small fw-bold">About Tutor / Biography</label>
                            <p class="text-dark mt-1" style="font-size: 0.9rem; line-height: 1.6; white-space: pre-wrap;">@SelectedTutor.About</p>
                        </div>
                    }
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary w-100 rounded-pill py-2 fw-semibold" @onclick="CloseTutorModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FacultyModel> Faculties = new();
    private List<DepartmentModel> Departments = new();
    private List<TutorModel> AllTutors = new();
    private List<TutorModel> FilteredTutors = new();
    private List<TutorModel> PagedTutors = new();

    private TutorModel? SelectedTutor = null;

    private int SelectedFacultyId = 0;
    private string searchQuery = "";
    private bool isLoading = true;

    private int CurrentPage = 1;
    private int PageSize = 8;
    private int TotalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var fetchedFaculties = await HttpClientService.ExecuteAsync<List<FacultyModel>>("faculty", EnumHttpMethod.Get) ?? new();
            Departments = await HttpClientService.ExecuteAsync<List<DepartmentModel>>("department", EnumHttpMethod.Get) ?? new();
            var response = await HttpClientService.ExecuteAsync<PagedResult<TutorModel>>("tutor/paginate?pageNumber=1&pageSize=500", EnumHttpMethod.Get);
            AllTutors = response?.Items ?? new();

            // Merge distinct faculties from AllTutors to ensure all faculty tabs always appear
            var tutorFaculties = AllTutors
                .Where(t => t.FacultyId > 0 && !string.IsNullOrEmpty(t.FacultyName))
                .GroupBy(t => t.FacultyId)
                .Select(g => new FacultyModel { FacultyId = g.Key, FacultyName = g.First().FacultyName! })
                .ToList();

            Faculties = fetchedFaculties.UnionBy(tutorFaculties, f => f.FacultyId).OrderBy(f => f.FacultyId).ToList();
            FilterData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tutors: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDepartmentName(int deptId)
    {
        return Departments.FirstOrDefault(d => d.DepartmentId == deptId)?.DepartmentName ?? "";
    }

    private void OnFacultySelected(int facultyId)
    {
        SelectedFacultyId = facultyId;
        CurrentPage = 1;
        FilterData();
    }

    private void FilterData()
    {
        var query = AllTutors.AsEnumerable();

        if (SelectedFacultyId != 0)
        {
            query = query.Where(t => t.FacultyId == SelectedFacultyId);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var term = searchQuery.Trim().ToLower();
            query = query.Where(t =>
                (t.TutorName != null && t.TutorName.ToLower().Contains(term)) ||
                (GetDepartmentName(t.DepartmentId).ToLower().Contains(term)) ||
                (t.PositionName != null && t.PositionName.ToLower().Contains(term)) ||
                (t.FacultyName != null && t.FacultyName.ToLower().Contains(term)) ||
                (t.Email != null && t.Email.ToLower().Contains(term))
            );
        }

        FilteredTutors = query.ToList();
        CalculatePagination();
    }

    private void CalculatePagination()
    {
        if (!FilteredTutors.Any())
        {
            PagedTutors = new();
            TotalPages = 1;
            CurrentPage = 1;
            return;
        }

        TotalPages = (int)Math.Ceiling((double)FilteredTutors.Count / PageSize);
        if (CurrentPage > TotalPages) CurrentPage = TotalPages;
        if (CurrentPage < 1) CurrentPage = 1;

        PagedTutors = FilteredTutors
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

        StateHasChanged();
    }

    private void OnPageChanged(int page)
    {
        CurrentPage = page;
        CalculatePagination();
    }

    private void OpenTutorModal(TutorModel tutor)
    {
        SelectedTutor = tutor;
    }

    private void CloseTutorModal()
    {
        SelectedTutor = null;
    }

    private string GetFullImageUrl(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        if (path.StartsWith("http") || path.StartsWith("data:")) return path;
        return $"http://localhost:5077{path}";
    }
}
