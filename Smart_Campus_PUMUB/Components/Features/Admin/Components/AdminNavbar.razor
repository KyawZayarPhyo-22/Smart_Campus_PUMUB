@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Smart_Campus_PUMUB.Components.Features.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<header class="admin-topnav sticky-top">
    <div class="d-flex align-items-center gap-3">

        <!-- Sidebar toggle button -->
        <button class="nav-icon-btn p-0 me-1 border-0"
                type="button"
                onclick="toggleDesktopSidebar()"
                aria-label="Toggle sidebar">
            <i class="bi bi-layout-sidebar-inset fs-5"></i>
        </button>

        <!-- Page title / breadcrumb area -->
        <div class="d-none d-sm-block">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 breadcrumb-pill d-flex align-items-center gap-2">
                    <li class="breadcrumb-item d-flex align-items-center gap-1">
                        <i class="bi bi-shield-lock-fill" style="color: #4f46e5;"></i>
                        <a href="/admin/dashboard" style="color: #4f46e5 !important; font-weight: 700; text-decoration: none;">Admin</a>
                    </li>
                    <li class="breadcrumb-item active d-flex align-items-center gap-1" aria-current="page">
                        <span class="badge px-3 py-1.5 rounded-pill" style="background: rgba(79, 70, 229, 0.1); color: #4f46e5 !important; font-weight: 700; font-size: 0.85rem;">
                            @activeMenuTitle
                        </span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Right side controls -->
    <div class="d-flex align-items-center gap-2 gap-sm-3 ms-auto">

        <!-- Profile Dropdown -->
        <AuthorizeView>
            <Authorized>
                <div class="dropdown position-relative">
                    <button type="button"
                            class="profile-pill d-flex align-items-center gap-2 border-0"
                            id="profileDropdown"
                            @onclick="ToggleProfileMenu"
                            @onfocusout="CloseProfileMenu"
                            aria-expanded="@(isProfileMenuOpen ? "true" : "false")">
                        <div class="position-relative">
                            <img src="@($"https://ui-avatars.com/api/?name={context.User.Identity?.Name}&background=4f46e5&color=fff&bold=true")"
                                 alt="Admin"
                                 width="36"
                                 height="36"
                                 class="rounded-circle shadow-sm" style="border: 2px solid #6366f1;" />
                            <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle"></span>
                        </div>
                        <div class="d-none d-sm-block lh-1 text-start me-1">
                            <span class="d-block fw-bold text-dark" style="font-size:0.85rem;">@context.User.Identity?.Name</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-0 border-0" style="font-size:0.65rem; font-weight: 700; background: #e0e7ff !important; color: #4338ca !important;">
                                @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "ADMIN")
                            </span>
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size:0.75rem;"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-2 @(isProfileMenuOpen ? "show" : "")"
                        aria-labelledby="profileDropdown"
                        style="min-width:220px; position: absolute; right: 0; border-radius: 16px; background: #ffffff;">
                        <li class="p-2 mb-2 bg-light rounded-3 d-flex align-items-center gap-2">
                            <img src="@($"https://ui-avatars.com/api/?name={context.User.Identity?.Name}&background=4f46e5&color=fff&bold=true")"
                                 width="32" height="32" class="rounded-circle" />
                            <div class="lh-1 overflow-hidden">
                                <strong class="d-block text-dark text-truncate" style="font-size: 0.85rem;">@context.User.Identity?.Name</strong>
                                <small class="text-muted" style="font-size: 0.72rem;">Administrator Account</small>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 text-danger rounded-2 py-2 px-3 fw-semibold border-0 w-100 text-start" 
                                    style="background: #fef2f2;" 
                                    @onclick="Logout">
                                <i class="bi bi-box-arrow-right fs-6"></i> Logout
                            </button>
                        </li>
                    </ul>
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="btn btn-primary rounded-pill px-4">Login</a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</header>

@implements IDisposable

@code {
    private bool isProfileMenuOpen = false;
    private string activeMenuTitle = "Dashboard";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateActiveMenuTitle(NavigationManager.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActiveMenuTitle(e.Location);
        StateHasChanged();
    }

    private void UpdateActiveMenuTitle(string uri)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(uri).ToLowerInvariant();
        if (relativePath.Contains("?"))
            relativePath = relativePath.Substring(0, relativePath.IndexOf("?"));
        if (relativePath.Contains("#"))
            relativePath = relativePath.Substring(0, relativePath.IndexOf("#"));

        if (relativePath.StartsWith("admin/student-databank")) activeMenuTitle = "Student Databank";
        else if (relativePath.StartsWith("admin/student-directory")) activeMenuTitle = "Student Directory (Pass/Fail)";
        else if (relativePath.StartsWith("admin/student")) activeMenuTitle = "Register Databank";
        else if (relativePath.StartsWith("admin/tutor")) activeMenuTitle = "Tutor Directory";
        else if (relativePath.StartsWith("admin/role")) activeMenuTitle = "Roles";
        else if (relativePath.StartsWith("admin/position")) activeMenuTitle = "Position";
        else if (relativePath.StartsWith("admin/facult")) activeMenuTitle = "Faculty";
        else if (relativePath.StartsWith("admin/semester")) activeMenuTitle = "Semester";
        else if (relativePath.StartsWith("admin/categor")) activeMenuTitle = "Category";
        else if (relativePath.StartsWith("admin/payment")) activeMenuTitle = "Payment Fees";
        else if (relativePath.StartsWith("admin/department")) activeMenuTitle = "Department";
        else if (relativePath.StartsWith("admin/subject")) activeMenuTitle = "Subject";
        else if (relativePath.StartsWith("admin/activit")) activeMenuTitle = "Activities";
        else if (relativePath.StartsWith("admin/rule")) activeMenuTitle = "Rules";
        else if (relativePath.StartsWith("admin/permission")) activeMenuTitle = "Permissions";
        else if (relativePath.StartsWith("admin/book")) activeMenuTitle = "Books";
        else if (relativePath.StartsWith("admin/user")) activeMenuTitle = "User Management";
        else if (relativePath.StartsWith("admin/acc-register")) activeMenuTitle = "Acc Register";
        else if (relativePath.StartsWith("admin/report")) activeMenuTitle = "Student Admission Report";
        else activeMenuTitle = "Dashboard";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    private async Task CloseProfileMenu()
    {
        await Task.Delay(250);
        isProfileMenuOpen = false;
    }

    private async Task Logout()
    {
        isProfileMenuOpen = false;
        var customAuth = (CustomAuthStateProvider)AuthStateProvider;
        await customAuth.MarkUserAsLoggedOut();
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "false");
            await JSRuntime.InvokeVoidAsync("authFunctions.logout");
        }
        catch { }
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}