@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Smart_Campus_PUMUB.Components.Features.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AdminLanguageService LangService

<style>
    .profile-pill {
        background: #ffffff !important;
        border: 1.5px solid #e2e8f0 !important;
        padding: 4px 14px 4px 5px !important;
        border-radius: 9999px !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04) !important;
        cursor: pointer;
    }

    .profile-pill:hover,
    .profile-pill.active {
        background: #f8fafc !important;
        border-color: #c7d2fe !important;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.15) !important;
        transform: translateY(-1px);
    }

    .profile-avatar-wrapper {
        position: relative;
        width: 36px;
        height: 36px;
        flex-shrink: 0;
    }

    .profile-avatar-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #5A4FCF 0%, #4338CA 100%);
        color: #ffffff !important;
        font-weight: 800;
        font-size: 0.82rem;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
        box-shadow: 0 2px 6px rgba(90, 79, 207, 0.35);
    }

    .status-indicator-dot {
        position: absolute;
        bottom: 0px;
        right: 0px;
        width: 10px;
        height: 10px;
        background-color: #10b981;
        border: 2px solid #ffffff;
        border-radius: 50%;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    .profile-role-badge {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        background: #eef2ff !important;
        color: #4f46e5 !important;
        border: 1px solid #c7d2fe;
        border-radius: 20px;
        padding: 1px 8px;
        display: inline-block;
    }

    .chevron-icon {
        font-size: 0.75rem;
        color: #94a3b8;
        transition: transform 0.25s ease, color 0.2s ease;
    }

    .profile-pill:hover .chevron-icon,
    .profile-pill.active .chevron-icon {
        color: #5A4FCF;
    }

    .chevron-rotated {
        transform: rotate(180deg);
    }

    .admin-topnav {
        z-index: 1060 !important;
    }

    .profile-dropdown-card {
        min-width: 270px;
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 12px;
        box-shadow: 0 20px 30px -5px rgba(0, 0, 0, 0.18), 0 10px 15px -5px rgba(0, 0, 0, 0.08);
        z-index: 1085 !important;
        animation: dropdownSlideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes dropdownSlideUp {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .profile-card-header {
        background: linear-gradient(135deg, rgba(90, 79, 207, 0.08) 0%, rgba(99, 102, 241, 0.04) 100%);
        border: 1px solid rgba(90, 79, 207, 0.15);
        border-radius: 12px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profile-card-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #5A4FCF 0%, #4338CA 100%);
        color: #ffffff !important;
        font-weight: 800;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        user-select: none;
        box-shadow: 0 3px 8px rgba(90, 79, 207, 0.3);
    }

    .profile-card-name {
        font-size: 0.92rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 2px;
        line-height: 1.2;
    }

    .profile-card-subtitle {
        font-size: 0.74rem;
        font-weight: 600;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .profile-online-badge {
        width: 7px;
        height: 7px;
        background-color: #10b981;
        border-radius: 50%;
        display: inline-block;
    }

    .btn-logout-modern {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 10px 16px;
        background: linear-gradient(135deg, #e11d48 0%, #be123c 100%) !important;
        color: #ffffff !important;
        border: 1px solid #be123c !important;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(225, 29, 72, 0.35);
    }

    .btn-logout-modern i {
        font-size: 1.05rem;
        transition: transform 0.2s ease;
        color: #ffffff !important;
    }

    .btn-logout-modern:hover {
        background: linear-gradient(135deg, #be123c 0%, #9f1239 100%) !important;
        color: #ffffff !important;
        border-color: #9f1239 !important;
        box-shadow: 0 6px 18px rgba(225, 29, 72, 0.5) !important;
        transform: translateY(-1px);
    }

    .btn-logout-modern:hover i {
        color: #ffffff !important;
        transform: translateX(3px);
    }

    .btn-home-modern {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 10px 16px;
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%) !important;
        color: #ffffff !important;
        border: 1px solid #3730a3 !important;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none !important;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
        margin-bottom: 8px;
    }

    .btn-home-modern i {
        font-size: 1.05rem;
        transition: transform 0.2s ease;
        color: #ffffff !important;
    }

    .btn-home-modern:hover {
        background: linear-gradient(135deg, #4338ca 0%, #312e81 100%) !important;
        color: #ffffff !important;
        border-color: #312e81 !important;
        box-shadow: 0 6px 18px rgba(79, 70, 229, 0.5) !important;
        transform: translateY(-1px);
        text-decoration: none !important;
    }

    .btn-home-modern:hover i {
        color: #ffffff !important;
        transform: scale(1.15);
    }
</style>

<header class="admin-topnav sticky-top">
    <div class="d-flex align-items-center gap-3">

        <!-- Sidebar toggle button -->
        <button class="nav-icon-btn p-0 me-1 border-0" type="button" onclick="toggleDesktopSidebar()"
                aria-label="Toggle sidebar">
            <i class="bi bi-layout-sidebar-inset fs-5"></i>
        </button>

        <!-- Page title / breadcrumb area -->
        <div class="d-none d-sm-block">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 breadcrumb-pill d-flex align-items-center gap-2">
                    <li class="breadcrumb-item d-flex align-items-center gap-1">
                        <i class="bi bi-shield-lock-fill" style="color: #4f46e5;"></i>
                        <a href="/admin/dashboard"
                           style="color: #4f46e5 !important; font-weight: 700; text-decoration: none;">@(LangService.IsMyanmar ? "စီမံခန့်ခွဲသူ" : "Admin")</a>
                    </li>
                    <li class="breadcrumb-item active d-flex align-items-center gap-1" aria-current="page">
                        <span class="badge px-3 py-1.5 rounded-pill"
                              style="background: rgba(79, 70, 229, 0.1); color: #4f46e5 !important; font-weight: 700; font-size: 0.85rem;">
                            @activeMenuTitle
                        </span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Right side controls -->
    <div class="d-flex align-items-center gap-2 gap-sm-3 ms-auto">

        <!-- Profile Dropdown -->
        <AuthorizeView>
            <Authorized>
                <div class="position-relative" style="z-index: 1080;">
                    <button type="button"
                            class="profile-pill d-flex align-items-center gap-2 border-0 @(isProfileMenuOpen ? "active" : "")"
                            id="profileDropdown" @onclick="ToggleProfileMenu"
                            aria-expanded="@(isProfileMenuOpen ? "true" : "false")">
                        <div class="profile-avatar-wrapper">
                            <div class="profile-avatar-circle shadow-sm">
                                @GetInitials(context.User.Identity?.Name)
                            </div>
                            <span class="status-indicator-dot"></span>
                        </div>
                        <div class="d-none d-sm-block lh-1 text-start me-1">
                            <span class="d-block fw-bold text-dark"
                                  style="font-size:0.85rem; letter-spacing: 0.2px;">@context.User.Identity?.Name</span>
                            <span class="profile-role-badge">
                                @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "ADMIN")
                            </span>
                        </div>
                        <i class="bi bi-chevron-down chevron-icon @(isProfileMenuOpen ? "chevron-rotated" : "")"></i>
                    </button>

                    @if (isProfileMenuOpen)
                    {
                        <!-- Outside click backdrop (z-index 1081) -->
                        <div style="position: fixed; inset: 0; z-index: 1081; background: transparent;"
                             @onclick="CloseProfileMenuImmediately"></div>

                        <!-- Dropdown card sits ABOVE backdrop (z-index 1085) -->
                        <div class="profile-dropdown-card" style="z-index: 1085 !important;" aria-labelledby="profileDropdown">
                            <div class="profile-card-header mb-2">
                                <div class="profile-card-avatar shadow-sm">
                                    @GetInitials(context.User.Identity?.Name)
                                </div>
                                <div class="overflow-hidden">
                                    <div class="profile-card-name text-truncate">@context.User.Identity?.Name</div>
                                    <div class="profile-card-subtitle">
                                        <span class="profile-online-badge"></span>
                                        <span>@(LangService.IsMyanmar ? "အွန်လိုင်း" : "Online")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="my-2" style="border-top: 1px solid #f1f5f9;"></div>
                            <div>
                                <a href="/" class="btn-home-modern">
                                    <i class="bi bi-house-door-fill"></i>
                                    <span>@(LangService.IsMyanmar ? "ပင်မစာမျက်နှာသို့" : "Home")</span>
                                </a>
                                <button type="button" class="btn-logout-modern border-0" @onclick="Logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>@(LangService.IsMyanmar ? "အကောင့်ထွက်မည်" : "Logout")</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="btn btn-primary rounded-pill px-4">@(LangService.IsMyanmar ? "အကောင့်ဝင်မည်" : "Login")</a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</header>

@implements IDisposable

@code {
    private bool isProfileMenuOpen = false;
    private string activeMenuTitle = "Dashboard";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        LangService.OnLanguageChanged += HandleLanguageChanged;
        UpdateActiveMenuTitle(NavigationManager.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedLang = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "admin_dashboard_lang");
                if (!string.IsNullOrEmpty(savedLang))
                {
                    LangService.SetLanguage(savedLang);
                }
            }
            catch { }
        }
    }

    private void HandleLanguageChanged()
    {
        UpdateActiveMenuTitle(NavigationManager.Uri);
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActiveMenuTitle(e.Location);
        StateHasChanged();
    }

    private void UpdateActiveMenuTitle(string uri)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(uri).ToLowerInvariant();
        if (relativePath.Contains("?"))
            relativePath = relativePath.Substring(0, relativePath.IndexOf("?"));
        if (relativePath.Contains("#"))
            relativePath = relativePath.Substring(0, relativePath.IndexOf("#"));

        bool my = LangService.IsMyanmar;

        if (relativePath.StartsWith("admin/student-databank")) activeMenuTitle = my ? "ကျောင်းသားမှတ်တမ်း" : "Student Databank";
        else if (relativePath.StartsWith("admin/student-directory")) activeMenuTitle = my ? "ကျောင်းသားလမ်းညွှန်" : "Student Directory";
        else if (relativePath.StartsWith("admin/student-ranking")) activeMenuTitle = my ? "အဆင့်သတ်မှတ်ချက်နှင့် မဟာဘွဲ့အရည်အချင်း" : "Student Ranking & Master Eligibility";
        else if (relativePath.StartsWith("admin/student")) activeMenuTitle = my ? "စာရင်းသွင်းမှတ်တမ်း" : "Register Databank";
        else if (relativePath.StartsWith("admin/tutor")) activeMenuTitle = my ? "ဆရာ/ဆရာမ စာရင်း" : "Tutor Directory";
        else if (relativePath.StartsWith("admin/role")) activeMenuTitle = my ? "အခန်းကဏ္ဍများ" : "Roles";
        else if (relativePath.StartsWith("admin/position")) activeMenuTitle = my ? "ရာထူး" : "Position";
        else if (relativePath.StartsWith("admin/facult")) activeMenuTitle = my ? "မဟာဌာန" : "Faculty";
        else if (relativePath.StartsWith("admin/semester")) activeMenuTitle = my ? "စာသင်နှစ်ဝက်" : "Semester";
        else if (relativePath.StartsWith("admin/categor")) activeMenuTitle = my ? "စာအုပ်အမျိုးအစား" : "Category";
        else if (relativePath.StartsWith("admin/payment")) activeMenuTitle = my ? "အခကြေးငွေ သတ်မှတ်ချက်" : "Payment Fees";
        else if (relativePath.StartsWith("admin/department")) activeMenuTitle = my ? "ဌာန" : "Department";
        else if (relativePath.StartsWith("admin/subject")) activeMenuTitle = my ? "ဘာသာရပ်" : "Subject";
        else if (relativePath.StartsWith("admin/activit")) activeMenuTitle = my ? "လှုပ်ရှားမှုများ" : "Activities";
        else if (relativePath.StartsWith("admin/rule")) activeMenuTitle = my ? "စည်းမျဉ်းများ" : "Rules";
        else if (relativePath.StartsWith("admin/permission")) activeMenuTitle = my ? "ခွင့်ပြုချက်များ" : "Permissions";
        else if (relativePath.StartsWith("admin/book")) activeMenuTitle = my ? "စာအုပ်များ" : "Books";
        else if (relativePath.StartsWith("admin/user")) activeMenuTitle = my ? "အသုံးပြုသူ စီမံခန့်ခွဲမှု" : "User Management";
        else if (relativePath.StartsWith("admin/acc-register")) activeMenuTitle = my ? "အကောင့်ဖွင့်ခြင်း" : "Acc Register";
        else if (relativePath.StartsWith("admin/report")) activeMenuTitle = my ? "ကျောင်းဝင်ခွင့်အစီရင်ခံစာ" : "Admission Report";
        else activeMenuTitle = my ? "ပင်မစာမျက်နှာ" : "Dashboard";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        LangService.OnLanguageChanged -= HandleLanguageChanged;
    }

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    private void CloseProfileMenuImmediately()
    {
        isProfileMenuOpen = false;
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "AD";

        var parts = name.Split(new[] { ' ', '_', '.', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        else if (name.Length >= 2)
        {
            return name.Substring(0, 2).ToUpper();
        }
        return name.Substring(0, 1).ToUpper();
    }

    private async Task Logout()
    {
        isProfileMenuOpen = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("authFunctions.logout");
        }
        catch { }

        try
        {
            var customAuth = (CustomAuthStateProvider)AuthStateProvider;
            await customAuth.MarkUserAsLoggedOut();
        }
        catch { }

        NavigationManager.NavigateTo("/login?loggedOut=true", forceLoad: true);
    }
}