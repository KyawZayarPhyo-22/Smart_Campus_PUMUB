@page "/admin/rule/edit/{id:int}"
@rendermode InteractiveServer
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Rules
@using Smart_Campus_PUMUB.WebApi.Models

<div class="container-fluid py-4">
    <div class="tech-card p-4">
        <h4 class="text-white mb-4">Edit Rule</h4>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @ErrorMessage
            </div>
        }

        @if (isLoaded)
        {
            <EditForm Model="ruleModel" OnValidSubmit="UpdateRule" FormName="EditRuleForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label text-light">Rule Title <span class="text-danger">*</span></label>
                    <InputText @bind-Value="ruleModel.Title" class="form-control" />
                    <ValidationMessage For="@(() => ruleModel.Title)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Penalty (ပြစ်ဒဏ် / အရေးယူဆောင်ရွက်မှု) <span class="text-danger">*</span></label>
                    <InputText @bind-Value="ruleModel.Penalty" class="form-control" />
                    <ValidationMessage For="@(() => ruleModel.Penalty)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Description (အသေးစိတ် ဖော်ပြချက်)</label>
                    <InputTextArea @bind-Value="ruleModel.Description" class="form-control" rows="4" />
                </div>

                <div class="mt-4">
                    <NavLink href="/admin/rules" class="btn btn-secondary me-2">Cancel</NavLink>
                    <button type="submit" class="btn btn-primary" disabled="@isProcessing">
                        <i class="bi bi-check2-circle me-1.5"></i>
                        @(isProcessing ? "Updating..." : "Save Changes")
                    </button>
                </div>
            </EditForm>
        }
        else
        {
            <div class="text-center my-4 py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="text-muted mt-2">ဒေတာများကို ဆွဲယူနေပါသည်...</div>
            </div>
        }
    </div>
</div>