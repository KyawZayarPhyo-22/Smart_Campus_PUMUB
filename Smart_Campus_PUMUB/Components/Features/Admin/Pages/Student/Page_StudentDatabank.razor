@page "/admin/student-databank"
@layout AdminLayout
@rendermode InteractiveServer
@using Smart_Campus_PUMUB.WebApi.Models
@using Smart_Campus_PUMUB.BlazorServer.Frontend.Services

<style>
    .material-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .material-input {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        color: #495057;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .material-input:focus {
        background-color: #ffffff;
        border-color: #696cff;
        box-shadow: 0 0 0 0.2rem rgba(105, 108, 255, 0.15);
        color: #495057;
        outline: none;
    }

    .table-container {
        border-radius: 12px;
        overflow: hidden;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
    }

    .custom-table thead th {
        background-color: #5A4FCF;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: none;
        padding: 0.75rem 0.5rem;
        white-space: nowrap;
    }

    .custom-table tbody tr {
        border-bottom: 1px solid #f0f0f5;
        transition: all 0.2s ease;
    }

    .custom-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .custom-table td {
        padding: 0.75rem 0.5rem;
        color: #1f2937;
        font-weight: 600;
        vertical-align: middle;
        border: none;
        font-size: 0.85rem;
    }

    .badge-faculty {
        background: rgba(90, 79, 207, 0.12) !important;
        color: #1e1b4b !important;
        border: 1px solid rgba(90, 79, 207, 0.3) !important;
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-block;
        white-space: nowrap !important;
    }

    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        max-height: 228px;
        /* Approximately 6 items */
        overflow-y: auto;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        padding: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .dropdown-item-custom {
        padding: 8px 12px;
        font-size: 0.88rem;
        font-weight: 500;
        color: #374151;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 36px;
    }

    .dropdown-item-custom:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
        font-weight: 600;
    }

    .dropdown-item-custom.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }

    .btn-theme-primary {
        background-color: #4f46e5 !important;
        background: #4f46e5 !important;
        border-color: #4f46e5 !important;
        color: #ffffff !important;
    }

    .btn-theme-primary:hover {
        background-color: #4338ca !important;
        background: #4338ca !important;
        border-color: #4338ca !important;
        color: #ffffff !important;
    }

    .btn-view-profile {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: #ffffff !important;
        padding: 4px 11px !important;
        font-size: 0.78rem !important;
        font-weight: 700 !important;
        border-radius: 6px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 5px !important;
        text-decoration: none !important;
        transition: all 0.2s ease !important;
        box-shadow: 0 1px 3px rgba(13, 110, 253, 0.2) !important;
    }

    .btn-view-profile:hover {
        background-color: #0b5ed7 !important;
        border-color: #0a58ca !important;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(13, 110, 253, 0.35) !important;
    }

    .btn-view-profile i,
    .btn-view-profile span {
        color: #ffffff !important;
    }
</style>

@if (isFacultyDropdownOpen || isMajorDropdownOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseAllDropdowns"></div>
}

<div class="d-flex align-items-center justify-content-between mb-4 mt-2 flex-wrap gap-3 py-1">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-3 p-2 shadow-sm d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; background: rgba(13, 110, 253, 0.08); border: 1.5px solid rgba(13, 110, 253, 0.25);">
            <i class="bi bi-database fs-5" style="color: #0d6efd;"></i>
        </div>
        <div>
            <h4 class="fw-bolder mb-1" style="letter-spacing: 0.5px; color: #1e293b;">@(LangService.IsMyanmar ? "ကျောင်းသားမှတ်တမ်း" : "Student Databank")</h4>
            <small class="text-secondary d-block">@(LangService.IsMyanmar ? "ကျောင်းသားကိုယ်ရေးနှင့် ပညာရေးမှတ်တမ်းများ စီမံခန့်ခွဲခြင်း" : "Student profiles and academic records management")</small>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="material-card p-3 mb-4" style="position: relative; z-index: 1045;">
    <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-md-4">
            <div class="position-relative">
                <i class="bi bi-search position-absolute text-muted"
                   style="top: 50%; left: 14px; transform: translateY(-50%); pointer-events: none; z-index: 5; font-size: 0.9rem;"></i>
                <input type="text" class="form-control material-input search-input w-100"
                       style="padding-left: 2.6rem !important;"
                       placeholder="@(LangService.IsMyanmar ? "အမည်၊ ခုံအမှတ်ဖြင့် ရှာရန်..." : "Search by student name, roll no...")"
                       @bind="SearchInput" @onkeyup="HandleKeyUp" />
            </div>
        </div>

        <!-- Faculty Dropdown (approx 6 items height with scroll) -->
        <div class="col-md-3">
            <div class="custom-dropdown-container">
                <button type="button"
                        class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100"
                        @onclick="ToggleFacultyDropdown" disabled="@isFacultyAdminLocked">
                    <span class="text-truncate">@(SelectedFacultyInput == "All" ? (LangService.IsMyanmar ? "မဟာဌာန အားလုံး" : "All Faculties") :
                                                SelectedFacultyInput)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isFacultyDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(SelectedFacultyInput == "All" ? "selected" : "")"
                                 @onclick='() => SelectFaculty("All")'>
                                <span>@(LangService.IsMyanmar ? "မဟာဌာန အားလုံး" : "All Faculties")</span>
                                @if (SelectedFacultyInput == "All")
                                {
                                    <i class="bi bi-check2 text-primary"></i>
                                }
                            </div>
                            @if (AvailableFaculties != null)
                            {
                                @foreach (var faculty in AvailableFaculties)
                                {
                                    <div class="dropdown-item-custom @(SelectedFacultyInput == faculty ? "selected" : "")"
                                         @onclick='() => SelectFaculty(faculty)'>
                                        <span>@faculty</span>
                                        @if (SelectedFacultyInput == faculty)
                                        {
                                            <i class="bi bi-check2 text-primary"></i>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Major Dropdown (approx 6 items height with scroll) -->
            <div class="col-md-3">
                <div class="custom-dropdown-container">
                    <button type="button"
                            class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100"
                            @onclick="ToggleMajorDropdown">
                        <span class="text-truncate">@(SelectedMajorInput == "All" ? (LangService.IsMyanmar ? "မေဂျာ အားလုံး" : "All Majors") :
                                                    SelectedMajorInput)</span>
                            <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                        </button>

                        @if (isMajorDropdownOpen)
                        {
                            <div class="custom-dropdown-menu shadow">
                                <div class="dropdown-item-custom @(SelectedMajorInput == "All" ? "selected" : "")"
                                     @onclick='() => SelectMajor("All")'>
                                    <span>@(LangService.IsMyanmar ? "မေဂျာ အားလုံး" : "All Majors")</span>
                                    @if (SelectedMajorInput == "All")
                                    {
                                        <i class="bi bi-check2 text-primary"></i>
                                    }
                                </div>
                                @if (AvailableMajors != null)
                                {
                                    @foreach (var major in AvailableMajors)
                                    {
                                        <div class="dropdown-item-custom @(SelectedMajorInput == major ? "selected" : "")"
                                             @onclick='() => SelectMajor(major)'>
                                            <span>@major</span>
                                            @if (SelectedMajorInput == major)
                                            {
                                                <i class="bi bi-check2 text-primary"></i>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Search and Reset Buttons -->
                <div class="col-md-2 text-end d-flex gap-2 justify-content-end">
                    <button class="btn btn-theme-primary w-50 d-flex align-items-center justify-content-center" type="button"
                            @onclick="ApplyFilter" title="@(LangService.IsMyanmar ? "ရှာမည်" : "Search")">
                        <i class="bi bi-search"></i>
                    </button>
                    <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" type="button"
                            @onclick="ResetFilter" title="@(LangService.IsMyanmar ? "မူလအတိုင်း" : "Reset")">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="material-card table-container mb-5">
            <div class="table-responsive">
                <table class="table custom-table align-middle">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 45px; white-space: nowrap;">@(LangService.IsMyanmar ? "စဉ်" : "No")</th>
                            <th style="white-space: nowrap; min-width: 180px;">@(LangService.IsMyanmar ? "ကျောင်းသားအမည်" : "Student Name")</th>
                            <th class="text-center" style="width: 110px; white-space: nowrap;">@(LangService.IsMyanmar ? "ခုံအမှတ်" : "Roll No.")</th>
                            <th class="text-center" style="white-space: nowrap;">@(LangService.IsMyanmar ? "မဟာဌာန" : "Faculty")</th>
                            <th class="text-center" style="white-space: nowrap;">@(LangService.IsMyanmar ? "မေဂျာ" : "Major")</th>
                            <th class="text-center" style="width: 120px; white-space: nowrap;">@(LangService.IsMyanmar ? "ပညာသင်နှစ်" : "Academic Year")</th>
                            <th style="width: 120px; white-space: nowrap;">@(LangService.IsMyanmar ? "ဖုန်း" : "Phone")</th>
                            <th class="text-center" style="width: 85px; white-space: nowrap;">@(LangService.IsMyanmar ? "လုပ်ဆောင်ချက်" : "Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="d-flex flex-column align-items-center justify-content-center py-5"
                                         style="min-height: 250px;">
                                        <div class="spinner-border text-primary mb-3" role="status"
                                             style="width: 2.5rem; height: 2.5rem;">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <div class="text-muted fs-6 fw-bold" style="font-weight: 700;">@(LangService.IsMyanmar ? "ကျောင်းသားမှတ်တမ်းများ ရယူနေပါသည်..." : "Loading student databank records...")</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (Students != null && Students.Any())
                        {
                            var index = 1;
                            foreach (var student in Students)
                            {
                                int rowNumber = (CurrentPage - 1) * PageSize + index;
                                <tr>
                                    <td class="text-center fw-bold text-dark" style="white-space: nowrap;">@rowNumber.ToString("D2")</td>
                                    <td style="white-space: nowrap; min-width: 180px;">
                                        <div class="d-flex align-items-center gap-2" style="white-space: nowrap;">
                                            @if (LangService.IsMyanmar)
                                            {
                                                <span class="fw-bold text-dark text-nowrap" style="white-space: nowrap; font-size: 0.92rem;">@(!string.IsNullOrEmpty(student.student_name_mm) ? student.student_name_mm : student.student_name_en)</span>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-dark text-nowrap" style="white-space: nowrap; font-size: 0.92rem;">@(!string.IsNullOrEmpty(student.student_name_en) ? student.student_name_en : student.student_name_mm)</span>
                                            }
                                            @if (student.IsDisqualified || string.Equals(student.GraduationStatus, "Disqualified",
                                    StringComparison.OrdinalIgnoreCase) || string.Equals(student.Status, "Disqualified",
                                    StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge text-nowrap flex-shrink-0"
                                                      style="background: linear-gradient(135deg, #ef4444, #dc2626); color: #ffffff!important; font-size: 0.73rem; font-weight: 700; border-radius: 999px; padding: 2px 9px; box-shadow: 0 2px 6px rgba(239,68,68,0.3); white-space: nowrap;">
                                                    <i class="bi bi-slash-circle-fill me-1"></i> @(LangService.IsMyanmar ? "ဘွဲ့မရနိုင်" : "Disqualified")
                                                </span>
                                            }
                                            else if (student.IsGraduated || string.Equals(student.Status, "Graduated",
                                    StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge text-nowrap flex-shrink-0"
                                                      style="background: linear-gradient(135deg, #10b981, #059669); color: #ffffff!important; font-size: 0.73rem; font-weight: 700; border-radius: 999px; padding: 2px 9px; box-shadow: 0 2px 6px rgba(16,185,129,0.3); white-space: nowrap;">
                                                    <i class="bi bi-mortarboard-fill me-1"></i> @(LangService.IsMyanmar ? "ဘွဲ့ရပြီး" : "Graduated")
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1"
                                              style="font-size: 0.85rem; font-weight: 700;">
                                            @(string.IsNullOrWhiteSpace(student.roll_no) ? "-" : student.roll_no)
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark text-center" style="white-space: nowrap;">
                                        @if (!string.IsNullOrEmpty(student.FacultyName) && student.FacultyName != "-")
                                        {
                                            <span class="badge-faculty"
                                                  style="background: rgba(90, 79, 207, 0.12) !important; color: #1e1b4b !important; border: 1px solid rgba(90, 79, 207, 0.3) !important; border-radius: 20px; padding: 5px 14px; font-size: 0.82rem; font-weight: 700; display: inline-block; white-space: nowrap !important;">@student.FacultyName</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="text-center" style="white-space: nowrap;">
                                        <span class="badge fw-bold"
                                              style="background-color: rgba(105, 108, 255, 0.1); color: #696cff; font-weight: 700; white-space: nowrap !important;">
                                            @student.major
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold text-dark">@student.academic_year_range</td>
                                    <td class="fw-bold text-dark">@student.app_student_phone</td>
                                    <td class="text-center">
                                         <a href="/admin/student-databank/view/@(student.UserId ?? 0)/@(student.NewStudentAccId ?? 0)"
                                            class="btn btn-view-profile"
                                            title="@(LangService.IsMyanmar ? "ကြည့်မည်" : "View Details")">
                                             <i class="bi bi-person-lines-fill" style="color: #ffffff !important; font-size: 0.82rem;"></i>
                                             <span style="color: #ffffff !important; font-size: 0.78rem; font-weight: 700;">@(LangService.IsMyanmar ? "ကြည့်မည်" : "View")</span>
                                         </a>
                                     </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8"
                                    style="text-align: center !important; padding-top: 3rem !important; padding-bottom: 3rem !important; color: #6c757d;">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    @(LangService.IsMyanmar ? "ကျောင်းသားမှတ်တမ်း မရှိပါ။" : "No student records found.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Component -->
            <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
        </div>

