}

@code {
    public List<StudentEnrollmentResultModel>? AllResults { get; set; }
    public List<GradeModel>? AvailableGrades { get; set; } = GradeCalculator.DefaultGradeTiers.Select(t => new GradeModel
    {
        GradeId = 0,
        Name = t.LetterGrade,
        GradePoint = t.GradePoint,
        Status = t.Status,
        MinMark = t.MinMark,
        MaxMark = t.MaxMark
    }).ToList();
    public List<SemesterModel> SemesterList { get; set; } = new();
    
    // Filters
    private string SearchInput { get; set; } = "";
    private string SelectedSemesterInput { get; set; } = "All";

    private string SearchTerm { get; set; } = "";
    private string SelectedSemester { get; set; } = "All";

    // Pagination
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;
    private int TotalPages { get; set; } = 1;

    public bool IsLoading { get; set; } = true;
    public bool ShowDetailModal { get; set; } = false;
    public bool IsDetailLoading { get; set; } = false;
    public StudentEnrollmentResultModel? SelectedResult { get; set; }
    private StudentEnrollmentDetailResponseModel? DetailData { get; set; }

    private bool isSaving { get; set; } = false;
    private string saveMessage { get; set; } = "";
    private bool isSaveSuccess { get; set; } = false;

    private IEnumerable<string> AvailableSemesters
    {
        get
        {
            var apiSemesters = SemesterList
                .Where(s => !string.IsNullOrWhiteSpace(s.SemesterName))
                .Select(s => s.SemesterName!.Trim());

            var resultSemesters = (AllResults ?? new List<StudentEnrollmentResultModel>())
                .Where(r => !string.IsNullOrWhiteSpace(r.SemesterName))
                .Select(r => r.SemesterName!.Trim());

            return apiSemesters.Union(resultSemesters).Distinct().OrderBy(s => s);
        }
    }

    private bool isSemesterDropdownOpen = false;

    private void ToggleSemesterDropdown()
    {
        isSemesterDropdownOpen = !isSemesterDropdownOpen;
    }

    private void SelectSemester(string? semesterName)
    {
        SelectedSemesterInput = semesterName ?? "All";
        isSemesterDropdownOpen = false;
    }

    private void CloseAllDropdowns()
    {
        isSemesterDropdownOpen = false;
    }

    private IEnumerable<StudentEnrollmentResultModel> FilteredResults
    {
        get
        {
            if (AllResults == null) return Enumerable.Empty<StudentEnrollmentResultModel>();

            var list = AllResults.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var term = SearchTerm.Trim();
                list = list.Where(r => 
                    (r.StudentName != null && r.StudentName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (r.RollNo != null && r.RollNo.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (r.MajorName != null && r.MajorName.Contains(term, StringComparison.OrdinalIgnoreCase))
                );
            }

            if (!string.IsNullOrWhiteSpace(SelectedSemester) && SelectedSemester != "All")
            {
                list = list.Where(r => r.SemesterName != null && r.SemesterName.Equals(SelectedSemester, StringComparison.OrdinalIgnoreCase));
            }

            return list;
        }
    }

    private IEnumerable<StudentEnrollmentResultModel> PagedResults
    {
        get
        {
            var filtered = FilteredResults.ToList();
            TotalPages = (int)Math.Ceiling(filtered.Count / (double)PageSize);
            if (TotalPages == 0) TotalPages = 1;

            if (CurrentPage > TotalPages) CurrentPage = TotalPages;
            if (CurrentPage < 1) CurrentPage = 1;

            return filtered
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize);
        }
    }

    private async Task ApplyFilter()
    {
        SearchTerm = SearchInput;
        SelectedSemester = SelectedSemesterInput;
        CurrentPage = 1;
        IsLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        IsLoading = false;
        StateHasChanged();
    }

    private async Task ResetFilter()
    {
        SearchInput = "";
        SelectedSemesterInput = "All";
        SearchTerm = "";
        SelectedSemester = "All";
        CurrentPage = 1;
        IsLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        IsLoading = false;
        StateHasChanged();
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _ = ApplyFilter();
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        CurrentPage = newPage;
        IsLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        IsLoading = false;
        StateHasChanged();
    }

    private async Task OpenViewModal(StudentEnrollmentResultModel result)
    {
        SelectedResult = result;
        ShowDetailModal = true;
        IsDetailLoading = true;
        saveMessage = "";
        DetailData = null;

        try
        {
            var regId = result.RegistrationId ?? result.EnrollmentId;
            var url = $"Enrollment/registration/{regId}/details";
            DetailData = await HttpClientService.ExecuteAsync<StudentEnrollmentDetailResponseModel>(url, EnumHttpMethod.Get);

            if (DetailData?.Subjects != null)
            {
                foreach (var sub in DetailData.Subjects)
                {
                    if (!string.IsNullOrWhiteSpace(sub.Grade))
                    {
                        sub.GradePoint = GradeCalculator.GetGradePoint(sub.Grade);
                        sub.Status = GradeCalculator.GetGradeStatus(sub.Grade);
                        sub.GradePointEarned = GradeCalculator.CalculateGradePointsEarned(sub.GradePoint, sub.CreditUnit);
                        sub.IsPass = sub.Grade != "D" && sub.Grade != "F";
                    }
                    else if (sub.MarksObtained.HasValue)
                    {
                        var info = GradeCalculator.GetGradeInfoFromMarks(sub.MarksObtained.Value);
                        sub.Grade = info.LetterGrade;
                        sub.GradePoint = info.GradePoint;
                        sub.Status = info.Status;
                        sub.GradePointEarned = GradeCalculator.CalculateGradePointsEarned(sub.GradePoint, sub.CreditUnit);
                        sub.IsPass = sub.Grade != "D" && sub.Grade != "F";
                    }

                    if (!string.IsNullOrWhiteSpace(sub.ReexamGrade))
                    {
                        sub.ReexamIsPass = sub.ReexamGrade != "D" && sub.ReexamGrade != "F";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading details: {ex.Message}");
        }
        finally
        {
            IsDetailLoading = false;
        }
    }

    private void OnMarksChanged(StudentSubjectGradeItemModel sub, ChangeEventArgs e)
    {
        var valStr = e.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(valStr))
        {
            sub.MarksObtained = null;
            sub.Grade = string.Empty;
            sub.GradePoint = 0.0m;
            sub.GradePointEarned = 0.0m;
            sub.Status = string.Empty;
            sub.IsPass = false;
            sub.ReexamGrade = null;
            sub.ReexamMarksObtained = null;
            sub.ReexamIsPass = null;
            sub.IsSubjectDisqualified = false;
            StateHasChanged();
            return;
        }

        if (decimal.TryParse(valStr, out decimal marks))
        {
            // Strict range limits: Must be between 0 and 100
            if (marks < 0) marks = 0;
            if (marks > 100) marks = 100;
            sub.MarksObtained = marks;

            var info = GradeCalculator.GetGradeInfoFromMarks(marks);
            sub.Grade = info.LetterGrade;
            sub.GradePoint = info.GradePoint;
            sub.Status = info.Status;
            sub.GradePointEarned = GradeCalculator.CalculateGradePointsEarned(sub.GradePoint, sub.CreditUnit);
            sub.IsPass = sub.Grade != "D" && sub.Grade != "F";

            // If mark is a passing mark, auto-clear Reexam Grade, Reexam Marks, Reexam Status
            if (sub.IsPass)
            {
                sub.ReexamGrade = null;
                sub.ReexamMarksObtained = null;
                sub.ReexamIsPass = null;
                sub.IsSubjectDisqualified = false;
            }

            // If whole semester is failed (>50% failed), auto-clear all reexam fields
            if (IsEntireSemesterFailed())
            {
                foreach (var s in DetailData.Subjects)
                {
                    s.ReexamGrade = null;
                    s.ReexamMarksObtained = null;
                    s.ReexamIsPass = null;
                }
            }
        }
        else
        {
            sub.MarksObtained = null;
            sub.Grade = string.Empty;
            sub.GradePoint = 0.0m;
            sub.GradePointEarned = 0.0m;
            sub.Status = string.Empty;
            sub.IsPass = false;
            sub.ReexamGrade = null;
            sub.ReexamMarksObtained = null;
            sub.ReexamIsPass = null;
            sub.IsSubjectDisqualified = false;
        }
        StateHasChanged();
    }

    private void OnReexamGradeUpdated(StudentSubjectGradeItemModel sub)
    {
        if (!string.IsNullOrEmpty(sub.ReexamGrade))
        {
            sub.ReexamIsPass = sub.ReexamGrade != "D" && sub.ReexamGrade != "F";
            if (sub.ReexamIsPass == true)
            {
                sub.IsPass = true;
                sub.IsSubjectDisqualified = false;
            }
        }
        else
        {
            sub.ReexamIsPass = null;
        }
        StateHasChanged();
    }

    private bool IsEntireSemesterFailed()
    {
        if (DetailData?.Subjects == null || !DetailData.Subjects.Any()) return false;

        // Filter strictly to current semester curriculum subjects (exclude Retake and Carry-over subjects from previous semesters)
        var currentSemName = (DetailData.SemesterName ?? "").Trim();
        var curriculumSubs = DetailData.Subjects
            .Where(s => {
                if (s.IsRetake || s.IsCarriedOver) return false;
                if (!string.IsNullOrEmpty(currentSemName) && !string.IsNullOrEmpty(s.SemesterName))
                {
                    return string.Equals(s.SemesterName.Trim(), currentSemName, StringComparison.OrdinalIgnoreCase);
                }
                return true;
            })
            .ToList();

        // Fallback to all subjects only if no distinct curriculum subjects exist
        if (!curriculumSubs.Any())
        {
            curriculumSubs = DetailData.Subjects.ToList();
        }

        int totalCount = curriculumSubs.Count;
        if (totalCount == 0) return false;

        // Pass count: Grade is not D/F/empty, or Marks >= 50, or IsPass is true
        int passCount = curriculumSubs.Count(s =>
            s.IsPass ||
            (!string.IsNullOrWhiteSpace(s.Grade) && s.Grade != "D" && s.Grade != "F") ||
            (s.MarksObtained.HasValue && s.MarksObtained.Value >= 50));

        // 50% Rule: <= 50% passed means semester failed!
        return passCount <= (totalCount / 2.0);
    }

    private bool HasAnyGradedSubjects()
    {
        if (DetailData?.Subjects == null || !DetailData.Subjects.Any()) return false;
        return DetailData.Subjects.Any(s => s.MarksObtained.HasValue || (!string.IsNullOrWhiteSpace(s.Grade) && s.Grade != "-"));
    }

    private int GetTotalCredits()
    {
        if (DetailData?.Subjects == null) return 0;
        return DetailData.Subjects.Sum(s => s.CreditUnit);
    }

    private decimal GetTotalGradePoints()
    {
        if (DetailData?.Subjects == null) return 0.0m;
        return DetailData.Subjects.Sum(s => s.GradePointEarned);
    }

    private decimal GetSemesterGPA()
    {
        if (!HasAnyGradedSubjects()) return 0.0m;

        int totalCredits = GetTotalCredits();
        decimal totalGradePoints = GetTotalGradePoints();
        return GradeCalculator.CalculateSemesterGPA(totalGradePoints, totalCredits);
    }

    private decimal GetOverallCGPA()
    {
        if (!HasAnyGradedSubjects() && (DetailData?.PriorSemesterGPAs == null || !DetailData.PriorSemesterGPAs.Any()))
        {
            return 0.0m;
        }

        var allGpas = new List<decimal>();
        if (DetailData?.PriorSemesterGPAs != null && DetailData.PriorSemesterGPAs.Any())
        {
            allGpas.AddRange(DetailData.PriorSemesterGPAs);
        }

        decimal currentSemGpa = GetSemesterGPA();
        if (currentSemGpa > 0)
        {
            allGpas.Add(currentSemGpa);
        }

        if (!allGpas.Any()) return 0.0m;
        return GradeCalculator.CalculateCumulativeGPAFromSemesterGpas(allGpas);
    }

    private string GetStatusBadgeClass(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "bg-light text-secondary border";
        return status switch
        {
            "Excellent" => "bg-success text-white",
            "Very Good" => "bg-primary text-white",
            "Good" => "bg-info text-dark",
            "Satisfactory" => "bg-warning text-dark",
            "Marginal" => "bg-secondary text-white",
            "Poor" => "bg-danger text-white",
            _ => "bg-light text-secondary border"
        };
    }

    private void CloseViewModal()
    {
        ShowDetailModal = false;
        SelectedResult = null;
        DetailData = null;
        saveMessage = "";
    }

    private async Task SaveGrades()
    {
        if (DetailData == null || !DetailData.Subjects.Any()) return;

        isSaving = true;
        saveMessage = "";

        try
        {
            var req = new SaveStudentGradesRequestModel
            {
                RegistrationId = DetailData.RegistrationId,
                StudentId = DetailData.StudentId,
                SemesterId = DetailData.SemesterId,
                Grades = DetailData.Subjects.Select(s => new SaveGradeItemModel
                {
                    SubjectId = s.SubjectId,
                    Grade = s.Grade,
                    MarksObtained = s.MarksObtained
                }).ToList()
            };

            var res = await HttpClientService.ExecuteAsync<ActionResponseModel>("Enrollment/save-student-grades", EnumHttpMethod.Post, req);

            var reexamSubs = DetailData.Subjects.Where(s => !string.IsNullOrEmpty(s.ReexamGrade)).ToList();
            if (reexamSubs.Any())
            {
                var reexamReq = new SaveReexamGradesRequestModel
                {
                    RegistrationId = DetailData.RegistrationId,
                    StudentId = DetailData.StudentId,
                    SemesterId = DetailData.SemesterId,
                    ReexamGrades = reexamSubs.Select(s => new SaveReexamGradeItemModel
                    {
                        SubjectId = s.SubjectId,
                        ReexamGrade = s.ReexamGrade,
                        ReexamMarksObtained = s.ReexamMarksObtained
                    }).ToList()
                };

                await HttpClientService.ExecuteAsync<ActionResponseModel>("Enrollment/save-reexam-grades", EnumHttpMethod.Post, reexamReq);
            }

            if (res != null && res.IsSuccess)
            {
                isSaveSuccess = true;
                saveMessage = "Grades & Re-exam results saved successfully!";
                await LoadResults();
            }
            else
            {
                isSaveSuccess = false;
                saveMessage = res?.Message ?? "Failed to save grades.";
            }
        }
        catch (Exception ex)
        {
            isSaveSuccess = false;
            saveMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += HandleLanguageChanged;
        await Task.WhenAll(LoadResults(), LoadGrades(), LoadSemesters());
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LangService.OnLanguageChanged -= HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedLang = await JS.InvokeAsync<string?>("localStorage.getItem", "admin_dashboard_lang");
                if (!string.IsNullOrEmpty(savedLang) && savedLang != LangService.CurrentLanguage)
                {
                    LangService.SetLanguage(savedLang);
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task LoadSemesters()
    {
        try
        {
            SemesterList = await HttpClientService.ExecuteAsync<List<SemesterModel>>("Semester", EnumHttpMethod.Get) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading semesters: {ex.Message}");
        }
    }

    private async Task LoadGrades()
    {
        try
        {
            var apiGrades = await HttpClientService.ExecuteAsync<List<GradeModel>>("Grade", EnumHttpMethod.Get);
            if (apiGrades != null && apiGrades.Any())
            {
                AvailableGrades = apiGrades;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading grades: {ex.Message}");
        }
    }

    private async Task LoadResults()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var delayTask = Task.Delay(1000);
            var url = "Enrollment/results";
            var fetchTask = HttpClientService.ExecuteAsync<List<StudentEnrollmentResultModel>>(url, EnumHttpMethod.Get);

            await Task.WhenAll(fetchTask, delayTask);
            AllResults = await fetchTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading results: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}

<script>
    (function () {
        if (window.__markInputListenerAttached) return;
        window.__markInputListenerAttached = true;

        document.addEventListener("input", function (e) {
            if (e.target && e.target.classList.contains("mark-input")) {
                let val = e.target.value;
                if (val === "" || val === null || val === undefined) return;

                // Keep only digits and at most one decimal point
                val = val.replace(/[^0-9.]/g, "");
                const parts = val.split(".");
                if (parts.length > 2) {
                    val = parts[0] + "." + parts.slice(1).join("");
                }

                // Disallow multiple leading zeros e.g. "0000" -> "0", "08" -> "8"
                if (val.length > 1 && val.startsWith("0") && !val.startsWith("0.")) {
                    val = String(parseFloat(val) || 0);
                }

                // Clamp to max 100
                const num = parseFloat(val);
                if (!isNaN(num)) {
                    if (num > 100) {
                        val = "100";
                    } else if (num < 0) {
                        val = "0";
                    }
                }

                if (e.target.value !== val) {
                    e.target.value = val;
                }
            }
        }, true);

        document.addEventListener("keydown", function (e) {
            if (e.target && e.target.classList.contains("mark-input")) {
                if (e.key === "-" || e.key === "+" || e.key === "e" || e.key === "E") {
                    e.preventDefault();
                }
            }
        }, true);
    })();
</script>

