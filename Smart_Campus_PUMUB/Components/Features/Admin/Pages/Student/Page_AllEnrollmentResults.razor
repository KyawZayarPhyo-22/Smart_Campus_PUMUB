@page "/admin/enrollment-results"
@layout AdminLayout
@rendermode InteractiveServer
@using Smart_Campus_PUMUB.BlazorServer.Frontend.Services
@using Smart_Campus_PUMUB.WebApi.Models
@using Smart_Campus_PUMUB.Database.Services
@using GradeCalculator = Smart_Campus_PUMUB.Database.Services.GradeCalculator
@using Microsoft.AspNetCore.Components.Web
@inject HttpClientService HttpClientService
@inject AdminLanguageService LangService
@inject IJSRuntime JS
@implements IDisposable

<style>
    .material-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .material-input {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        color: #495057;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .material-input:focus {
        background-color: #ffffff;
        border-color: #696cff;
        box-shadow: 0 0 0 0.2rem rgba(105, 108, 255, 0.15);
        color: #495057;
        outline: none;
    }

    .search-input {
        padding-left: 2.6rem !important;
    }

    .table-container {
        border-radius: 12px;
        overflow: hidden;
    }

    .custom-table {
        margin-bottom: 0;
    }

    .custom-table thead th {
        background-color: #696cff;
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: none;
        padding: 1rem;
        white-space: nowrap;
    }

    .custom-table tbody tr {
        border-bottom: 1px solid #f0f0f5;
        transition: all 0.2s ease;
    }

    .custom-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .custom-table td {
        padding: 0.85rem 1rem;
        color: #495057;
        vertical-align: middle;
        border: none;
        font-size: 0.9rem;
    }

    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        max-height: 228px; /* Approximately 6 items */
        overflow-y: auto;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        padding: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .dropdown-item-custom {
        padding: 8px 12px;
        font-size: 0.88rem;
        font-weight: 500;
        color: #374151;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 36px;
    }

    .dropdown-item-custom:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
        font-weight: 600;
    }

    .dropdown-item-custom.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }

    .badge-modern {
        padding: 0.4em 0.7em;
        font-weight: 500;
        border-radius: 6px;
        letter-spacing: 0.5px;
    }

    .btn-theme-primary {
        background-color: #4f46e5 !important;
        background: #4f46e5 !important;
        border-color: #4f46e5 !important;
        color: #ffffff !important;
    }
    .btn-theme-primary:hover {
        background-color: #4338ca !important;
        background: #4338ca !important;
        border-color: #4338ca !important;
        color: #ffffff !important;
    }
</style>

@if (isSemesterDropdownOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseAllDropdowns"></div>
}

<div class="d-flex align-items-start gap-3 mb-4 mt-2">
    <div class="rounded-3 p-2 shadow-sm d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; background: rgba(90, 79, 207, 0.08); border: 1.5px solid rgba(90, 79, 207, 0.25);">
        <i class="bi bi-journal-check fs-5" style="color: #5A4FCF;"></i>
    </div>
    <div>
        <h4 class="fw-bolder text-white mb-0" style="letter-spacing: 0.5px;">
            @(LangService.IsMyanmar ? "စာမေးပွဲရလဒ်များ" : "Enrollment Results")
        </h4>
        <small class="text-secondary">
            @(LangService.IsMyanmar ? "ကျောင်းသားများ၏ ဘာသာရပ်စာရင်းသွင်း ရလဒ်များ စီမံခန့်ခွဲခြင်း" : "Manage student course enrollment results and grade records")
        </small>
    </div>
</div>

<!-- Filter Section -->
<div class="material-card p-3 mb-4" style="position: relative; z-index: 1045;">
    <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-md-6">
            <div class="position-relative">
                <i class="bi bi-search position-absolute text-muted" style="top: 50%; left: 14px; transform: translateY(-50%); pointer-events: none; z-index: 5; font-size: 0.9rem;"></i>
                <input type="text" class="form-control material-input search-input w-100" style="padding-left: 2.6rem !important;" 
                       placeholder="@(LangService.IsMyanmar ? "အမည်၊ ခုံအမှတ် သို့မဟုတ် ဘာသာရပ်ဖြင့် ရှာရန်..." : "Search by name, roll no or subject...")" 
                       @bind="SearchInput" @onkeyup="HandleKeyUp" />
            </div>
        </div>

        <!-- Semester Dropdown (approx 6 items height with scroll) -->
        <div class="col-md-4">
            <div class="custom-dropdown-container">
                <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                        @onclick="ToggleSemesterDropdown">
                    <span class="text-truncate">@(SelectedSemesterInput == "All" ? (LangService.IsMyanmar ? "စာသင်နှစ်ဝက် အားလုံး" : "All Semesters") : SelectedSemesterInput)</span>
                    <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                </button>

                @if (isSemesterDropdownOpen)
                {
                    <div class="custom-dropdown-menu shadow">
                        <div class="dropdown-item-custom @(SelectedSemesterInput == "All" ? "selected" : "")" 
                             @onclick='() => SelectSemester("All")'>
                            <span>@(LangService.IsMyanmar ? "စာသင်နှစ်ဝက် အားလုံး" : "All Semesters")</span>
                            @if (SelectedSemesterInput == "All") { <i class="bi bi-check2 text-primary"></i> }
                        </div>
                        @if (AvailableSemesters != null)
                        {
                            @foreach (var sem in AvailableSemesters)
                            {
                                <div class="dropdown-item-custom @(SelectedSemesterInput == sem ? "selected" : "")" 
                                     @onclick='() => SelectSemester(sem)'>
                                    <span>@sem</span>
                                    @if (SelectedSemesterInput == sem) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Search and Reset Buttons -->
        <div class="col-md-2 text-end d-flex gap-2 justify-content-end">
            <button class="btn btn-theme-primary w-50 d-flex align-items-center justify-content-center" type="button" @onclick="ApplyFilter" title="@(LangService.IsMyanmar ? "ရှာမည်" : "Search")">
                <i class="bi bi-search"></i>
            </button>
            <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" type="button" @onclick="ResetFilter" title="@(LangService.IsMyanmar ? "မူလအတိုင်း" : "Reset")">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
</div>

<!-- Table Section -->
<div class="material-card table-container mb-5">
    <div class="table-responsive">
        <table class="table custom-table align-middle">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px; white-space: nowrap;">@(LangService.IsMyanmar ? "စဉ်" : "No.")</th>
                    <th style="white-space: nowrap; min-width: 180px;">@(LangService.IsMyanmar ? "ကျောင်းသားအမည်" : "Student Name")</th>
                    <th class="text-center" style="white-space: nowrap;">@(LangService.IsMyanmar ? "ခုံအမှတ်" : "Roll No.")</th>
                    <th class="text-center" style="white-space: nowrap;">@(LangService.IsMyanmar ? "စာသင်နှစ်ဝက်" : "Semester")</th>
                    <th class="text-center" style="white-space: nowrap;">@(LangService.IsMyanmar ? "လုပ်ဆောင်ချက်" : "Action")</th>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="5">
                            <div class="d-flex flex-column align-items-center justify-content-center py-5" style="min-height: 250px;">
                                <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
                                    <span class="visually-hidden">@(LangService.IsMyanmar ? "ရယူနေပါသည်..." : "Loading...")</span>
                                </div>
                                <div class="text-muted fs-6 fw-bold" style="font-weight: 700;">
                                    @(LangService.IsMyanmar ? "ရလဒ်အချက်အလက်များ ရယူနေပါသည်..." : "Loading enrollment results...")
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else if (PagedResults != null && PagedResults.Any())
                {
                    var index = 1;
                    foreach (var result in PagedResults)
                    {
                        int rowNumber = (CurrentPage - 1) * PageSize + index;
                        <tr>
                            <td class="text-center text-muted fw-bold" style="white-space: nowrap;">@rowNumber.ToString("D2")</td>
                            <td class="fw-bold text-dark text-nowrap" style="font-weight: 700; color: #1e293b; white-space: nowrap; min-width: 180px;">@result.StudentName</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.85rem; font-weight: 600;">
                                    @(string.IsNullOrWhiteSpace(result.RollNo) ? "-" : result.RollNo)
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill fw-bold" style="background: #4F46E5; color: #ffffff !important; font-size: 0.82rem; padding: 6px 12px; letter-spacing: 0.3px;">
                                    @(string.IsNullOrWhiteSpace(result.SemesterName) ? "-" : result.SemesterName)
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-primary" style="padding: 4px 11px; font-size: 0.78rem; font-weight: 700; background-color: #0d6efd !important; border-color: #0d6efd !important; color: #ffffff !important; border-radius: 6px; display: inline-flex; align-items: center; gap: 5px;" @onclick="() => OpenViewModal(result)" title="@(LangService.IsMyanmar ? "အသေးစိတ်ကြည့်မည်" : "View Details")">
                                    <i class="bi bi-file-earmark-person" style="color: #ffffff !important; font-size: 0.82rem;"></i> 
                                    <span style="color: #ffffff !important; font-size: 0.78rem; font-weight: 700;">@(LangService.IsMyanmar ? "ကြည့်မည်" : "View")</span>
                                </button>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center !important; padding-top: 3rem !important; padding-bottom: 3rem !important; color: #6c757d;">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            @(LangService.IsMyanmar ? "ရလဒ်မှတ်တမ်းများ မတွေ့ရှိပါ။" : "No enrollment results found.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Component -->
    <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
</div>

@if (ShowDetailModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 1050; overflow-y: auto;">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="z-index: 1051; max-width: 1150px; width: 95%;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; background-color: #ffffff; color: #212529;">

                <!-- Modal Header -->
                <div class="modal-header border-bottom px-4 py-3 d-flex align-items-center justify-content-between" style="background-color: #f8fafc; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <div>
                        <h5 class="modal-title fw-bold text-dark d-flex align-items-center mb-0" style="font-size: 1.15rem;">
                            <i class="bi bi-journal-text text-primary me-2 fs-5"></i>
                            <span>@(LangService.IsMyanmar ? "ဘာသာရပ်နှင့် စာရင်းသွင်းမှု ရလဒ်ဖောင်" : "Course Description & Enrollment Form")</span>
                        </h5>
                        @if (DetailData != null)
                        {
                            <div class="small text-muted mt-1">
                                @(LangService.IsMyanmar ? "ကျောင်းသား" : "Student"): <strong class="text-dark">@DetailData.StudentName</strong> 
                                @if (!string.IsNullOrEmpty(DetailData.RollNo))
                                {
                                    <text> | @(LangService.IsMyanmar ? "ခုံအမှတ်" : "Roll No"): <strong class="text-dark">@DetailData.RollNo</strong></text>
                                }
                                @if (!string.IsNullOrEmpty(DetailData.SemesterName))
                                {
                                    <text> | @(LangService.IsMyanmar ? "စာသင်နှစ်ဝက်" : "Semester"): <strong class="text-primary">@DetailData.SemesterName</strong></text>
                                }
                                @if (!string.IsNullOrEmpty(DetailData.MajorName))
                                {
                                    <text> | @(LangService.IsMyanmar ? "မေဂျာ" : "Major"): <strong class="text-info">@DetailData.MajorName</strong></text>
                                }
                            </div>
                        }
                        else if (SelectedResult != null)
                        {
                            <div class="small text-muted mt-1">
                                @(LangService.IsMyanmar ? "ကျောင်းသား" : "Student"): <strong class="text-dark">@SelectedResult.StudentName</strong> 
                                @if (!string.IsNullOrEmpty(SelectedResult.RollNo))
                                {
                                    <text> | @(LangService.IsMyanmar ? "ခုံအမှတ်" : "Roll No"): <strong class="text-dark">@SelectedResult.RollNo</strong></text>
                                }
                                @if (!string.IsNullOrEmpty(SelectedResult.SemesterName))
                                {
                                    <text> | @(LangService.IsMyanmar ? "စာသင်နှစ်ဝက်" : "Semester"): <strong class="text-primary">@SelectedResult.SemesterName</strong></text>
                                }
                            </div>
                        }
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseViewModal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4">
                    @if (IsDetailLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@(LangService.IsMyanmar ? "ရယူနေပါသည်..." : "Loading...")</span>
                            </div>
                            <div class="text-muted small mt-2">
                                @(LangService.IsMyanmar ? "ဘာသာရပ်နှင့် ရလဒ်များ ရယူနေပါသည်..." : "Loading student subjects and prerequisites...")
                            </div>
                        </div>
                    }
                    else if (DetailData != null && DetailData.Subjects.Any())
                    {
                        bool isSemesterFail = IsEntireSemesterFailed();
                        bool hasGraded = HasAnyGradedSubjects();

                        @if (hasGraded && isSemesterFail)
                        {
                            <div class="alert alert-danger d-flex align-items-center mb-3 py-2 px-3 shadow-sm" style="border-radius: 8px; font-size: 0.88rem;">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                <div>
                                    <strong>@(LangService.IsMyanmar ? "နှစ်ဝက်တစ်ခုလုံး ကျရှုံးပါသည် (Semester Fail / Repeat Year)!" : "Semester Fail (Repeat Semester)!")</strong>
                                    <span class="ms-1">@(LangService.IsMyanmar ? "ဘာသာရပ် ၅၀% နှင့်အထက် ကျရှုံးထားသဖြင့် ဤ Semester တစ်ခုလုံးကို ပြန်တက်ရမည်ဖြစ်ပြီး Re-exam ဖြေဆိုခွင့် မရှိပါ။" : "Student failed >50% of semester curriculum subjects. Student must repeat the semester; Re-exam is not permitted.")</span>
                                </div>
                            </div>
                        }
                        else if (hasGraded && !isSemesterFail && DetailData.Subjects.Any(s => s.Grade == "D" || s.Grade == "F"))
                        {
                            <div class="alert alert-warning d-flex align-items-center mb-3 py-2 px-3 shadow-sm" style="border-radius: 8px; font-size: 0.88rem;">
                                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                <div>
                                    <strong>@(LangService.IsMyanmar ? "နှစ်ဝက် အောင်မြင်ပါသည် (Semester Pass - Re-exam ခွင့်ပြု)" : "Semester Passed (Re-exam Permitted)")</strong>
                                    <span class="ms-1">@(LangService.IsMyanmar ? "ကျရှုံးသော ဘာသာရပ်များအတွက် Re-exam အမှတ်/Grade ထည့်သွင်းနိုင်ပါသည်။" : "Re-exam grades can be entered for failed subjects.")</span>
                                </div>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle mb-0" style="border: 1px solid #dee2e6;">
                                <thead style="background-color: #f8fafc; border-bottom: 2px solid #dee2e6;">
                                    <tr class="text-center align-middle" style="font-weight: 600; font-size: 0.85rem; color: #495057; white-space: nowrap;">
                                        <th style="width: 35px; padding: 10px 4px;">@(LangService.IsMyanmar ? "စဉ်" : "No")</th>
                                        <th style="width: 90px; padding: 10px 4px;">@(LangService.IsMyanmar ? "ဘာသာရပ်ကုဒ်" : "Subject Code")</th>
                                        <th style="padding: 10px 12px; text-align: left;">@(LangService.IsMyanmar ? "ဘာသာရပ်အမည်" : "Course Description")</th>
                                        <th style="width: 65px; padding: 10px 4px;">@(LangService.IsMyanmar ? "Credit" : "Credit Unit")</th>
                                        <th style="width: 100px; padding: 10px 4px;">@(LangService.IsMyanmar ? "ရမှတ် (၀-၁၀၀)" : "Total Marks (0-100)")</th>
                                        <th style="width: 80px; padding: 10px 4px;">@(LangService.IsMyanmar ? "အဆင့်" : "Grade")</th>
                                        <th style="width: 75px; padding: 10px 4px;">@(LangService.IsMyanmar ? "Grade အမှတ်" : "Grade Score")</th>
                                        <th style="width: 90px; padding: 10px 4px;">@(LangService.IsMyanmar ? "ရရှိ Credit" : "Grade Point Earned")</th>
                                        <th style="width: 95px; padding: 10px 4px;">@(LangService.IsMyanmar ? "အခြေအနေ" : "Grade Status")</th>
                                        <th style="width: 95px; padding: 10px 4px;">@(LangService.IsMyanmar ? "Re-exam အဆင့်" : "Re-exam Grade")</th>
                                        <th style="width: 130px; padding: 10px 4px;">@(LangService.IsMyanmar ? "ရလဒ်" : "Result / Status")</th>
                                        <th style="width: 100px; padding: 10px 4px;">@(LangService.IsMyanmar ? "ကြိုတင်လိုအပ်ချက်" : "Pre-requisite")</th>
                                    </tr>
                                </thead>
                                <tbody style="font-size: 0.88rem; color: #212529;">
                                    @{ int sCount = 1; }
                                    @foreach (var sub in DetailData.Subjects)
                                    {
                                        bool isRegularFail = sub.Grade == "D" || sub.Grade == "F";
                                        bool showReexam = isRegularFail && !isSemesterFail && !sub.IsSubjectDisqualified;

                                        <tr style="@(sub.IsSubjectDisqualified ? "background-color: rgba(239, 68, 68, 0.08);" : (sub.IsRetake ? "background-color: rgba(245, 158, 11, 0.06);" : ""))">
                                            <td class="text-center fw-semibold text-muted">@sCount</td>
                                            <td class="text-center fw-bold text-primary">@sub.SubjectCode</td>
                                            <td>
                                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-1">
                                                    <div>
                                                        <div class="fw-bold text-dark" style="font-size: 0.9rem;">@sub.SubjectName</div>
                                                        <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                                            @if (sub.IsSubjectDisqualified)
                                                            {
                                                                <span class="badge rounded-pill shadow-sm" style="background-color: #dc2626 !important; color: #ffffff !important; font-size: 0.72rem; font-weight: 700; padding: 2px 8px; display: inline-flex; align-items: center; gap: 4px;">
                                                                    <i class="bi bi-slash-circle-fill"></i> @(LangService.IsMyanmar ? "Retake ပိတ်သိမ်း" : "Retake Barred")
                                                                </span>
                                                            }
                                                            else if (sub.IsRetake && !string.IsNullOrEmpty(sub.SemesterName))
                                                            {
                                                                <span class="badge rounded-pill shadow-sm" style="background-color: #d97706 !important; color: #ffffff !important; font-size: 0.72rem; font-weight: 700; padding: 2px 8px; display: inline-flex; align-items: center; gap: 4px;">
                                                                    <i class="bi bi-arrow-repeat"></i> @sub.SemesterName Retake
                                                                </span>
                                                            }
