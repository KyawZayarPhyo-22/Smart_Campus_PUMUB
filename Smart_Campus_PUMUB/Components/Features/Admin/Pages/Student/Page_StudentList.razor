                                                                                                    ပေးချေသည့်စနစ်</span>
                                                                                                    <strong class="text-dark">KBZPay (MMQR)</strong>
                                                                                                </div>

                                                                                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-dashed"
                                                                                                     style="font-size: 0.88rem;">
                                                                                                    <span class="text-muted"><i class="bi bi-calendar3 me-1 text-primary"></i> ရက်စွဲ</span>
                                                                                                    <strong class="text-dark"
                                                                                                            style="font-size: 0.82rem;">@(currentSlipPayment.CreatedDateTime?.ToString("dd MMM yyyy, hh:mm tt") ?? DateTime.Now.ToString("dd MMM yyyy, hh:mm tt"))</strong>
                                                                                                </div>

                                                                                                <div class="d-flex justify-content-between align-items-center py-2" style="font-size: 0.88rem;">
                                                                                                    <span class="text-muted"><i class="bi bi-shield-check me-1 text-primary"></i> အခြေအနေ</span>
                                                                                                    <span class="badge bg-success" style="font-size: 0.8rem; font-weight: 700;">
                                                                                                        <i class="bi bi-check-circle me-1"></i> @currentSlipPayment.Status
                                                                                                    </span>
                                                                                                </div>

                                                                                                <!-- Actions -->
                                                                                                <div class="d-flex gap-2 mt-4">
                                                                                                    <button type="button" class="btn btn-outline-secondary w-50 py-2 fw-bold"
                                                                                                            style="border-radius: 12px;" @onclick="PrintKpaySlip">
                                                                                                        <i class="bi bi-printer me-1"></i> Print Slip
                                                                                                    </button>
                                                                                                    <button type="button" class="btn btn-primary w-50 py-2 fw-bold"
                                                                                                            style="background: #003B95; border: none; border-radius: 12px;" @onclick="CloseKpaySlipModal">
                                                                                                        <i class="bi bi-x-lg me-1"></i> Close
                                                                                                    </button>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            }
