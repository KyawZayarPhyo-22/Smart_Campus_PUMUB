@page "/admin/student"
@layout AdminLayout
@rendermode InteractiveServer

<style>
    /* Material Card & Shadows */
    .material-card {
        background-color: #1e1e2d;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .material-input {
        background-color: #2b2b40;
        border: 1px solid #323248;
        color: #e4e6ef;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .material-input:focus {
        background-color: #323248;
        border-color: #696cff;
        box-shadow: 0 0 0 0.2rem rgba(105, 108, 255, 0.25);
        color: #ffffff;
        outline: none;
    }

    .table-container {
        border-radius: 12px;
        overflow: hidden;
    }

    .custom-table {
        margin-bottom: 0;
        background-color: transparent;
    }

    .custom-table thead th {
        background-color: #1a1a27;
        color: #a1a5b7;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 1px solid #2b2b40;
        padding: 1rem;
    }

    .custom-table tbody tr {
        border-bottom: 1px solid #2b2b40;
        transition: all 0.2s ease;
    }

    .custom-table tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.04);
    }

    .custom-table td {
        padding: 0.85rem 1rem;
        color: #1f2937;
        font-weight: 600;
        vertical-align: middle;
        border: none;
        font-size: 0.9rem;
    }

    .badge-faculty {
        background: rgba(90, 79, 207, 0.12) !important;
        color: #1e1b4b !important;
        border: 1px solid rgba(90, 79, 207, 0.3) !important;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.84rem;
        font-weight: 700;
        display: inline-block;
    }

    .badge-modern {
        padding: 0.4em 0.7em;
        font-weight: 500;
        border-radius: 6px;
        letter-spacing: 0.5px;
    }

    .badge-modern.bg-success,
    .badge.bg-success {
        background-color: #10b981 !important;
        color: #ffffff !important;
    }

    .badge-modern.bg-danger,
    .badge.bg-danger {
        background-color: #ef4444 !important;
        color: #ffffff !important;
    }

    .badge-modern.bg-warning,
    .badge.bg-warning {
        background-color: #f59e0b !important;
        color: #ffffff !important;
    }

    .search-input {
        padding-left: 2.6rem !important;
    }

    .btn-action {
        border-radius: 6px;
        padding: 0.4rem 1.2rem;
        font-size: 0.9rem;
        font-weight: 500;
        transition: transform 0.2s;
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-2px);
    }

    .btn-action:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        max-height: 228px;
        /* Approximately 6 items */
        overflow-y: auto;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        padding: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .dropdown-item-custom {
        padding: 8px 12px;
        font-size: 0.88rem;
        font-weight: 500;
        color: #374151;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 36px;
    }

    .dropdown-item-custom:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
        font-weight: 600;
    }

    .dropdown-item-custom.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }
</style>

@if (isLevelDropdownOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseAllDropdowns"></div>
}

<div class="d-flex align-items-center gap-3 mb-4 mt-2 py-1">
    <div class="rounded-3 p-2 shadow-sm d-flex align-items-center justify-content-center flex-shrink-0"
         style="width: 44px; height: 44px; background: rgba(13, 110, 253, 0.08); border: 1.5px solid rgba(13, 110, 253, 0.25);">
        <i class="bi bi-people fs-5" style="color: #0d6efd;"></i>
    </div>
    <div>
        <h4 class="fw-bolder mb-1" style="letter-spacing: 0.5px; color: #1e293b;">
            @(LangService.IsMyanmar ? "စာရင်းသွင်းမှတ်တမ်း" : "Register Databank")
        </h4>
        <small class="text-secondary d-block">
            @(LangService.IsMyanmar ? "ကျောင်းသားများ၏ ကျောင်းအပ်နှံမှု မှတ်တမ်းများ စီမံခန့်ခွဲခြင်း" : "Manage student admission registrations and payment approvals")
        </small>
    </div>
</div>

<!-- 🔹 Filter Section -->
<div class="material-card p-3 mb-4" style="position: relative; z-index: 1045;">
    <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-md-3">
            <div class="position-relative">
                <i class="bi bi-search position-absolute text-muted"
                   style="top: 50%; left: 14px; transform: translateY(-50%); pointer-events: none; z-index: 5; font-size: 0.9rem;"></i>
                <input type="text" class="form-control material-input search-input w-100"
                       style="padding-left: 2.6rem !important;" placeholder="@(LangService.IsMyanmar ? "အမည်၊ ခုံအမှတ်ဖြင့် ရှာရန်..." : "Search by name or roll no...")"
                       @bind="SearchInput" @onkeyup="HandleKeyUp" />
            </div>
        </div>

        <!-- Semester Dropdown (approx 6 items height with scroll) -->
        <div class="col-md-3">
            <div class="custom-dropdown-container">
                <button type="button"
                        class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100"
                        @onclick="ToggleLevelDropdown">
                    <span class="text-truncate">@(SelectedLevelInput == "All" ? (LangService.IsMyanmar ? "စာသင်နှစ်ဝက် အားလုံး" : "All Semesters") : SelectedLevelInput)</span>
                    <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                </button>

                @if (isLevelDropdownOpen)
                {
                    <div class="custom-dropdown-menu shadow">
                        <div class="dropdown-item-custom @(SelectedLevelInput == "All" ? "selected" : "")"
                             @onclick='() => SelectLevel("All")'>
                            <span>@(LangService.IsMyanmar ? "စာသင်နှစ်ဝက် အားလုံး" : "All Semesters")</span>
                            @if (SelectedLevelInput == "All")
                            {
                                <i class="bi bi-check2 text-primary"></i>
                            }
                        </div>
                        @if (AvailableSemesters != null)
                        {
                            @foreach (var sem in AvailableSemesters)
                            {
                                <div class="dropdown-item-custom @(SelectedLevelInput == sem ? "selected" : "")"
                                     @onclick='() => SelectLevel(sem)'>
                                    <span>@sem</span>
                                    @if (SelectedLevelInput == sem)
                                    {
                                        <i class="bi bi-check2 text-primary"></i>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 💡 From Date & To Date Range Picker (Student Report style) -->
        <div class="col-md-4">
            <div class="d-flex align-items-center gap-2">
                <input type="date" class="form-control material-input" @bind="FromDateInput" />
                <span class="text-muted fw-bold">~</span>
                <input type="date" class="form-control material-input" @bind="ToDateInput" />
            </div>
        </div>

        <!-- Search and Reset Buttons -->
        <div class="col-md-2 text-end d-flex gap-2 justify-content-end">
            <button class="btn btn-primary w-50 d-flex align-items-center justify-content-center" type="button"
                    style="background-color: #0d6efd !important; border-color: #0d6efd !important; height: 38px;"
                    @onclick="ApplyFilter" title="@(LangService.IsMyanmar ? "ရှာမည်" : "Search")">
                <i class="bi bi-search"></i>
            </button>
            <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" type="button"
                    style="height: 38px;"
                    @onclick="ResetFilter" title="@(LangService.IsMyanmar ? "မူလအတိုင်း" : "Reset")">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
</div>

<!-- 🔹 Table Section -->
<div class="material-card table-container mb-5">
    <div class="table-responsive">
        <table class="table custom-table align-middle">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">@(LangService.IsMyanmar ? "စဉ်" : "No.")</th>
                    <th class="text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "ရက်စွဲ" : "Date")</th>
                    <th class="text-center text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "ခုံအမှတ်" : "Roll No")</th>
                    <th class="text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "အမည်" : "Name")</th>
                    <th class="text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "မဟာဌာန" : "Faculty")</th>
                    <th class="text-center text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "စာသင်နှစ်ဝက်" : "Semester")</th>
                    <th class="text-center text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "အပ်နှံမှု အခြေအနေ" : "Reg Status")</th>
                    <th class="text-center text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "ငွေသွင်းမှု အခြေအနေ" : "Pay Status")</th>
                    <th class="text-center text-nowrap" style="white-space: nowrap;">@(LangService.IsMyanmar ? "လုပ်ဆောင်ချက်" : "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="9">
                            <div class="d-flex flex-column align-items-center justify-content-center py-5"
                                 style="min-height: 250px;">
                                <div class="spinner-border text-primary mb-3" role="status"
                                     style="width: 2.5rem; height: 2.5rem;">
                                    <span class="visually-hidden">@(LangService.IsMyanmar ? "ရယူနေပါသည်..." : "Loading...")</span>
                                </div>
                                <div class="text-muted fs-6 fw-bold" style="font-weight: 700;">
                                    @(LangService.IsMyanmar ? "ကျောင်းအပ်နှံမှု မှတ်တမ်းများ ရယူနေပါသည်..." : "Loading registration records...")
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else if (FilteredStudents != null && FilteredStudents.Any())
                {
                    int count = (CurrentPage - 1) * PageSize + 1;
                    @foreach (var s in FilteredStudents)
                    {
                        <tr>
                            <td class="text-center fw-bold text-dark">@count.ToString("D2")</td>
                            <td class="fw-bold text-dark text-nowrap" style="white-space: nowrap;">@s.CreatedDatetime.ToString("dd-MM-yyyy")</td>
                            <td class="text-center text-nowrap" style="white-space: nowrap;">
                                <span class="badge bg-light text-dark border px-2 py-1"
                                      style="font-size: 0.85rem; font-weight: 700;">
                                    @(string.IsNullOrWhiteSpace(s.RollNo) ? "-" : s.RollNo)
                                </span>
                            </td>
                            <td class="fw-bold text-dark text-nowrap" style="white-space: nowrap;">@s.StudentNameMm</td>
                            <td class="fw-bold text-dark text-nowrap" style="white-space: nowrap;">
                                <span class="badge-faculty text-nowrap"
                                      style="background: rgba(90, 79, 207, 0.12) !important; color: #1e1b4b !important; border: 1px solid rgba(90, 79, 207, 0.3) !important; border-radius: 20px; padding: 4px 14px; font-size: 0.84rem; font-weight: 700; display: inline-block; white-space: nowrap;">@GetFacultyDisplayName(s)</span>
                            </td>
                            <td class="text-center text-nowrap" style="white-space: nowrap;">
                                <span class="badge rounded-pill fw-bold"
                                      style="background: #4F46E5; color: #ffffff !important; font-size: 0.82rem; padding: 6px 12px; letter-spacing: 0.3px;">@s.AcademicYearLevel</span>
                            </td>

                            <td class="text-center text-nowrap" style="white-space: nowrap;">
                                <span class="badge badge-modern @GetStatusClass(s.Status)"
                                      style="color: #ffffff !important;">@FormatStatus(s.Status)</span>
                            </td>

                            <td class="text-center text-nowrap" style="white-space: nowrap;">
                                @if (s.RegistrationPayments.Any())
                                {
                                    var payStatus = s.RegistrationPayments.First().Status;
                                    <span class="badge badge-modern @GetStatusClass(payStatus)" style="color: #ffffff !important;">
                                        @FormatStatus(payStatus)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fw-bold">-</span>
                                }
                            </td>

                            <td class="text-center text-nowrap" style="white-space: nowrap;">
                                <div class="d-flex justify-content-center gap-1.5 align-items-center">
                                    <button class="btn btn-primary btn-action" style="padding: 3px 8px; font-size: 0.76rem; font-weight: 600; background-color: #0d6efd !important; border-color: #0d6efd !important; color: #ffffff !important; white-space: nowrap; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;"
                                            @onclick="() => OpenRegModal(s.RegistrationId)" title="@(LangService.IsMyanmar ? "အသေးစိတ် ကြည့်မည်" : "View Details")">
                                        <i class="bi bi-file-earmark-person" style="font-size: 0.74rem;"></i> @(LangService.IsMyanmar ? "အသေးစိတ်" : "Details")
                                    </button>
                                    <button class="btn btn-outline-success btn-action" style="padding: 3px 8px; font-size: 0.76rem; font-weight: 600; white-space: nowrap; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;"
                                            @onclick="() => OpenPaymentModal(s.RegistrationId)" title="@(LangService.IsMyanmar ? "ငွေသွင်းပြေစာ ကြည့်မည်" : "View Payment")">
                                        <i class="bi bi-credit-card" style="font-size: 0.74rem;"></i> @(LangService.IsMyanmar ? "ပြေစာ" : "Slip")
                                    </button>
                                </div>
                            </td>
                        </tr>
                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9"
                            style="text-align: center !important; padding-top: 3rem !important; padding-bottom: 3rem !important; color: #6c757d;">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            @(LangService.IsMyanmar ? "ကျောင်းအပ်နှံမှု မှတ်တမ်းများ မတွေ့ရှိပါ။" : "No registration records found.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 🔹 Pagination Component -->
    <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
</div>

        <!-- 🔹 View Modal Section -->
        @if (ShowDetailModal && SelectedDetail != null)
        {
            var payment = SelectedDetail.RegistrationPayments?.FirstOrDefault();

            <div class="modal show d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 1050; overflow-y: auto;">
                <div class="modal-dialog modal-xl modal-dialog-centered" style="z-index: 1051; max-width: 1100px;">
                    <div class="modal-content border-0 shadow-lg"
                         style="border-radius: 16px; background-color: #ffffff; color: #1f2937;">

                        <!-- Modal Header -->
                        <div class="modal-header border-bottom px-4 py-3 d-flex align-items-center justify-content-between"
                             style="background-color: #f8fafc; border-top-left-radius: 16px; border-top-right-radius: 16px;">
                            <h5 class="modal-title fw-bold text-dark d-flex align-items-center mb-0" style="font-size: 1.25rem;">
                                @if (IsPaymentViewMode)
                                {
                                    <i class="bi bi-credit-card-fill text-success me-2 fs-4"></i>
                                    <text>@(LangService.IsMyanmar ? "ငွေသွင်းမှု ပြေစာအတည်ပြုခြင်း" : "Payment Receipt Verification")</text>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-person-fill text-success me-2 fs-4"></i>
                                    <text>@(LangService.IsMyanmar ? "ကျောင်းသား စာရင်းသွင်းမှုဖောင် အချက်အလက်များ" : "Student Registration Details")</text>
                                }
                            </h5>
                            <button type="button" class="btn-close" style="filter: none; opacity: 0.8;"
                                    @onclick="CloseViewModal"></button>
                        </div>

                        <!-- Modal Body (Styled Form Layout) -->
                        <div class="modal-body p-4" style="background-color: #f1f5f9;">
                            <!-- Stepper Mockup (Shows completed state) -->
                            @if (!IsPaymentViewMode)
                            {
                                <div class="d-flex justify-content-around align-items-center mb-4 bg-white p-3 rounded shadow-sm">
                                    <div class="d-flex align-items-center gap-2" style="cursor: pointer;"
                                         @onclick="() => ModalCurrentStep = 1">
                                        <span
                                        class="rounded-circle @(ModalCurrentStep >= 1 ? "bg-success" : "bg-secondary") text-white d-flex align-items-center justify-content-center fw-bold"
                                        style="width: 28px; height: 28px; font-size: 0.85rem;">1</span>
                                        <span class="fw-semibold @(ModalCurrentStep == 1 ? "text-primary" : "text-secondary")"
                                              style="font-size: 0.9rem;">@(LangService.IsMyanmar ? "ကိုယ်ရေးအချက်အလက်" : "Personal Info")</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 1.2rem;">➔</div>
                                    <div class="d-flex align-items-center gap-2" style="cursor: pointer;"
                                         @onclick="() => ModalCurrentStep = 2">
                                        <span
                                        class="rounded-circle @(ModalCurrentStep >= 2 ? "bg-success" : "bg-secondary") text-white d-flex align-items-center justify-content-center fw-bold"
                                        style="width: 28px; height: 28px; font-size: 0.85rem;">2</span>
                                        <span class="fw-semibold @(ModalCurrentStep == 2 ? "text-primary" : "text-secondary")"
                                              style="font-size: 0.9rem;">@(LangService.IsMyanmar ? "ပညာရေးအချက်အလက်" : "Academic Info")</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 1.2rem;">➔</div>
                                    <div class="d-flex align-items-center gap-2" style="cursor: pointer;"
                                         @onclick="() => ModalCurrentStep = 3">
                                        <span
                                        class="rounded-circle @(ModalCurrentStep >= 3 ? "bg-success" : "bg-secondary") text-white d-flex align-items-center justify-content-center fw-bold"
                                        style="width: 28px; height: 28px; font-size: 0.85rem;">3</span>
                                        <span class="fw-semibold @(ModalCurrentStep == 3 ? "text-primary" : "text-secondary")"
                                              style="font-size: 0.9rem;">@(LangService.IsMyanmar ? "မိဘ/အုပ်ထိန်းသူ" : "Family & Guardian")</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-around align-items-center mb-4 bg-white p-3 rounded shadow-sm">
                                    <div class="d-flex align-items-center gap-2">
                                        <span
                                            class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold"
                                            style="width: 28px; height: 28px; font-size: 0.85rem;"><i
                                            class="bi bi-credit-card"></i></span>
                                            <span class="fw-semibold text-primary" style="font-size: 0.95rem;">@(LangService.IsMyanmar ? "ငွေပေးချေမှု အချက်အလက်နှင့် အတည်ပြုချက်" : "Payment Info & Verification")</span>
                                            </div>
                                        </div>
                                    }

                                    <div class="row g-4">
                                        <div class="col-12">
                                            @if (ModalCurrentStep == 1)
                                            {
                                                <!-- SECTION 1: Personal Info -->
                                                <div class="bg-white p-4 mb-4 border rounded shadow-sm">
                                                    <h6 class="fw-bold mb-3 pb-2 border-bottom text-success d-flex align-items-center">
                                                        <i class="bi bi-person-fill me-2 fs-5"></i> @(LangService.IsMyanmar ? "၁။ ကိုယ်ရေးအချက်အလက်" : "1. Personal Information")
                                                    </h6>

                                                    <div class="row g-3">
                                                        <!-- Passport Photo Alignment -->
                                                        <div class="col-12 d-flex justify-content-center mb-3">
                                                            <div class="border rounded p-1 bg-light text-center"
                                                                 style="width: 120px; height: 150px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                                                @if (!string.IsNullOrEmpty(SelectedDetail.StudentImage))
                                                                {
                                                                    <img src="@GetStudentImageUrl(SelectedDetail.StudentImage)"
                                                                         alt="Student Profile" class="img-fluid"
                                                                         style="height: 100%; width: 100%; object-fit: cover;" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="text-muted">
                                                                        <i class="bi bi-person-bounding-box fs-1 d-block mb-1"></i>
                                                                        <span style="font-size: 0.75rem;">No Photo</span>
                                                                    </div>
                                                                }
                                                            </div>
