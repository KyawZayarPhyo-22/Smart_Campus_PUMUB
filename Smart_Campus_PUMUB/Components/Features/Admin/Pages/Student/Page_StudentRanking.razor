                {
                    <div class="col-8">
                        <strong>@(LangService.IsMyanmar ? "ဘာသာရပ်" : "Subject"):</strong> @(string.IsNullOrEmpty(SelectedSubjectCode) || SelectedSubjectCode == "All" ? (LangService.IsMyanmar ? "ဘာသာရပ် အားလုံး" : "All Subjects") : $"{SelectedSubjectCode} - {AvailableSubjectsForFilter.FirstOrDefault(s => s.SubjectCode == SelectedSubjectCode)?.SubjectName}")
