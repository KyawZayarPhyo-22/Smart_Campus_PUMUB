                                            <td class="text-center">
                                                @if (sub.IsPass)
                                                {
                                                    <span class="badge badge-modern bg-success" style="color: #ffffff !important;">Pass</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-modern bg-danger" style="color: #ffffff !important;">Fail</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer border-top px-4 py-2.5">
                        <button type="button" class="btn btn-secondary shadow-sm" style="border-radius: 8px;" @onclick="CloseModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── 6. MASTER DEGREE GPA HISTORY MODAL ──────────────────── -->
    @if (ShowMasterModal && SelectedMasterStudent != null)
    {
        <div class="modal fade show d-block no-print" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content ranking-modal-content">
                    <div class="modal-header border-bottom px-4 py-3 d-flex align-items-center justify-content-between" style="background-color: #f8fafc; border-top-left-radius: 16px; border-top-right-radius: 16px;">
                        <div>
                            <h5 class="modal-title fw-bold text-dark d-flex align-items-center mb-0" style="font-size: 1.15rem;">
                                <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                                @SelectedMasterStudent.StudentName (@SelectedMasterStudent.RollNo)
                            </h5>
                            <small class="text-muted">
                                @SelectedMasterStudent.FacultyName | @SelectedMasterStudent.MajorName
                            </small>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body p-4" style="background-color: #f8fafc;">
                        <!-- CGPA Verdict Banner -->
                        <div class="cgpa-verdict-banner mb-3 @(SelectedMasterStudent.MasterEligibilityStatus == "MasterEligible" ? "banner-eligible" : (SelectedMasterStudent.MasterEligibilityStatus == "Disqualified" || SelectedMasterStudent.MasterEligibilityStatus == "CgpaIneligible" ? "banner-bachelor" : "banner-bachelor"))">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div>
                                    <div class="verdict-title">
                                        @if (SelectedMasterStudent.MasterEligibilityStatus == "MasterEligible")
                                        {
                                            <span>⭐ မဟာဘွဲ့ တက်ရောက်ခွင့် ရရှိသူ (Master Degree Eligible)</span>
                                        }
                                        else if (SelectedMasterStudent.MasterEligibilityStatus == "BachelorOnly")
                                        {
                                            <span>🎓 ရိုးရိုးဘွဲ့ ရရှိသူ (Bachelor Degree Only)</span>
                                        }
                                        else if (SelectedMasterStudent.MasterEligibilityStatus == "Disqualified")
                                        {
                                            <span class="text-danger">⛔ Retake စည်းကမ်းမပြည့်မီသဖြင့် ဘွဲ့မရရှိနိုင်သူ (Disqualified)</span>
                                        }
                                        else if (SelectedMasterStudent.MasterEligibilityStatus == "CgpaIneligible")
                                        {
                                            <span class="text-danger">❌ CGPA မပြည့်မီသဖြင့် ဘွဲ့မရရှိသူ (Ineligible - CGPA &lt; 2.00)</span>
                                        }
                                        else
                                        {
                                            <span>⏳ ပညာသင်ယူဆဲ (Studying / In Progress)</span>
                                        }
                                    </div>
                                    <div class="verdict-subtext">
                                        @if (SelectedMasterStudent.MasterEligibilityStatus == "MasterEligible")
                                        {
                                            <span>Semester အားလုံးအောင်မြင်ပြီး Cumulative GPA (CGPA) သည် 3.00 နှင့်အထက် ရှိသောကြောင့် မဟာဘွဲ့တက်ရောက်ခွင့် အရည်အချင်းပြည့်မီပါသည်။</span>
                                        }
                                        else if (SelectedMasterStudent.MasterEligibilityStatus == "BachelorOnly")
                                        {
                                            <span>Semester အားလုံးအောင်မြင်ပြီး Cumulative GPA (CGPA) သည် 2.00 မှ 3.00 အောက် ဖြစ်သောကြောင့် ဘွဲ့ကြိုရိုးရိုးဘွဲ့သာ ရရှိမည် ဖြစ်ပါသည်။</span>
                                        }
                                        else if (SelectedMasterStudent.MasterEligibilityStatus == "Disqualified")
                                        {
                                            <span>Retake အများဆုံးကန့်သတ်ချက် ပြည့်သွားခြင်း သို့မဟုတ် စည်းကမ်းမပြည့်မီသဖြင့် ဘွဲ့ရရှိခွင့် မရှိတော့ပါ။</span>
                                        }
                                        else if (SelectedMasterStudent.MasterEligibilityStatus == "CgpaIneligible")
                                        {
                                            <span>Cumulative GPA (CGPA) သည် ဘွဲ့ရရန် သတ်မှတ်ချက် 2.00 မပြည့်မီသဖြင့် ဘွဲ့ရရှိခွင့် မရှိပါ။</span>
                                        }
                                        else
                                        {
                                            <span>Semester အားလုံး မပြီးမြောက်သေးသဖြင့် လက်ရှိပညာသင်ယူဆဲ အဆင့် ဖြစ်ပါသည်။</span>
                                        }
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="cgpa-giant-display">@SelectedMasterStudent.CumulativeGPA.ToString("F2")</span>
                                    <div class="cgpa-giant-scale">/ 4.00 CGPA</div>
                                </div>
                            </div>
                        </div>

                        <!-- Semester-by-Semester GPA Breakdown Table -->
                        <h6 class="fw-bold mt-3 mb-2 text-dark">
                            <i class="bi bi-bar-chart-line me-1 text-primary"></i>
                            @(LangService.IsMyanmar ? "စာသင်နှစ်ဝက်အလိုက် ရမှတ်နှင့် GPA မှတ်တမ်း" : "Semester-wise GPA History")
                        </h6>
                        <div class="material-card table-container">
                            <table class="table custom-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Semester</th>
                                        <th class="text-center">Total Credits</th>
                                        <th class="text-center">Total Marks</th>
                                        <th class="text-center">Semester GPA</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sem in SelectedMasterStudent.SemesterHistory)
                                    {
                                        <tr>
                                            <td><strong class="text-primary">@sem.SemesterName</strong></td>
                                            <td class="text-center fw-bold">@sem.Credits</td>
                                            <td class="text-center fw-semibold">@sem.TotalMarks.ToString("F1")</td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill fw-bold" style="background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; font-size: 0.84rem; padding: 4px 10px;">
                                                    @sem.SemesterGPA.ToString("F2")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (sem.IsPassAll)
                                                {
                                                    <span class="badge badge-modern bg-success" style="color: #ffffff !important;">Pass</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-modern bg-danger" style="color: #ffffff !important;">Fail</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td>Total Cumulative</td>
                                        <td class="text-center">@SelectedMasterStudent.TotalCompletedCredits</td>
                                        <td class="text-center">@SelectedMasterStudent.TotalCumulativeMarks.ToString("F1")</td>
                                        <td class="text-center text-success fs-6">@SelectedMasterStudent.CumulativeGPA.ToString("F2")</td>
                                        <td class="text-center">
                                            @if (SelectedMasterStudent.MasterEligibilityStatus == "MasterEligible")
                                            {
                                                <span class="badge badge-modern bg-success" style="color: #ffffff !important;">Master Eligible</span>
                                            }
                                            else if (SelectedMasterStudent.MasterEligibilityStatus == "BachelorOnly")
                                            {
                                                <span class="badge bg-secondary text-white rounded-pill px-2.5 py-1">Bachelor Only</span>
                                            }
                                            else if (SelectedMasterStudent.MasterEligibilityStatus == "Disqualified")
                                            {
                                                <span class="badge bg-danger text-white rounded-pill px-2.5 py-1">Disqualified</span>
                                            }
                                            else if (SelectedMasterStudent.MasterEligibilityStatus == "CgpaIneligible")
                                            {
                                                <span class="badge bg-danger text-white rounded-pill px-2.5 py-1">CGPA &lt; 2.00</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-secondary rounded-pill px-2.5 py-1">In Progress</span>
                                            }
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer border-top px-4 py-2.5">
                        <button type="button" class="btn btn-secondary shadow-sm" style="border-radius: 8px;" @onclick="CloseModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
