@page "/admin/student-ranking"
@layout AdminLayout
@rendermode InteractiveServer
@using Smart_Campus_PUMUB.WebApi.Models

<style>
    /* Material Card & Shadows matching Register Databank (Page_StudentList) */
    .material-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .material-input {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        color: #495057;
        border-radius: 8px;
        padding: 0.5rem 0.85rem;
        font-size: 0.88rem;
        transition: all 0.3s ease;
    }

    .material-input:focus {
        background-color: #ffffff;
        border-color: #696cff;
        box-shadow: 0 0 0 0.2rem rgba(105, 108, 255, 0.15);
        color: #495057;
        outline: none;
    }

    .table-container {
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        border: 1px solid #edf2f7;
        overflow: hidden;
    }

    .table-responsive {
        overflow-x: hidden !important;
        overflow-y: visible !important;
        width: 100% !important;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
        table-layout: auto;
    }

    .custom-table thead th {
        background-color: #5A4FCF !important;
        color: #ffffff !important;
        font-size: 0.74rem !important;
        font-weight: 600 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.4px !important;
        border-bottom: none !important;
        padding: 0.65rem 0.5rem !important;
        white-space: nowrap !important;
    }

    .custom-table tbody tr {
        border-bottom: 1px solid #f0f0f5;
        transition: all 0.2s ease;
    }

    .custom-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .custom-table td {
        padding: 0.65rem 0.5rem;
        color: #1f2937;
        font-weight: 600;
        vertical-align: middle;
        border: none;
        font-size: 0.85rem;
    }

    .badge-faculty {
        background: rgba(90, 79, 207, 0.12) !important;
        color: #1e1b4b !important;
        border: 1px solid rgba(90, 79, 207, 0.3) !important;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-block;
        white-space: nowrap !important;
    }

    .badge-modern {
        padding: 0.4em 0.7em;
        font-weight: 600;
        border-radius: 20px;
        letter-spacing: 0.3px;
        font-size: 0.82rem;
    }

    .badge-modern.bg-success,
    .badge.bg-success {
        background-color: #10b981 !important;
        color: #ffffff !important;
    }

    .badge-modern.bg-danger,
    .badge.bg-danger {
        background-color: #ef4444 !important;
        color: #ffffff !important;
    }

    .badge-modern.bg-warning,
    .badge.bg-warning {
        background-color: #f59e0b !important;
        color: #ffffff !important;
    }

    .btn-action {
        border-radius: 6px;
        padding: 3px 10px;
        font-size: 0.78rem;
        font-weight: 600;
        transition: transform 0.2s;
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-1px);
    }

    /* ── TAB NAVIGATION BAR ──────────────────────────────────── */
    .ranking-tabs-bar {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
        background: #f1f5f9;
        padding: 0.35rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .ranking-tab {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.65rem 1rem;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #475569;
        font-weight: 600;
        font-size: 0.88rem;
        transition: all 0.2s;
        cursor: pointer;
    }

    .ranking-tab:hover {
        color: #1e293b;
        background: rgba(255, 255, 255, 0.6);
    }

    .ranking-tab.active {
        background: #5A4FCF;
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(90, 79, 207, 0.25);
    }

    /* ── CUSTOM SEARCHABLE & SCROLLABLE DROPDOWN ─────────────── */
    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-trigger {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 0.5rem 0.85rem;
        font-size: 0.88rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.2s;
    }

    .custom-dropdown-trigger:hover {
        border-color: #cbd5e1;
    }

    .custom-dropdown-trigger.open {
        background-color: #ffffff;
        border-color: #696cff;
        box-shadow: 0 0 0 0.2rem rgba(105, 108, 255, 0.15);
    }

    .trigger-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 500;
        color: #1e293b;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        width: 100%;
        min-width: 320px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        z-index: 1050;
        overflow: hidden;
    }

    .dropdown-search-box {
        padding: 0.5rem;
        border-bottom: 1px solid #f1f5f9;
        position: relative;
        background: #f8fafc;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 0.85rem;
    }

    .dropdown-search-input {
        padding-left: 2rem;
        font-size: 0.82rem;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
    }

    .dropdown-items-scrollable {
        max-height: 220px;
        overflow-y: auto;
    }

    .dropdown-items-scrollable::-webkit-scrollbar {
        width: 6px;
    }

    .dropdown-items-scrollable::-webkit-scrollbar-track {
        background: #f8fafc;
    }

    .dropdown-items-scrollable::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }

    .dropdown-item-option {
        padding: 0.55rem 0.85rem;
        font-size: 0.84rem;
        cursor: pointer;
        border-bottom: 1px solid #f8fafc;
        display: flex;
        align-items: center;
        transition: background 0.15s;
    }

    .dropdown-item-option:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
    }

    .dropdown-item-option.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }

    .dropdown-item-empty {
        padding: 1rem;
        text-align: center;
        color: #94a3b8;
        font-size: 0.82rem;
    }

    /* ── MODALS ────────────────────────────────────────────────── */
    .ranking-modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    .modal-summary-ribbon {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.85rem;
        text-align: center;
        gap: 0.5rem;
    }

    .ribbon-label { font-size: 0.75rem; color: #64748b; display: block; }
    .ribbon-val { font-size: 1.15rem; font-weight: 800; }

    .cgpa-verdict-banner {
        padding: 1.25rem;
        border-radius: 12px;
    }

    .banner-eligible { background: #ecfdf5; border: 1px solid #a7f3d0; }
    .banner-bachelor { background: #f8fafc; border: 1px solid #e2e8f0; }

    .verdict-title { font-size: 1.05rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem; }
    .verdict-subtext { font-size: 0.85rem; color: #475569; }

    .cgpa-giant-display { font-size: 2.2rem; font-weight: 900; color: #047857; line-height: 1; }
    .cgpa-giant-scale { font-size: 0.75rem; color: #64748b; font-weight: 600; }

    /* ── Screen UI Badges ──────────────────────────────────────── */
    .badge-rollno {
        display: inline-block;
        padding: 3px 8px;
        font-size: 0.82rem;
        font-weight: 700;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #1e293b;
        font-family: monospace;
    }
    .badge-year {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.8rem;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
    }
    .badge-subcode {
        display: inline-block;
        padding: 2px 8px;
        font-size: 0.76rem;
        border-radius: 20px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
        font-family: monospace;
    }
    .subject-title {
        font-size: 0.82rem;
        line-height: 1.25;
        padding-left: 2px;
    }
    .badge-marks {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.82rem;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }
    .badge-sem {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        background: #4F46E5;
        color: #ffffff !important;
        letter-spacing: 0.3px;
    }
    .badge-totalmarks {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.82rem;
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
    }
    .badge-cgpa {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.82rem;
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }
    .badge-status-master {
        background: #10b981;
        color: #ffffff !important;
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }
    .badge-status-bachelor {
        background: rgba(90, 79, 207, 0.12);
        color: #4338ca;
        border: 1px solid rgba(90, 79, 207, 0.3);
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }
    .badge-status-disqualified {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }
    .badge-status-ineligible {
        background: #fff1f2;
        color: #e11d48;
        border: 1px solid #ffe4e6;
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }
    .badge-status-inprogress {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }

    /* ── Official Publication-Quality A4 Print Styles ─────────────────────── */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 8mm 8mm 12mm 8mm;
        }

        html, body {
            background-color: #ffffff !important;
            color: #000000 !important;
            font-size: 10pt !important;
            font-family: 'Pyidaungsu', 'Segoe UI', Arial, sans-serif !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Completely hide layout elements (Sidebar, Topnav, Modals, Tabs, Buttons) */
        .admin-topnav,
        .admin-sidebar,
        .admin-offcanvas,
        .sidebar-brand,
        .sidebar,
        .top-navbar,
        nav,
        header,
        footer,
        .no-print,
        .d-print-none,
        .ranking-tabs-bar,
        .btn,
        .pagination-container,
        .modal,
        .modal-backdrop,
        #mobileSidebar,
        #desktopSidebar,
        .admin-topnav * {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            width: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* Reset wrapper containers to full page */
        .admin-wrapper,
        .admin-main,
        .admin-body,
        main.admin-body,
        .admin-main main {
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
            background-color: #ffffff !important;
            color: #000000 !important;
            overflow: visible !important;
            position: static !important;
        }

        .table-container, .material-card {
            box-shadow: none !important;
            border: none !important;
            background: transparent !important;
            padding: 0 !important;
            margin: 0 !important;
            border-radius: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        .table-responsive {
            overflow: visible !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        /* Publication quality Table */
        .custom-table {
            width: 100% !important;
            max-width: 100% !important;
            border-collapse: collapse !important;
            table-layout: fixed !important;
            margin-top: 8px !important;
        }

        .custom-table thead th {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
            border: 1px solid #475569 !important;
            font-weight: 700 !important;
            font-size: 9pt !important;
            padding: 7px 4px !important;
            text-align: center !important;
            -webkit-print-color-adjust: exact !important;
            white-space: normal !important;
            word-break: normal !important;
        }

        .custom-table tbody td {
            border: 1px solid #94a3b8 !important;
            color: #0f172a !important;
            padding: 6px 5px !important;
            font-size: 9pt !important;
            font-weight: 500 !important;
            line-height: 1.35 !important;
            vertical-align: middle !important;
            word-break: normal !important;
            overflow-wrap: break-word !important;
        }

        .custom-table tbody tr {
            page-break-inside: avoid !important;
        }

        .custom-table tbody tr:hover {
            background-color: transparent !important;
        }

        /* Neutralize and clean up badge pills into plain clean text in print */
        .badge,
        .badge-faculty,
        .badge-modern,
        .badge-rollno,
        .badge-year,
        .badge-subcode,
        .badge-marks,
        .badge-sem,
        .badge-totalmarks,
        .badge-cgpa,
        .badge-status-master,
        .badge-status-bachelor,
        .badge-status-disqualified,
        .badge-status-ineligible,
        .badge-status-inprogress {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            border-radius: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
            color: #000000 !important;
            font-size: inherit !important;
            font-weight: inherit !important;
            display: inline !important;
            white-space: nowrap !important;
        }

        .badge-marks,
        .badge-totalmarks,
        .badge-cgpa {
            font-size: 9.5pt !important;
            font-weight: 700 !important;
        }

        .badge-rollno {
            font-size: 9pt !important;
            font-weight: 700 !important;
            font-family: monospace !important;
        }

        .badge-faculty {
            font-weight: 600 !important;
            color: #0f172a !important;
            white-space: normal !important;
        }

        .subject-title {
            display: block !important;
            font-size: 8pt !important;
            color: #1e293b !important;
            padding: 0 !important;
        }

        /* Deterministic Column Widths for Print */
        .custom-table th.col-rank, .custom-table td.col-rank { width: 7% !important; text-align: center !important; white-space: nowrap !important; }
        .custom-table th.col-roll, .custom-table td.col-roll { width: 14% !important; text-align: center !important; white-space: nowrap !important; }
        .custom-table th.col-name, .custom-table td.col-name { width: 22% !important; text-align: left !important; }
        .custom-table th.col-faculty, .custom-table td.col-faculty { width: 23% !important; text-align: left !important; }
        .custom-table th.col-year, .custom-table td.col-year { width: 12% !important; text-align: center !important; white-space: nowrap !important; }
        .custom-table th.col-subject, .custom-table td.col-subject { width: 14% !important; text-align: left !important; }
        .custom-table th.col-marks, .custom-table td.col-marks { width: 8% !important; text-align: center !important; white-space: nowrap !important; }

        .custom-table th.col-sem-name, .custom-table td.col-sem-name { width: 25% !important; text-align: left !important; }
        .custom-table th.col-sem-faculty, .custom-table td.col-sem-faculty { width: 26% !important; text-align: left !important; }
        .custom-table th.col-sem-sem, .custom-table td.col-sem-sem { width: 14% !important; text-align: center !important; white-space: nowrap !important; }
        .custom-table th.col-sem-marks, .custom-table td.col-sem-marks { width: 14% !important; text-align: center !important; white-space: nowrap !important; }

        .custom-table th.col-m-cgpa, .custom-table td.col-m-cgpa { width: 12% !important; text-align: center !important; white-space: nowrap !important; }
        .custom-table th.col-m-status, .custom-table td.col-m-status { width: 16% !important; text-align: center !important; }

        .print-header {
            display: block !important;
            margin-bottom: 12px !important;
        }

        .print-header h3 {
            font-size: 14pt !important;
            font-weight: 800 !important;
            color: #0f172a !important;
            margin-bottom: 3px !important;
        }

        .print-header h5 {
            font-size: 11pt !important;
            font-weight: 700 !important;
            color: #334155 !important;
            margin-bottom: 8px !important;
        }

        .print-meta-box {
            border: 1px solid #94a3b8 !important;
            background-color: #f8fafc !important;
            font-size: 8.5pt !important;
            padding: 6px 10px !important;
            line-height: 1.6 !important;
        }

        .print-footer {
            display: block !important;
            page-break-inside: avoid !important;
            margin-top: 35px !important;
        }

        .print-footer .fw-bold {
            font-size: 9.5pt !important;
            color: #0f172a !important;
        }

        .print-footer small {
            font-size: 8.5pt !important;
            color: #475569 !important;
        }
    }
</style>

<div class="mb-4">
    <!-- ── 1. HEADER & ACTION BUTTONS ──────────────────────────── -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 mt-2 py-1 no-print">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 p-2 shadow-sm d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width: 44px; height: 44px; background: rgba(13, 110, 253, 0.08); border: 1.5px solid rgba(13, 110, 253, 0.25);">
                <i class="bi bi-award fs-5" style="color: #0d6efd;"></i>
            </div>
            <div>
                <h4 class="fw-bolder mb-1" style="letter-spacing: 0.5px; color: #1e293b;">
                    @(LangService.IsMyanmar ? "ကျောင်းသားအဆင့်သတ်မှတ်ချက်နှင့် မဟာဘွဲ့အရည်အချင်းစစ်" : "Student Academic Ranking & Master Degree Eligibility")
                </h4>
                <small class="text-secondary d-block">
                    @(LangService.IsMyanmar ? "ဘာသာရပ်အလိုက်၊ စာသင်နှစ်ဝက်အလိုက် အမှတ်များနှင့် မဟာဘွဲ့ရရှိခွင့် (CGPA ≥ 3.00) စစ်ဆေးခြင်း" : "Subject rankings, semester total score analysis, and Master degree qualification assessment (CGPA ≥ 3.00)")
                </small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn shadow-sm d-flex align-items-center gap-1.5 fw-bold" 
                    style="background-color: #10b981; color: #ffffff !important; border-radius: 8px; height: 38px; border: none; padding: 0 16px; font-size: 0.85rem;" 
                    @onclick="ExportToCsv" title="Export current view to CSV">
                <i class="bi bi-file-earmark-excel me-1"></i>
                <span>@(LangService.IsMyanmar ? "CSV ထုတ်ယူရန်" : "Export CSV")</span>
            </button>
            <button class="btn shadow-sm d-flex align-items-center gap-1.5 fw-bold" 
                    style="background-color: #0d6efd; color: #ffffff !important; border-radius: 8px; height: 38px; border: none; padding: 0 16px; font-size: 0.85rem;" 
                    @onclick="PrintReport" title="Print Academic Report">
                <i class="bi bi-printer-fill me-1"></i>
                <span>@(LangService.IsMyanmar ? "စာရင်းထုတ်ရန်" : "Print")</span>
            </button>
        </div>
    </div>

    <!-- ── 2. TAB NAVIGATION BAR ──────────────────────────────── -->
    <div class="ranking-tabs-bar no-print">
        <button class="ranking-tab @(ActiveTab == "subject" ? "active" : "")" @onclick='() => SwitchTab("subject")'>
            <i class="bi bi-journal-bookmark-fill"></i>
            <span>@(LangService.IsMyanmar ? "၁။ ဘာသာရပ်အလိုက် အဆင့်" : "1. Subject-wise Ranking")</span>
        </button>
        <button class="ranking-tab @(ActiveTab == "semester" ? "active" : "")" @onclick='() => SwitchTab("semester")'>
            <i class="bi bi-bar-chart-steps"></i>
            <span>@(LangService.IsMyanmar ? "၂။ နှစ်ဝက်အလိုက် စုစုပေါင်းအမှတ် အဆင့်" : "2. Semester Total Score Ranking")</span>
        </button>
