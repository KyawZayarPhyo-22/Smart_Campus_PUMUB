                <div class="col-4">
                    <strong>@(LangService.IsMyanmar ? "ပညာသင်နှစ်" : "Academic Year"):</strong> @(SelectedAcademicYear == "All" ? (LangService.IsMyanmar ? "အားလုံး" : "All") : SelectedAcademicYear)
                </div>
