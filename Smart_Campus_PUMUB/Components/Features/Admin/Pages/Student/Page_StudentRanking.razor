                    </div>
                }
                else if (ActiveTab == "semester")
                {
                    <div class="col-4">
                        <strong>@(LangService.IsMyanmar ? "စာသင်နှစ်ဝက်" : "Semester"):</strong> @(SelectedSemester == "All" ? (LangService.IsMyanmar ? "အားလုံး" : "All") : SelectedSemester)
                    </div>
                    <div class="col-4">
                        <strong>@(LangService.IsMyanmar ? "မေဂျာ" : "Major"):</strong> @(SelectedMajor == "All" ? (LangService.IsMyanmar ? "အားလုံး" : "All") : SelectedMajor)
                    </div>
                    <div class="col-4 text-end">
                        <strong>@(LangService.IsMyanmar ? "စုစုပေါင်း ကျောင်းသား" : "Total Students"):</strong> @TotalCount
                    </div>
