@page "/admin/student-databank/view/{UserId:int}"
@page "/admin/student-databank/view/{UserId:int}/{NewStudentAccId:int}"
@layout AdminLayout
@rendermode InteractiveServer
@using Smart_Campus_PUMUB.Components.Features.Student

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0" style="color: #3f4254; font-weight: 600;">
            <i class="bi bi-file-person me-2" style="color: #696cff;"></i>
            View Student Personal Info
        </h2>
        <a href="/admin/student-databank" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <!-- Nav Tabs -->
    <ul class="nav nav-tabs mb-4" id="studentViewTabs" role="tablist" style="border-bottom: 2px solid #e9ecef;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="personal-info-tab" data-bs-toggle="tab" data-bs-target="#personal-info" type="button" role="tab" aria-controls="personal-info" aria-selected="true" style="color: #696cff; font-weight: 600;">
                <i class="bi bi-person-lines-fill me-1"></i> Personal Info
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="enrollment-result-tab" data-bs-toggle="tab" data-bs-target="#enrollment-result" type="button" role="tab" aria-controls="enrollment-result" aria-selected="false" style="color: #495057; font-weight: 500;">
                <i class="bi bi-journal-check me-1"></i> Enrollment Result
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="studentViewTabsContent">
        <!-- Personal Info Tab -->
        <div class="tab-pane fade show active" id="personal-info" role="tabpanel" aria-labelledby="personal-info-tab">
            <div class="material-card" style="background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); border: 1px solid rgba(0, 0, 0, 0.05); padding: 1rem;">
                <Page_StudentPersonalInfo AdminViewUserId="@UserId" AdminViewNewStudentAccId="@NewStudentAccId" />
            </div>
        </div>

        <!-- Enrollment Result Tab -->
        <div class="tab-pane fade" id="enrollment-result" role="tabpanel" aria-labelledby="enrollment-result-tab">
            <div class="material-card" style="background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); border: 1px solid rgba(0, 0, 0, 0.05); padding: 1rem;">
                <Page_StudentEnrollmentResult StudentId="@UserId" />
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        border: none;
        border-bottom: 2px solid transparent;
        padding: 0.75rem 1.25rem;
        transition: all 0.2s ease-in-out;
    }
    
    .nav-tabs .nav-link:hover {
        border-color: transparent;
        color: #696cff !important;
        background-color: rgba(105, 108, 255, 0.05);
        border-radius: 8px 8px 0 0;
    }
    
    .nav-tabs .nav-link.active {
        background-color: transparent;
        border-color: transparent;
        border-bottom: 2px solid #696cff;
    }
</style>

@code {
    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public int NewStudentAccId { get; set; }
}
