                                                        <thead style="background: linear-gradient(135deg, #5A4FCF 0%, #4338ca 100%);">
                                                            <tr>
                                                                <th style="width: 28px; text-align: center; color: #ffffff !important; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; padding: 7px 3px;">@(LangService.IsMyanmar ? "စဉ်" : "No.")</th>
                                                                <th style="color: #ffffff !important; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; padding: 7px 4px;">@(LangService.IsMyanmar ? "ဘာသာရပ်အမည်" : "Subject Name")</th>
                                                                <th style="width: 72px; text-align: center; color: #ffffff !important; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; padding: 7px 3px;">@(LangService.IsMyanmar ? "ကုဒ်" : "Code")</th>
                                                                <th style="width: 52px; text-align: center; color: #ffffff !important; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; padding: 7px 3px;">Credit</th>
                                                                <th style="width: 60px; text-align: center; color: #ffffff !important; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; padding: 7px 3px;">@(LangService.IsMyanmar ? "အမျိုးအစား" : "Type")</th>
