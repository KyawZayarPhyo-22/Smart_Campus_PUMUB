                                                    @(LangService.IsMyanmar ? $"{sem.UnselectedCount} ဘာသာ ({sem.TotalUnselectedCredits} Credits)" : $"{sem.UnselectedCount} Subjects ({sem.TotalUnselectedCredits} Credits)")
                                                    @if (sem.PendingRequiredCount > 0)
                                                    {
                                                        <span class="badge bg-danger text-white ms-1" style="font-size: 0.72rem; padding: 2px 6px;">@(LangService.IsMyanmar ? $"{sem.PendingRequiredCount} ယူရန်ကျန်" : $"{sem.PendingRequiredCount} Pending")</span>
                                                    }
                                                </span>
                                            </div>

                                            @if (sem.UnselectedSubjects.Any())
                                            {
                                                <div class="table-responsive" style="border-radius: 8px; overflow-x: auto; border: 1px solid #e2e8f0;">
