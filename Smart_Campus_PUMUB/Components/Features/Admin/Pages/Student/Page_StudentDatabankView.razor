@page "/admin/student-databank/view/{UserId:int}"
@page "/admin/student-databank/view/{UserId:int}/{NewStudentAccId:int}"
@layout AdminLayout
@rendermode InteractiveServer
@implements IDisposable
@using Smart_Campus_PUMUB.Components.Features.Student
@using Smart_Campus_PUMUB.BlazorServer.Frontend.Services
@using Smart_Campus_PUMUB.Components.Features.Services
@using Smart_Campus_PUMUB.WebApi.Models
@inject HttpClientService HttpClientService
@inject AdminLanguageService LangService
@inject IJSRuntime JS

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 no-print">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <h2 class="page-title m-0" style="color: #3f4254; font-weight: 700; font-size: 1.5rem;">
                <i class="bi bi-file-person me-2" style="color: #5A4FCF;"></i>
                @(LangService.IsMyanmar ? "ကျောင်းသား ကိုယ်ရေးနှင့် ပညာရေးမှတ်တမ်း" : "Student Profile & Academic Records")
            </h2>
            @if (graduationStatus?.HasDisqualifiedSubject == true || string.Equals(graduationStatus?.GraduationStatus, "Disqualified", StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border: 1px solid #f87171; font-size: 0.84rem; font-weight: 700; padding: 6px 14px; border-radius: 999px; box-shadow: 0 2px 8px rgba(239,68,68,0.35);">
                    <i class="bi bi-slash-circle-fill me-1"></i> @(LangService.IsMyanmar ? "⛔ ဘွဲ့ရယူခွင့်မရှိပါ" : "⛔ Ineligible")
                </span>
            }
            else if (graduationStatus?.IsGraduated == true)
            {
                <span class="badge" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: 1px solid #34d399; font-size: 0.84rem; font-weight: 700; padding: 6px 14px; border-radius: 999px; box-shadow: 0 2px 8px rgba(16,185,129,0.35);">
                    <i class="bi bi-mortarboard-fill me-1"></i> @(LangService.IsMyanmar ? $"🎓 ဘွဲ့ရပြီး ({ToMyanmarDigits(graduationStatus.TotalEarnedCredits)}/{ToMyanmarDigits(graduationStatus.TargetGraduationCredits)} Credits)" : $"🎓 Graduated ({graduationStatus.TotalEarnedCredits}/{graduationStatus.TargetGraduationCredits} Credits)")
                </span>
            }
            else if (graduationStatus != null)
            {
                <span class="badge" style="background: rgba(90, 79, 207, 0.12); color: #5A4FCF; border: 1px solid rgba(90, 79, 207, 0.3); font-size: 0.82rem; font-weight: 700; padding: 6px 12px; border-radius: 999px;">
                    <i class="bi bi-award me-1"></i> @(LangService.IsMyanmar ? $"ရရှိပြီး Credits: {ToMyanmarDigits(graduationStatus.TotalEarnedCredits)} / {ToMyanmarDigits(graduationStatus.TargetGraduationCredits)}" : $"Credits: {graduationStatus.TotalEarnedCredits} / {graduationStatus.TargetGraduationCredits}")
                </span>
            }
            @if (retakeStatus != null)
            {
                <span class="badge" style="background: @(retakeStatus.DangerLevel == "Safe" ? "rgba(16, 185, 129, 0.12)" : retakeStatus.DangerLevel == "Warning" ? "rgba(245, 158, 11, 0.12)" : retakeStatus.DangerLevel == "HighDanger" ? "rgba(249, 115, 22, 0.12)" : "rgba(239, 68, 68, 0.12)"); color: @retakeStatus.BadgeColor; border: 1px solid @retakeStatus.BadgeColor; font-size: 0.82rem; font-weight: 700; padding: 6px 14px; border-radius: 999px;">
                    <i class="bi @(retakeStatus.DangerLevel == "Safe" ? "bi-shield-check" : retakeStatus.DangerLevel == "Warning" ? "bi-exclamation-triangle" : retakeStatus.DangerLevel == "HighDanger" ? "bi-fire" : "bi-slash-circle") me-1"></i>
                    @(LangService.IsMyanmar
                        ? $"Retake: {retakeStatus.TotalRetakesTaken} / {retakeStatus.MaxRetakeLimit} ({(retakeStatus.DangerLevel == "Safe" ? "ပုံမှန်" : retakeStatus.DangerLevel == "Warning" ? "သတိပြုရန်" : retakeStatus.DangerLevel == "HighDanger" ? "အန္တရာယ်ရှိ" : "ဘွဲ့မရနိုင်")})"
                        : $"Retake: {retakeStatus.TotalRetakesTaken} / {retakeStatus.MaxRetakeLimit} ({retakeStatus.DangerLevel})")
                </span>
            }
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (currentTab == "academic-gradesheet")
            {
                <button class="btn shadow-sm d-flex align-items-center gap-2 fw-bold" style="background-color: #0d6efd; color: #ffffff !important; border-radius: 8px; height: 38px; border: none; padding: 0 16px;" @onclick="PrintReport">
                    <i class="bi bi-printer-fill me-1"></i> @(LangService.IsMyanmar ? "ပရင့်ထုတ်မည်" : "Print")
                </button>
            }
            <a href="/admin/student-databank" class="btn btn-outline-secondary d-flex align-items-center gap-1.5 shadow-sm" style="border-radius: 8px; height: 38px;">
                <i class="bi bi-arrow-left"></i> @(LangService.IsMyanmar ? "ရှေ့သို့" : "Back")
            </a>
        </div>
    </div>

    <!-- Nav Tabs (Personal Info, Academic Grade Sheet, Subject Selections & Retake Status) -->
    <ul class="nav nav-tabs mb-4 no-print" id="studentViewTabs" role="tablist" style="border-bottom: 2px solid #e9ecef;">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(currentTab == "personal-info" ? "active" : "")" type="button" @onclick='() => currentTab = "personal-info"'>
                <i class="bi bi-person-lines-fill me-1"></i> @(LangService.IsMyanmar ? "ကိုယ်ရေးအချက်အလက်" : "Personal Info")
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(currentTab == "academic-gradesheet" ? "active" : "")" type="button" @onclick='() => currentTab = "academic-gradesheet"'>
                <i class="bi bi-file-earmark-spreadsheet-fill me-1" style="color: #5A4FCF;"></i> @(LangService.IsMyanmar ? "အမှတ်စာရင်းနှင့် GPA" : "Academic Grade Sheet & GPA")
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(currentTab == "subject-selections" ? "active" : "")" type="button" @onclick='() => currentTab = "subject-selections"'>
                <i class="bi bi-journal-check me-1"></i> @(LangService.IsMyanmar ? "ရွေးချယ်ထားသော ဘာသာရပ်များ" : "Subject Selections")
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(currentTab == "retake-status" ? "active" : "")" type="button" @onclick='() => currentTab = "retake-status"'>
                <i class="bi bi-arrow-repeat me-1"></i> @(LangService.IsMyanmar ? "Retake နှင့် ဘွဲ့ရရှိမှု အခြေအနေ" : "Retake & Graduation Standing")
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="studentViewTabsContent">
        <!-- Personal Info Tab -->
        <div class="tab-pane fade @(currentTab == "personal-info" ? "show active" : "")" id="personal-info" role="tabpanel" aria-labelledby="personal-info-tab">
            <div class="material-card" style="background-color: #ffffff; border-radius: 14px; box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04); border: 1px solid #e2e8f0; padding: 1.5rem;">
                <Page_StudentPersonalInfo AdminViewUserId="@UserId" AdminViewNewStudentAccId="@NewStudentAccId" />
            </div>
        </div>

        <!-- Academic Grade Sheet & GPA Tab -->
        <div class="tab-pane fade @(currentTab == "academic-gradesheet" ? "show active" : "")" id="academic-gradesheet" role="tabpanel" aria-labelledby="academic-gradesheet-tab">
            <div class="material-card table-container printable-area mb-5 grade-sheet-card">
                @if (isLoadingGraduation)
                {
                    <div class="text-center py-5 no-print">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">@(LangService.IsMyanmar ? "အမှတ်စာရင်းများ ရယူနေပါသည်..." : "Loading Academic Grade Sheets...")</p>
                    </div>
                }
                else if (graduationStatus?.SemesterGpaList != null && graduationStatus.SemesterGpaList.Any())
                {
                    <!-- Controls Bar (No Print) -->
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 no-print">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 44px; height: 44px; background: rgba(90, 79, 207, 0.08); border: 1.5px solid rgba(90, 79, 207, 0.25);">
                                <i class="bi bi-file-earmark-spreadsheet fs-5" style="color: #5A4FCF !important;"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-0.5" style="line-height: 1.3;">
                                    @(LangService.IsMyanmar ? "စာမေးပွဲရလဒ်နှင့် GPA အမှတ်စာရင်းများ" : "Academic Grade Sheets & GPA Records")
                                </h4>
                                <p class="text-muted mb-0" style="font-size: 0.88rem;">
                                    @(LangService.IsMyanmar ? "Semester အလိုက် ဘာသာရပ်ရလဒ်များနှင့် GPA မှတ်တမ်းများ" : "Semester-wise subject results and Grade Point Average (GPA) records")
                                </p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-nowrap">
                            <select class="form-select form-select-sm shadow-none fw-bold text-dark" style="width: 230px; height: 38px; border-radius: 8px; border: 1.5px solid #5A4FCF; background-color: #ffffff; padding-right: 32px;" @bind="selectedSemesterDropdownValue">
                                <option value="0">@(LangService.IsMyanmar ? "Semester အားလုံး" : "All Semesters")</option>
                                @foreach (var sem in graduationStatus.SemesterGpaList)
                                {
                                    <option value="@sem.SemesterId">@sem.SemesterName</option>
                                }
                            </select>
                            <button class="btn shadow-sm d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="background-color: #0d6efd; color: #ffffff !important; border-radius: 8px; height: 38px; width: 42px; border: none;" type="button" @onclick="ApplySemesterFilter" title="@(LangService.IsMyanmar ? "ရှာမည်" : "Filter")">
                                <i class="bi bi-search"></i>
                            </button>
                            @if (appliedSemesterFilterId != 0)
                            {
                                <button class="btn btn-secondary shadow-sm d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="border-radius: 8px; color: #ffffff !important; height: 38px; width: 42px;" type="button" @onclick="ResetSemesterFilter" title="@(LangService.IsMyanmar ? "မူလအတိုင်း" : "Reset")">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            }
                            <button class="btn shadow-sm d-flex align-items-center gap-2 fw-bold flex-shrink-0 text-nowrap" style="background-color: #0d6efd; color: #ffffff !important; border-radius: 8px; height: 38px; border: none; padding: 0 16px;" @onclick="PrintReport">
                                <i class="bi bi-printer-fill me-1"></i> @(LangService.IsMyanmar ? "ပရင့်ထုတ်မည်" : "Print Report")
                            </button>
                        </div>
                    </div>

                    <!-- Official University Print Header (Visible Only In Print) -->
                    <div class="print-header d-none d-print-block text-center mb-4">
                        <h3 class="fw-bold mb-1 text-dark" style="font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.5px;">Polytechnic University (Maubin)</h3>
                        <h5 class="fw-bold mb-3 text-secondary" style="font-size: 1.05rem;">OFFICIAL ACADEMIC GRADE REPORT / GPA RECORD</h5>
                        <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-dark" style="font-size: 0.9rem; border-bottom: 2px solid #000000; padding-bottom: 8px;">
                            <div><strong>Student Name:</strong> @(!string.IsNullOrEmpty(graduationStatus.StudentName) ? graduationStatus.StudentName : "-")</div>
                            <div><strong>Roll No:</strong> @(!string.IsNullOrEmpty(graduationStatus.RollNo) ? graduationStatus.RollNo : "-")</div>
                            <div><strong>Major:</strong> @(!string.IsNullOrEmpty(graduationStatus.MajorName) ? graduationStatus.MajorName : "-")</div>
                            <div><strong>Date:</strong> @DateTime.Now.ToString("dd-MM-yyyy")</div>
                        </div>
                    </div>

                    <!-- Semester Result Tables -->
                    var displayedSemesters = appliedSemesterFilterId == 0 
                        ? graduationStatus.SemesterGpaList 
                        : graduationStatus.SemesterGpaList.Where(s => s.SemesterId == appliedSemesterFilterId).ToList();

                    @foreach (var sem in displayedSemesters)
                    {
                        <div class="grade-sheet-container mb-4 p-4">
                            <!-- Document Header -->
                            <div class="mb-3">
                                <h5 class="fw-bold text-dark mb-1" style="font-size: 1.05rem; line-height: 1.6;">
                                    @if (LangService.IsMyanmar)
                                    {
                                        <span>ကျောင်းသား @(!string.IsNullOrEmpty(graduationStatus.StudentName) ? graduationStatus.StudentName : "") (@(!string.IsNullOrEmpty(graduationStatus.RollNo) ? graduationStatus.RollNo : "")) ၏ @sem.SemesterName ရလဒ်နှင့် GPA မှတ်တမ်း</span>
                                    }
                                    else
                                    {
                                        <span>Grade Point Average (GPA) Report for @(!string.IsNullOrEmpty(graduationStatus.StudentName) ? graduationStatus.StudentName : "") (@(!string.IsNullOrEmpty(graduationStatus.RollNo) ? graduationStatus.RollNo : "")) - @sem.SemesterName</span>
                                    }
                                </h5>
                                @if (!string.IsNullOrEmpty(graduationStatus.MajorName))
                                {
                                    <div class="fw-bold mt-1.5 text-dark no-print">
                                        <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-bold shadow-sm" style="font-size: 0.88rem; border-color: #94a3b8 !important; color: #0f172a !important; border-radius: 4px;">
                                            <i class="bi bi-mortarboard me-1" style="color: #5A4FCF;"></i> @(LangService.IsMyanmar ? "မေဂျာ" : "Major"): @graduationStatus.MajorName
                                        </span>
                                    </div>
                                }
                            </div>

                            <!-- Table -->
                            <div class="table-responsive" style="border-radius: 0 !important; overflow-x: auto;">
                                <table class="table mb-0 text-dark grade-sheet-table" style="border: 2px solid #000000; border-collapse: collapse; table-layout: fixed; width: 100%; border-radius: 0 !important;">
                                    <colgroup>
                                        <col style="width: 5%;" />
                                        <col style="width: 12%;" />
                                        <col style="width: 33%;" />
                                        <col style="width: 9%;" />
                                        <col style="width: 12%;" />
                                        <col style="width: 9%;" />
                                        <col style="width: 9%;" />
                                        <col style="width: 11%;" />
                                    </colgroup>
                                    <thead>
                                        <tr class="align-middle" style="background-color: #5054ea; color: #ffffff; font-weight: 700; font-size: 0.78rem; line-height: 1.25; border: 2px solid #000000; border-radius: 0 !important;">
                                            <th style="padding: 9px 4px; text-align: center; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">@(LangService.IsMyanmar ? "စဉ်" : "NO.")</th>
                                            <th style="padding: 9px 6px; text-align: center; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">@(LangService.IsMyanmar ? "ဘာသာရပ်ကုဒ်" : "SUBJECT CODE")</th>
                                            <th style="padding: 9px 10px; text-align: left; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">@(LangService.IsMyanmar ? "ဘာသာရပ်များ" : "SUBJECTS")</th>
                                            <th style="padding: 9px 4px; text-align: center; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">@(LangService.IsMyanmar ? "CREDIT" : "CREDIT UNIT")</th>
                                            <th style="padding: 9px 4px; text-align: center; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">@(LangService.IsMyanmar ? "ရမှတ်" : "TOTAL MARKS")</th>
                                            <th style="padding: 9px 4px; text-align: center; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">GRADE</th>
                                            <th style="padding: 9px 4px; text-align: center; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">GRADE SCORE</th>
                                            <th style="padding: 9px 4px; text-align: center; border: 1.5px solid #000000 !important;  background-color: #5054ea; color: #ffffff; vertical-align: middle; font-weight: 700; border-radius: 0 !important;">GRADE POINT</th>
                                        </tr>
                                    </thead>
                                    <tbody style="font-size: 0.84rem; line-height: 1.3; color: #000000; font-weight: 700; border-radius: 0 !important;">
                                        @{ int subIndex = 1; }
                                        @if (sem.SubjectResults != null && sem.SubjectResults.Any())
                                        {
                                            @foreach (var sub in sem.SubjectResults)
                                            {
                                                <tr style="border-bottom: 1.5px solid #000000;">
                                                    <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">@subIndex.</td>
                                                    <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">@sub.SubjectCode</td>
                                                    <td class="fw-bold" style="border: 1.5px solid #000000; padding: 7px 10px; text-align: left; vertical-align: middle; overflow-wrap: break-word;">
                                                        <div class="fw-bold">@sub.SubjectName</div>
                                                        @if (!string.IsNullOrEmpty(sub.ReexamGrade))
                                                        {
                                                            <small class="text-muted d-block fw-bold" style="font-size: 0.76rem;">(Re-exam: @sub.ReexamGrade)</small>
                                                        }
                                                    </td>
                                                    <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">@sub.CreditUnit</td>
                                                    <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                        @(sub.MarksObtained.HasValue ? sub.MarksObtained.Value.ToString("0.##") : "-")
                                                    </td>
                                                    <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                        @(!string.IsNullOrEmpty(sub.Grade) ? sub.Grade : "-")
                                                    </td>
                                                    <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                        @(sub.GradeScore > 0 ? (sub.GradeScore == (int)sub.GradeScore ? sub.GradeScore.ToString("0") : sub.GradeScore.ToString("0.##")) : (sub.Grade == "F" ? "0" : "-"))
                                                    </td>
                                                    <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                        @sub.GradePointEarned.ToString("F2")
                                                    </td>
                                                </tr>
                                                subIndex++;
                                            }
                                        }
                                        <!-- Summary rows -->
                                        <tr style="font-weight: 700; border-bottom: 1.5px solid #000000;">
                                            <td colspan="3" class="fw-bold" style="border: 1.5px solid #000000; padding: 7px 10px; text-align: left; vertical-align: middle;">
                                                @(LangService.IsMyanmar ? "စုစုပေါင်း Credit" : "Total Credit Unit")
                                            </td>
                                            <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                @sem.TotalCredits
                                            </td>
                                            <td colspan="3" class="fw-bold" style="border: 1.5px solid #000000; padding: 7px 10px; text-align: left; vertical-align: middle;">
                                                @(LangService.IsMyanmar ? "စုစုပေါင်း Grade Point" : "Total Grade Point")
                                            </td>
                                            <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                @sem.TotalGradePointsEarned.ToString("F2")
                                            </td>
                                        </tr>
                                        <tr style="font-weight: 700; border-bottom: 1.5px solid #000000;">
                                            <td colspan="7" class="fw-bold" style="border: 1.5px solid #000000; padding: 7px 10px; text-align: left; vertical-align: middle;">
                                                @(LangService.IsMyanmar ? "Semester GPA" : "Cumulative GPA for each semester")
                                            </td>
                                            <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                @sem.SemesterGPA.ToString("F2")
                                            </td>
                                        </tr>
                                        <tr style="font-weight: 700; border-bottom: 2px solid #000000;">
                                            <td colspan="7" class="fw-bold" style="border: 1.5px solid #000000; padding: 7px 10px; text-align: left; vertical-align: middle;">
                                                @(LangService.IsMyanmar ? "စုစုပေါင်း Overall GPA" : "Overall GPA")
                                            </td>
                                            <td class="text-center fw-bold" style="border: 1.5px solid #000000; padding: 7px 6px; vertical-align: middle;">
                                                @(sem.CumulativeGPAUpToThisSemester > 0 ? sem.CumulativeGPAUpToThisSemester.ToString("F2") : sem.SemesterGPA.ToString("F2"))
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- Official Verification / Signatures Footer (Visible Only In Print) -->
                    <div class="d-none d-print-flex justify-content-between align-items-end mt-5 pt-4 px-3 text-dark" style="font-size: 0.85rem;">
                        <div class="text-center" style="min-width: 180px; border-top: 1.5px solid #000000; padding-top: 6px;">
                            <strong>Prepared By</strong>
                        </div>
                        <div class="text-center" style="min-width: 180px; border-top: 1.5px solid #000000; padding-top: 6px;">
                            <strong>Checked By (Registrar)</strong>
                        </div>
                        <div class="text-center" style="min-width: 180px; border-top: 1.5px solid #000000; padding-top: 6px;">
                            <strong>Head of Department / Dean</strong>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted no-print">
                        <i class="bi bi-file-earmark-x fs-2 d-block mb-2 text-secondary"></i>
                        @(LangService.IsMyanmar ? "ကျောင်းသား၏ စာမေးပွဲရလဒ်မှတ်တမ်း မရှိသေးပါ။" : "No examination records found for this student.")
                    </div>
                }
            </div>
        </div>

        <!-- Retake Status Tab -->
        <div class="tab-pane fade @(currentTab == "retake-status" ? "show active" : "")" id="retake-status" role="tabpanel" aria-labelledby="retake-status-tab">

            <div class="material-card" style="background-color: #ffffff; border-radius: 14px; box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04); border: 1px solid #e2e8f0; padding: 1.8rem;">
                @if (isLoadingRetake || isLoadingGraduation)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">@(LangService.IsMyanmar ? "ပညာရေးမှတ်တမ်း အချက်အလက်များ ရယူနေပါသည်..." : "Loading Academic Standing details...")</p>
                    </div>
                }
                else
                {
                    <!-- Graduation & Degree Completion Card -->
                    @if (graduationStatus != null)
                    {
                        <div class="p-4 rounded-4 mb-4" style="background: @(graduationStatus.HasDisqualifiedSubject ? "rgba(239, 68, 68, 0.04)" : "linear-gradient(135deg, rgba(90, 79, 207, 0.04) 0%, rgba(16, 185, 129, 0.04) 100%)"); border: 1.5px solid @(graduationStatus.HasDisqualifiedSubject ? "#ef4444" : (graduationStatus.IsGraduated ? "#10b981" : "#cbd5e1"));">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 44px; height: 44px; background: @(graduationStatus.HasDisqualifiedSubject ? "rgba(239, 68, 68, 0.1)" : "rgba(90, 79, 207, 0.08)"); border: 1.5px solid @(graduationStatus.HasDisqualifiedSubject ? "rgba(239, 68, 68, 0.3)" : "rgba(90, 79, 207, 0.25)");">
                                        <i class="bi @(graduationStatus.HasDisqualifiedSubject ? "bi-exclamation-octagon-fill text-danger" : "bi-mortarboard-fill") fs-5" style="color: @(graduationStatus.HasDisqualifiedSubject ? "#ef4444" : (graduationStatus.IsGraduated ? "#10b981" : "#5A4FCF"));"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0.5" style="line-height: 1.3;">
                                            @(LangService.IsMyanmar ? "ဘွဲ့ရရှိမှု အရည်အချင်းစစ် စောင့်ကြည့်ချက်" : "Graduation & Degree Completion Policy")
                                        </h5>
                                        <p class="@(graduationStatus.HasDisqualifiedSubject ? "text-danger fw-bold" : "text-muted") mb-0" style="font-size: 0.86rem;">
                                            @if (graduationStatus.HasDisqualifiedSubject)
                                            {
                                                <span>@(LangService.IsMyanmar ? "Re-exam ၂ ကြိမ် ကျရှုံးခဲ့သဖြင့် ဘွဲ့ရယူခွင့် မရှိတော့ပါ" : "Disqualified from graduation after failing 2 re-exam attempts")</span>
                                            }
                                            else
                                            {
                                                <span>@(LangService.IsMyanmar ? $"Sem ၁ မှ ၇ ({ToMyanmarDigits(graduationStatus.TargetSem1To7Credits)} Credits) + Sem ၈ Internship ({ToMyanmarDigits(graduationStatus.TargetSem8Credits)} Credits) = စုစုပေါင်း {ToMyanmarDigits(graduationStatus.TargetGraduationCredits)} Credits" : $"Semester 1 to 7 ({graduationStatus.TargetSem1To7Credits} Credits) + Semester 8 Internship ({graduationStatus.TargetSem8Credits} Credits) = Total {graduationStatus.TargetGraduationCredits} Credits")</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                                <span class="badge px-3 py-2 fs-6 fw-bold" style="padding-bottom: 10px !important; background: @(graduationStatus.HasDisqualifiedSubject ? "#fef2f2" : (graduationStatus.IsGraduated ? "linear-gradient(135deg, #10b981, #059669)" : "#f1f5f9")); color: @(graduationStatus.HasDisqualifiedSubject ? "#dc2626" : (graduationStatus.IsGraduated ? "#ffffff !important" : "#475569")); border: 1px solid @(graduationStatus.HasDisqualifiedSubject ? "#fca5a5" : (graduationStatus.IsGraduated ? "#34d399" : "#cbd5e1")); border-radius: 999px; box-shadow: @(graduationStatus.IsGraduated ? "0 2px 8px rgba(16,185,129,0.3)" : "none");">
                                    @if (graduationStatus.HasDisqualifiedSubject)
                                    {
                                        @(LangService.IsMyanmar ? "⛔ ဘွဲ့ရယူခွင့်မရှိပါ" : "⛔ Ineligible")
                                    }
                                    else if (graduationStatus.IsGraduated)
                                    {
                                        @(LangService.IsMyanmar ? "🎓 ဘွဲ့ရရှိပြီး" : "🎓 Graduated")
                                    }
                                    else
                                    {
                                        @(LangService.IsMyanmar ? "📘 ပညာသင်ယူဆဲ" : "📘 Studying")
                                    }
                                </span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-3 col-sm-6">
                                    <div class="p-3 rounded-3 bg-white border">
                                        <div class="fs-4 fw-bolder text-dark">@graduationStatus.TotalEarnedCredits <small class="fs-6 text-muted font-monospace">/ @graduationStatus.TargetGraduationCredits</small></div>
                                        <div class="text-secondary small fw-bold mt-1"><i class="bi bi-award-fill text-success me-1"></i> @(LangService.IsMyanmar ? "စုစုပေါင်း ရရှိပြီး Credits" : "Total Earned Credits")</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="p-3 rounded-3 bg-white border">
                                        <div class="fs-4 fw-bolder text-dark">@graduationStatus.Sem1To7Credits <small class="fs-6 text-muted font-monospace">/ @graduationStatus.TargetSem1To7Credits</small></div>
                                        <div class="text-secondary small fw-bold mt-1"><i class="bi bi-journal-check text-primary me-1"></i> @(LangService.IsMyanmar ? "Sem ၁~၇ Credits" : "Sem 1~7 Credits")</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="p-3 rounded-3 bg-white border">
                                        <div class="fs-4 fw-bolder text-dark">@graduationStatus.Sem8Credits <small class="fs-6 text-muted font-monospace">/ @graduationStatus.TargetSem8Credits</small></div>
                                        <div class="text-secondary small fw-bold mt-1"><i class="bi bi-briefcase-fill text-warning me-1"></i> @(LangService.IsMyanmar ? "Sem ၈ Internship" : "Sem 8 Internship")</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="p-3 rounded-3 bg-white border">
                                        <div class="fs-5 fw-bolder" style="color: @(graduationStatus.PendingFailedSubjects == 0 ? "#10b981" : "#ef4444");">
                                            @if (graduationStatus.PendingFailedSubjects == 0)
                                            {
                                                @(LangService.IsMyanmar ? "0 (အားလုံးအောင်မြင်)" : "0 (All Cleared)")
                                            }
                                            else
                                            {
                                                @(LangService.IsMyanmar ? $"{graduationStatus.PendingFailedSubjects} ကျန်" : $"{graduationStatus.PendingFailedSubjects} Remaining")
                                            }
                                        </div>
                                        <div class="text-secondary small fw-bold mt-1"><i class="bi bi-check-circle-fill text-info me-1"></i> @(LangService.IsMyanmar ? "ကျန်ရှိသော Retake ဘာသာ" : "Pending Retake Subjects")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Graduation Credit Progress Bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span class="text-dark">@(LangService.IsMyanmar ? "ဘွဲ့ရရှိမှု အခြေအနေ" : "Degree Completion Progress")</span>
                                    <span class="text-primary">@graduationStatus.ProgressPercentage% (@graduationStatus.TotalEarnedCredits / @graduationStatus.TargetGraduationCredits Credits)</span>
                                </div>
                                <div style="height: 12px; background: #e2e8f0; border-radius: 999px; overflow: hidden;">
                                    <div style="height: 100%; width: @Math.Min(100, Math.Max(2, graduationStatus.ProgressPercentage))%; background: linear-gradient(90deg, #5A4FCF 0%, #3b82f6 50%, #10b981 100%); transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);"></div>
                                </div>
                            </div>

                            <!-- Academic Performance & Semester-wise GPA Breakdown for Admin -->
                            <div class="pt-4 mt-2 border-top" style="border-color: #e2e8f0 !important;">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3 pb-1">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 40px; height: 40px; background: rgba(90, 79, 207, 0.08); border: 1.5px solid rgba(90, 79, 207, 0.25);">
                                            <i class="bi bi-graph-up-arrow fs-5" style="color: #5A4FCF;"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6" style="line-height: 1.3;">
                                                @(LangService.IsMyanmar ? "ပညာရေးစွမ်းဆောင်ရည်နှင့် Cumulative GPA (CGPA)" : "Academic Performance & Cumulative GPA (CGPA)")
                                            </div>
                                            <div class="text-muted small mt-0.5">
                                                @(LangService.IsMyanmar ? "Semester အလိုက် GPA များနှင့် စုစုပေါင်း GPA အမှတ်ပျမ်းမျှ" : "Semester GPA breakdown and overall Cumulative GPA")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge px-3.5 py-2 fs-6 fw-bold shadow-sm" style="background: #ecfdf5; color: #059669; border: 1.5px solid #6ee7b7; border-radius: 999px;">
                                            <i class="bi bi-mortarboard-fill me-1"></i> Cumulative GPA: @graduationStatus.CumulativeGPA.ToString("F2") / 4.00
                                        </span>
                                        @if (!string.IsNullOrEmpty(graduationStatus.OverallAcademicStanding))
                                        {
                                            <span class="badge px-3.5 py-2 fs-6 fw-bold shadow-sm" style="background: #5A4FCF; color: #ffffff !important; border-radius: 999px;">
                                                @graduationStatus.OverallAcademicStanding
                                            </span>
                                        }
                                    </div>
                                </div>

                                @if (graduationStatus.SemesterGpaList != null && graduationStatus.SemesterGpaList.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var sem in graduationStatus.SemesterGpaList)
                                        {
                                            <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                                                <div class="p-3 rounded-3 border bg-white shadow-sm" style="border: 1.5px solid #e2e8f0; border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s;">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="fw-bold text-dark" style="font-size: 0.9rem;">@sem.SemesterName</span>
                                                        <span class="badge px-2.5 py-1 fw-bold" style="background: #f1f5f9; color: #4338ca; border: 1px solid #cbd5e1; font-size: 0.74rem; border-radius: 6px;">@sem.TotalCredits Credits</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-baseline mt-1">
                                                        <div class="fw-bolder fs-4" style="color: #4f46e5; line-height: 1;">@sem.SemesterGPA.ToString("F2")</div>
                                                        <span class="badge px-2.5 py-1 fw-bold" style="background: @(sem.SemesterGPA >= 3.5m ? "#10b981" : sem.SemesterGPA >= 2.0m ? "#4f46e5" : "#64748b"); color: #ffffff !important; font-size: 0.72rem; border-radius: 6px;">@sem.Status</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (retakeStatus != null)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 44px; height: 44px; background: rgba(245, 158, 11, 0.1); border: 1.5px solid rgba(245, 158, 11, 0.3);">
                                    <i class="bi bi-shield-exclamation text-warning fs-5"></i>
                                </div>
                                <div>
                                    <h4 class="fw-bold text-dark mb-0.5" style="line-height: 1.3;">
                                        @(LangService.IsMyanmar ? "Retake စောင့်ကြည့်မှုနှင့် ကျောင်းတက်ခွင့် အဆင့်အတန်း" : "Academic Retake Standing & Policy Monitor")
                                    </h4>
                                    <p class="text-muted mb-0" style="font-size: 0.88rem;">
                                        @(LangService.IsMyanmar ? "Semester ၁ မှ ၈ အထိ ရယူထားသော Retake စာရင်း" : "Semester 1 to 8 retake record and danger level")
                                    </p>
                                </div>
                            </div>
                            <span class="badge px-3 py-2 fs-6 fw-bold" style="background: @(retakeStatus.DangerLevel == "Safe" ? "rgba(16, 185, 129, 0.15)" : retakeStatus.DangerLevel == "Warning" ? "rgba(245, 158, 11, 0.15)" : retakeStatus.DangerLevel == "HighDanger" ? "rgba(249, 115, 22, 0.15)" : "rgba(239, 68, 68, 0.15)"); color: @retakeStatus.BadgeColor; border: 1px solid @retakeStatus.BadgeColor; border-radius: 999px;">
                                @if (LangService.IsMyanmar)
                                {
                                    @(retakeStatus.DangerLevel == "Safe" ? "အဆင့် ၁: ပုံမှန်" : retakeStatus.DangerLevel == "Warning" ? "အဆင့် ၂: သတိပြုရန်" : retakeStatus.DangerLevel == "HighDanger" ? "အဆင့် ၃: အန္တရာယ်ရှိ" : "အဆင့် ၄: ဘွဲ့မရနိုင်")
                                }
                                else
                                {
                                    @(retakeStatus.DangerLevel == "Safe" ? "Level 1: Safe" : retakeStatus.DangerLevel == "Warning" ? "Level 2: Warning" : retakeStatus.DangerLevel == "HighDanger" ? "Level 3: High Danger" : "Level 4: Disqualified")
                                }
                            </span>
                        </div>

                    <!-- Metrics Grid -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fs-4 fw-bolder text-dark">@retakeStatus.TotalRetakesTaken <small class="fs-6 text-muted font-monospace">/ @retakeStatus.MaxRetakeLimit</small></div>
                                <div class="text-secondary small fw-bold mt-1"><i class="bi bi-arrow-repeat text-primary me-1"></i> @(LangService.IsMyanmar ? "ရယူပြီးသော Retake အကြိမ်" : "Total Retakes Taken")</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fs-4 fw-bolder" style="color: @(retakeStatus.RemainingRetakes <= 5 ? "#ef4444" : retakeStatus.RemainingRetakes <= 10 ? "#f59e0b" : "#10b981");">@retakeStatus.RemainingRetakes <small class="fs-6 text-muted">@(LangService.IsMyanmar ? "ကြိမ်" : "left")</small></div>
                                <div class="text-secondary small fw-bold mt-1"><i class="bi bi-hourglass-split text-warning me-1"></i> @(LangService.IsMyanmar ? "ကျန်ရှိသော Retake ခွင့်ပြုချက်" : "Remaining Retakes Allowed")</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fs-4 fw-bolder" style="color: @retakeStatus.BadgeColor;">@retakeStatus.UsagePercentage%</div>
                                <div class="text-secondary small fw-bold mt-1"><i class="bi bi-speedometer2 text-info me-1"></i> @(LangService.IsMyanmar ? "အသုံးပြုပြီးမှု ရာခိုင်နှုန်း" : "Usage Percentage")</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fs-4 fw-bolder" style="color: @(retakeStatus.FailedSubjectsCount > 0 ? "#ef4444" : "#10b981");">@retakeStatus.FailedSubjectsCount <small class="fs-6 text-muted">@(LangService.IsMyanmar ? "ဘာသာ" : "courses")</small></div>
                                <div class="text-secondary small fw-bold mt-1"><i class="bi bi-x-circle text-danger me-1"></i> @(LangService.IsMyanmar ? "လက်ရှိ မအောင်သေးသော ဘာသာ" : "Active Failed Subjects")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mb-4">
                        <div style="height: 12px; background: #e2e8f0; border-radius: 999px; overflow: hidden;">
                            <div style="height: 100%; width: @Math.Min(100, Math.Max(4, retakeStatus.UsagePercentage))%; background: linear-gradient(90deg, #10b981 0%, #f59e0b 60%, #f97316 80%, #ef4444 100%); transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small fw-bold mt-1" style="font-size: 0.76rem;">
                            <span>@(LangService.IsMyanmar ? "၀ ကြိမ် (ပုံမှန်)" : "0 (Safe)")</span>
                            <span>@(LangService.IsMyanmar ? "၁၅ ကြိမ် (သတိပြုရန်)" : "15 (Warning)")</span>
                            <span>@(LangService.IsMyanmar ? "၂၀ ကြိမ် (အန္တရာယ်ရှိ)" : "20 (High Danger)")</span>
                            <span>@retakeStatus.MaxRetakeLimit @(LangService.IsMyanmar ? "ကြိမ် (အများဆုံး)" : "Max Limit")</span>
                        </div>
                    </div>

                    <!-- Alert Box -->
                    <div class="p-3 rounded-3 mb-4" style="background: @(retakeStatus.DangerLevel == "Safe" ? "rgba(16, 185, 129, 0.08)" : retakeStatus.DangerLevel == "Warning" ? "rgba(245, 158, 11, 0.08)" : retakeStatus.DangerLevel == "HighDanger" ? "rgba(249, 115, 22, 0.08)" : "rgba(239, 68, 68, 0.12)"); border-left: 4px solid @retakeStatus.BadgeColor;">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi @(retakeStatus.DangerLevel == "Safe" ? "bi-check-circle-fill" : retakeStatus.DangerLevel == "Warning" ? "bi-exclamation-triangle-fill" : retakeStatus.DangerLevel == "HighDanger" ? "bi-fire" : "bi-slash-circle-fill") fs-5 flex-shrink-0" style="color: @retakeStatus.BadgeColor;"></i>
                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                @if (LangService.IsMyanmar)
                                {
                                    @(retakeStatus.DangerLevel == "Safe" ? "သတ်မှတ်ချက်အတွင်း ရှိနေပါသည် (အခြေအနေ ကောင်းမွန်ပါသည်)" :
                                      retakeStatus.DangerLevel == "Warning" ? "Retake အရေအတွက် များပြားနေပါသည် (သတိပြုရန်)" :
                                      retakeStatus.DangerLevel == "HighDanger" ? "ကျောင်းထုတ်ခံရနိုင်ခြေ အန္တရာယ်ရှိနေပါသည် (အထူးသတိပြုရန်)" :
                                      "Retake ကန့်သတ်ချက် ပြည့်သွားပါပြီ (ဘွဲ့မရနိုင်ပါ)")
                                }
                                else
                                {
                                    @(retakeStatus.DangerLevel == "Safe" ? "Within permitted retake limit (Good standing)" :
                                      retakeStatus.DangerLevel == "Warning" ? "Approaching retake limit (Attention required)" :
                                      retakeStatus.DangerLevel == "HighDanger" ? "High risk of disqualification (Urgent warning)" :
                                      "Maximum retake limit reached (Disqualified)")
                                }
                            </div>
                        </div>
                    </div>

                    @if (retakeStatus.RetakeHistoryList.Any())
                    {
                        <div class="pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-check text-primary me-1"></i> @(LangService.IsMyanmar ? "Retake ရယူခဲ့သော ဘာသာရပ်များ:" : "Retake Subject History:")</h6>
                                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.78rem;">
                                    @(LangService.IsMyanmar ? $"စုစုပေါင်း {retakeStatus.RetakeHistoryList.Count} ခု" : $"Total {retakeStatus.RetakeHistoryList.Count} records")
                                </span>
                            </div>
                            <div class="retake-grid-container">
                                @foreach (var hist in retakeStatus.RetakeHistoryList)
                                {
                                    <div class="retake-item-card p-2.5">
                                        <div class="d-flex align-items-center gap-2.5">
                                            <i class="bi bi-clock-history text-warning flex-shrink-0" style="font-size: 1rem; margin-right: 2px;"></i>
                                            <span class="text-dark fw-semibold" style="font-size: 0.86rem; line-height: 1.4;">@FormatRetakeHistoryItem(hist)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        @(LangService.IsMyanmar ? "Retake မှတ်တမ်း မရှိပါ။" : "No retake records available.")
