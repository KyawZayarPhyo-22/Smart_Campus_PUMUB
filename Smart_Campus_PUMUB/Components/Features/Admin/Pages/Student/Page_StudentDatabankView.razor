                                                                                Elective
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge px-2 py-1 fw-bold" style="background-color: #4F46E5; color: #ffffff !important; font-size: 0.72rem; border-radius: 4px; white-space: nowrap;">
                                                                                Core
                                                                            </span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                                selIdx++;
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
