                                                                                <i class="bi bi-arrow-right-circle me-1"></i> @(LangService.IsMyanmar ? "Carry over ဘာသာ" : "Carry Over")
                                                                            </span>
                                                                        }
                                                                    </td>
                                                                    <td style="text-align: center; padding: 8px 4px;">
                                                                        <span style="font-size: 0.76rem; font-weight: 700; color: #1e293b; background: #f1f5f9; padding: 2px 5px; border-radius: 4px; border: 1px solid #e2e8f0; white-space: nowrap;">
                                                                            @sub.SubjectCode
                                                                        </span>
                                                                    </td>
                                                                    <td style="text-align: center; padding: 8px 4px;">
                                                                        <span class="badge px-1.5 py-1 fw-bold" style="background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.72rem; border-radius: 4px; white-space: nowrap;">
                                                                            @sub.Credit Pts
