                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge px-2.5 py-1.5 fw-bold" style="background: rgba(16, 185, 129, 0.15); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.8rem; border-radius: 6px;">
                                        <i class="bi bi-check2-circle me-1"></i> @(LangService.IsMyanmar ? $"ရွေးချယ်ပြီး: {sem.SelectedCount} ဘာသာ ({sem.TotalSelectedCredits} Pts)" : $"Selected: {sem.SelectedCount} Subjects ({sem.TotalSelectedCredits} Pts)")
                                    </span>
                                    @if (sem.UnselectedCount > 0)
                                    {
