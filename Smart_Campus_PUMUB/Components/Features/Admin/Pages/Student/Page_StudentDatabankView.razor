                                    @subjectSelections.TotalPendingRequiredSubjects <small class="fs-6 text-muted">@(LangService.IsMyanmar ? "ဘာသာ" : "courses") @(subjectSelections.TotalPendingRequiredCredits > 0 ? $"({subjectSelections.TotalPendingRequiredCredits} Pts)" : "")</small>
                                </div>
                                <div class="text-secondary small fw-bold mt-1">
                                    <i class="bi @(subjectSelections.TotalPendingRequiredSubjects > 0 ? "bi-exclamation-circle-fill text-danger" : "bi-check-circle-fill text-success") me-1"></i>
                                    @if (subjectSelections.TotalPendingRequiredSubjects > 0)
                                    {
                                        @(LangService.IsMyanmar ? "ရွေးချယ်ရန် ကျန်ရှိသော ဘာသာရပ်" : "Pending Required Subjects")
                                    }
                                    else
                                    {
                                        @(LangService.IsMyanmar ? "ရွေးချယ်ရန်ကျန် မရှိပါ" : "All Required Enrolled")
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Per-Semester Subject Selection Cards -->
                    var displayedSubjectSemesters = appliedSelectionSemesterFilterId == 0 
                        ? subjectSelections.SemesterSelections 
                        : subjectSelections.SemesterSelections.Where(s => s.SemesterId == appliedSelectionSemesterFilterId).ToList();

                    @if (!displayedSubjectSemesters.Any())
                    {
                        <div class="text-center py-5 bg-white rounded-3 border">
                            <i class="bi bi-inbox text-muted fs-1"></i>
                            <p class="text-muted mt-2">@(LangService.IsMyanmar ? "ရွေးချယ်ထားသော Semester အတွက် အချက်အလက် ရှာမတွေ့ပါ။" : "No subject selection records found for the selected semester.")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var sem in displayedSubjectSemesters)
                        {
                        <div class="semester-selection-card mb-4">
                            <!-- Semester Card Header -->
