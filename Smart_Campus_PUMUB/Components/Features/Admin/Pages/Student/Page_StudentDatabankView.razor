                                                                <th style="color: #ffffff !important; font-weight: 700; font-size: 0.74rem; text-transform: uppercase; padding: 9px 6px; min-width: 140px;">@(LangService.IsMyanmar ? "ဘာသာရပ်အမည်" : "Subject Name")</th>
                                                                <th style="width: 78px; text-align: center; color: #ffffff !important; font-weight: 700; font-size: 0.74rem; text-transform: uppercase; padding: 9px 4px;">@(LangService.IsMyanmar ? "ကုဒ်" : "Code")</th>
                                                                <th style="width: 56px; text-align: center; color: #ffffff !important; font-weight: 700; font-size: 0.74rem; text-transform: uppercase; padding: 9px 4px;">Credit</th>
