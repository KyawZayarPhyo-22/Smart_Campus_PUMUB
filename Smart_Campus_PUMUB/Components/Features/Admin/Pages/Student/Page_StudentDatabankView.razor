                                    {
                                        <span class="badge bg-light text-dark border px-2.5 py-1.5" style="font-size: 0.8rem; font-weight: 700;">
                                            @(LangService.IsMyanmar ? "ခုံအမှတ်" : "Roll No"): @sem.RollNo
                                        </span>
                                    }
                                    @if (sem.RegistrationDate.HasValue)
                                    {
                                        <span class="text-muted small fw-semibold">
                                            <i class="bi bi-calendar-event me-1"></i> @sem.RegistrationDate.Value.ToString("dd MMM yyyy")
