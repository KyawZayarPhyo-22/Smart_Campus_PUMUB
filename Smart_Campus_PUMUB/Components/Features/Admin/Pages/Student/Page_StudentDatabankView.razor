                                    <span class="badge px-3 py-2 fw-bold" style="background: #4F46E5; color: #ffffff !important; font-size: 0.88rem; border-radius: 8px; letter-spacing: 0.3px;">
                                        <i class="bi bi-bookmark-star-fill me-1.5"></i> @sem.SemesterName
                                    </span>
                                    @if (!string.IsNullOrEmpty(sem.Major))
                                    {
                                        <span class="badge" style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-size: 0.8rem; font-weight: 600; padding: 5px 12px; border-radius: 20px;">
                                            <i class="bi bi-mortarboard me-1"></i> @sem.Major
                                        </span>
                                    }
