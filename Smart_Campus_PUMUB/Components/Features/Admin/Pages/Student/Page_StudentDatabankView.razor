@code {
    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public int NewStudentAccId { get; set; }

    private string currentTab = "personal-info";
    private int selectedSemesterDropdownValue = 0;
    private int appliedSemesterFilterId = 0;

    private int selectedSelectionSemesterDropdownValue = 0;
    private int appliedSelectionSemesterFilterId = 0;

    private StudentRetakeStatusModel? retakeStatus;
    private bool isLoadingRetake = true;

    private StudentGraduationStatusModel? graduationStatus;
    private bool isLoadingGraduation = true;

    private StudentSubjectSelectionResponseModel? subjectSelections;
    private bool isLoadingSelections = true;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += HandleLanguageChanged;
        await Task.WhenAll(LoadRetakeStatus(), LoadGraduationStatus(), LoadSubjectSelections());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedLang = await JS.InvokeAsync<string>("localStorage.getItem", "admin_dashboard_lang");
                if (!string.IsNullOrEmpty(savedLang) && savedLang != LangService.CurrentLanguage)
                {
                    LangService.SetLanguage(savedLang);
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore JS interop errors during prerendering
            }
        }
    }

    private async Task SetLanguage(string lang)
    {
        LangService.SetLanguage(lang);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "admin_dashboard_lang", lang);
        }
        catch
        {
            // Ignore JS interop errors
        }
        StateHasChanged();
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= HandleLanguageChanged;
    }

    private async Task LoadRetakeStatus()
    {
        isLoadingRetake = true;
        try
        {
            retakeStatus = await HttpClientService.ExecuteAsync<StudentRetakeStatusModel>($"student/retake-status/{UserId}", EnumHttpMethod.Get);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading retake status: {ex.Message}");
        }
        finally
        {
            isLoadingRetake = false;
        }
    }

    private async Task LoadGraduationStatus()
    {
        isLoadingGraduation = true;
        try
        {
            string query = NewStudentAccId > 0 ? $"?newStudentAccId={NewStudentAccId}" : "";
            graduationStatus = await HttpClientService.ExecuteAsync<StudentGraduationStatusModel>($"student/graduation-status/{UserId}{query}", EnumHttpMethod.Get);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading graduation status: {ex.Message}");
        }
        finally
        {
            isLoadingGraduation = false;
        }
    }

    private async Task LoadSubjectSelections()
    {
        isLoadingSelections = true;
        try
        {
            string query = NewStudentAccId > 0 ? $"?newStudentAccId={NewStudentAccId}" : "";
            subjectSelections = await HttpClientService.ExecuteAsync<StudentSubjectSelectionResponseModel>($"student/subject-selections/{UserId}{query}", EnumHttpMethod.Get);

            if (subjectSelections?.SemesterSelections != null)
            {
                var allSelectedSubjectIds = new HashSet<int>();
                foreach (var s in subjectSelections.SemesterSelections)
                {
                    foreach (var sel in s.SelectedSubjects)
                    {
                        allSelectedSubjectIds.Add(sel.SubjectId);
                    }
                }

                int totalPending = 0;
                int totalPendingCredits = 0;
                var resolvedCoreSubjectIds = new HashSet<int>();

                foreach (var currentSem in subjectSelections.SemesterSelections)
                {
                    int semPending = 0;
                    foreach (var unSub in currentSem.UnselectedSubjects)
                    {
                        // Check if enrolled later
                        bool enrolledLater = unSub.IsEnrolledLater;
                        string laterSemName = unSub.EnrolledLaterSemester ?? string.Empty;

                        if (!enrolledLater)
                        {
                            foreach (var otherSem in subjectSelections.SemesterSelections)
                            {
                                if (otherSem.RegistrationId > currentSem.RegistrationId)
                                {
                                    var found = otherSem.SelectedSubjects.FirstOrDefault(s => s.SubjectId == unSub.SubjectId || (!string.IsNullOrEmpty(s.SubjectCode) && s.SubjectCode.Equals(unSub.SubjectCode, StringComparison.OrdinalIgnoreCase)));
                                    if (found != null)
                                    {
                                        enrolledLater = true;
                                        laterSemName = otherSem.SemesterName;
                                        break;
                                    }
                                }
                            }
                        }

                        if (enrolledLater)
                        {
                            unSub.IsEnrolledLater = true;
                            unSub.EnrolledLaterSemester = laterSemName;
                            unSub.IsRequired = false;
                        }
                        else if (unSub.SubjectType != "Elective")
                        {
                            unSub.IsRequired = true;
                            semPending++;
                            if (!allSelectedSubjectIds.Contains(unSub.SubjectId) && !resolvedCoreSubjectIds.Contains(unSub.SubjectId))
                            {
                                resolvedCoreSubjectIds.Add(unSub.SubjectId);
                                totalPending++;
                                totalPendingCredits += unSub.Credit;
                            }
                        }
                    }
                }

                subjectSelections.TotalPendingRequiredSubjects = totalPending;
                subjectSelections.TotalPendingRequiredCredits = totalPendingCredits;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading subject selections: {ex.Message}");
        }
        finally
        {
            isLoadingSelections = false;
        }
    }

    private void ApplySemesterFilter()
    {
        appliedSemesterFilterId = selectedSemesterDropdownValue;
        StateHasChanged();
    }

    private void ResetSemesterFilter()
    {
        selectedSemesterDropdownValue = 0;
        appliedSemesterFilterId = 0;
        StateHasChanged();
    }

    private void ApplySelectionSemesterFilter()
    {
        appliedSelectionSemesterFilterId = selectedSelectionSemesterDropdownValue;
        StateHasChanged();
    }

    private void ResetSelectionSemesterFilter()
    {
        selectedSelectionSemesterDropdownValue = 0;
        appliedSelectionSemesterFilterId = 0;
        StateHasChanged();
    }

    private string FormatRetakeHistoryItem(string hist)
    {
        if (string.IsNullOrWhiteSpace(hist)) return string.Empty;
        var parts = hist.Split(" - ");
        var subjectNameCode = parts[0].Trim();

        if (LangService.IsMyanmar)
        {
            if (parts.Length > 1 && parts[1].Contains("ကြိမ်"))
            {
                var match = System.Text.RegularExpressions.Regex.Match(parts[1], @"\d+");
                if (match.Success)
                {
                    return $"{subjectNameCode} - {match.Value} ကြိမ် ဖြေဆိုပြီး";
                }
            }
            return $"{subjectNameCode} - Retake ဖြေဆိုပြီး";
        }
        else
        {
            if (parts.Length > 1)
            {
                var match = System.Text.RegularExpressions.Regex.Match(parts[1], @"\d+");
                if (match.Success)
                {
                    int count = int.Parse(match.Value);
                    return $"{subjectNameCode} - {count} {(count > 1 ? "Retake Attempts" : "Retake Attempt")}";
                }
            }
            return $"{subjectNameCode} - Retake Attempt";
        }
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("printReportWindow");
    }

    private static string ToMyanmarDigits(int number)
    {
        return number.ToString()
            .Replace('0', '၀')
            .Replace('1', '၁')
            .Replace('2', '၂')
            .Replace('3', '၃')
            .Replace('4', '၄')
            .Replace('5', '၅')
            .Replace('6', '၆')
            .Replace('7', '၇')
            .Replace('8', '၈')
            .Replace('9', '၉');
    }
}

