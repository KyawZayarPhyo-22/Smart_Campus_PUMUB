                                <i class="bi bi-journal-bookmark-fill fs-5" style="color: #5A4FCF;"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-0.5" style="line-height: 1.3;">
                                    @(LangService.IsMyanmar ? "ဘာသာရပ် ရွေးချယ်မှု မှတ်တမ်း" : "Student Subject Selection History")
                                </h4>
                                <p class="text-muted mb-0" style="font-size: 0.88rem;">
                                    @(LangService.IsMyanmar ? "Semester အလိုက် ရွေးချယ်ခဲ့သော ဘာသာရပ်များနှင့် မရွေးချယ်ခဲ့သော ဘာသာရပ်များ" : "Selected courses and unselected elective courses by semester")
                                </p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge px-3 py-2 fw-bold" style="background: rgba(90, 79, 207, 0.12); color: #5A4FCF; border: 1px solid rgba(90, 79, 207, 0.3); border-radius: 20px; font-size: 0.82rem;">
                                <i class="bi bi-person-fill me-1"></i> @(LangService.IsMyanmar ? (!string.IsNullOrEmpty(subjectSelections.StudentNameMm) ? subjectSelections.StudentNameMm : subjectSelections.StudentNameEn) : (!string.IsNullOrEmpty(subjectSelections.StudentNameEn) ? subjectSelections.StudentNameEn : subjectSelections.StudentNameMm)) (@(string.IsNullOrEmpty(subjectSelections.RollNo) ? "-" : subjectSelections.RollNo))
                            </span>
                            <div class="d-flex align-items-center gap-2 flex-nowrap">
                                <select class="form-select form-select-sm shadow-none fw-bold text-dark" style="width: 230px; height: 38px; border-radius: 8px; border: 1.5px solid #5A4FCF; background-color: #ffffff; padding-right: 32px;" @bind="selectedSelectionSemesterDropdownValue">
                                    <option value="0">@(LangService.IsMyanmar ? "Semester အားလုံး" : "All Semesters")</option>
                                    @foreach (var sem in subjectSelections.SemesterSelections)
                                    {
                                        <option value="@sem.SemesterId">@sem.SemesterName</option>
                                    }
                                </select>
                                <button class="btn shadow-sm d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="background-color: #0d6efd; color: #ffffff !important; border-radius: 8px; height: 38px; width: 42px; border: none;" type="button" @onclick="ApplySelectionSemesterFilter" title="@(LangService.IsMyanmar ? "ရှာမည်" : "Filter")">
                                    <i class="bi bi-search"></i>
                                </button>
                                @if (appliedSelectionSemesterFilterId != 0)
                                {
                                    <button class="btn btn-secondary shadow-sm d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="border-radius: 8px; color: #ffffff !important; height: 38px; width: 42px;" type="button" @onclick="ResetSelectionSemesterFilter" title="@(LangService.IsMyanmar ? "မူလအတိုင်း" : "Reset")">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Metrics Grid -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fs-4 fw-bolder text-dark">@subjectSelections.SemesterSelections.Count <small class="fs-6 text-muted">@(LangService.IsMyanmar ? "ခု" : "Semesters")</small></div>
                                <div class="text-secondary small fw-bold mt-1"><i class="bi bi-calendar3 text-primary me-1"></i> @(LangService.IsMyanmar ? "စာရင်းသွင်း Semester အရေအတွက်" : "Registered Semesters")</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fs-4 fw-bolder text-success">@subjectSelections.SemesterSelections.Sum(s => s.SelectedCount) <small class="fs-6 text-muted">@(LangService.IsMyanmar ? "ဘာသာ" : "courses")</small></div>
                                <div class="text-secondary small fw-bold mt-1"><i class="bi bi-check-circle-fill text-success me-1"></i> @(LangService.IsMyanmar ? "ရွေးချယ်ခဲ့သော ဘာသာရပ် စုစုပေါင်း" : "Total Selected Subjects")</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="fs-4 fw-bolder text-primary">@(graduationStatus?.TotalEarnedCredits ?? subjectSelections.TotalEarnedCredits) <small class="fs-6 text-muted font-monospace">/ @(graduationStatus?.TargetGraduationCredits ?? 155) Pts</small></div>
                                <div class="text-secondary small fw-bold mt-1"><i class="bi bi-award-fill text-primary me-1"></i> @(LangService.IsMyanmar ? "ရရှိပြီး Credit Points စုစုပေါင်း" : "Total Earned Credit Points")</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
