@page "/admin/payments"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Payment
@using Smart_Campus_PUMUB.WebApi.Models
@rendermode InteractiveServer

<PageTitle>@(LangService.IsMyanmar ? "ငွေပေးချေမှုမှတ်တမ်း" : "Payment Directory")</PageTitle>

<style>
    .custom-table { background: rgba(20, 24, 33, 0.6); border-radius: 12px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.05); }
    .custom-table thead { background: rgba(13, 110, 253, 0.1); border-bottom: 2px solid rgba(13, 110, 253, 0.2); }
    .custom-table th { font-weight: 600; text-transform: uppercase; font-size: 0.85rem; color: #0d6efd; padding: 16px 20px; }
    .custom-table td { padding: 16px 20px; color: #e2e8f0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .table-row-hover:hover { background: rgba(255, 255, 255, 0.02); box-shadow: inset 4px 0 0 #0d6efd; }
    .btn-action-edit { background: rgba(13, 110, 253, 0.1); color: #39b5ff; border: 1px solid rgba(13, 110, 253, 0.3); border-radius: 6px; padding: 6px 14px; transition: all 0.2s ease; }
    .btn-action-edit:hover { background: #0d6efd; color: #ffffff; }
    .btn-action-delete { background: rgba(220, 53, 69, 0.1); color: #ff6b6b; border: 1px solid rgba(220, 53, 69, 0.3); border-radius: 6px; padding: 6px 14px; transition: all 0.2s ease; }
    .btn-action-delete:hover { background: #dc3545; color: #ffffff; }
    .search-input { padding-left: 2.6rem !important; }
</style>

<div class="tab-pane fade show active">
    <div class="d-flex align-items-center gap-3 mb-4 mt-2 py-1">
        <div class="rounded-3 p-2 shadow-sm d-flex align-items-center justify-content-center flex-shrink-0"
             style="width: 44px; height: 44px; background: rgba(13, 110, 253, 0.08); border: 1.5px solid rgba(13, 110, 253, 0.25);">
            <i class="bi bi-credit-card-2-front fs-5" style="color: #0d6efd;"></i>
        </div>
        <div>
            <h4 class="fw-bolder mb-1" style="letter-spacing: 0.5px; color: #1e293b;">
                @(LangService.IsMyanmar ? "ငွေပေးချေမှုမှတ်တမ်း" : "Payment Directory")
            </h4>
            <small class="text-secondary d-block">
                @(LangService.IsMyanmar ? "ကျောင်းအပ်ငွေပေးချေမှုမှတ်တမ်းများ စီမံခန့်ခွဲခြင်း" : "Manage and track student registration payments")
            </small>
        </div>
    </div>

    <!-- 🔹 Filter Section -->
    <div class="material-card p-3 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute text-muted" style="top: 50%; left: 14px; transform: translateY(-50%); pointer-events: none; z-index: 5; font-size: 0.9rem;"></i>
                    <input type="text" class="form-control material-input search-input w-100" placeholder="@(LangService.IsMyanmar ? "ကျောင်းအပ်အမှတ် သို့မဟုတ် ပေးချေနည်းဖြင့် ရှာရန်..." : "Search by Registration ID or Method...")" @bind-value="SearchInput" @onkeyup="HandleKeyUp">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select material-input" @bind="SelectedStatus">
                    <option value="">@(LangService.IsMyanmar ? "အခြေအနေ အားလုံး" : "All Status")</option>
                    <option value="Pending">@(LangService.IsMyanmar ? "စောင့်ဆိုင်းဆဲ" : "Pending")</option>
                    <option value="Approved">@(LangService.IsMyanmar ? "အတည်ပြုပြီး" : "Approved")</option>
                    <option value="Rejected">@(LangService.IsMyanmar ? "ပယ်ချပြီး" : "Rejected")</option>
                </select>
            </div>
            
            <!-- Search and Reset Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary w-50 d-flex align-items-center justify-content-center" style="background-color: #0d6efd !important; border-color: #0d6efd !important;" type="button" @onclick="ApplyFilter" title="@(LangService.IsMyanmar ? "ရှာမည်" : "Search")">
                    <i class="bi bi-search"></i>
                </button>
                <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" type="button" @onclick="ResetFilter" title="@(LangService.IsMyanmar ? "ပြန်လည်သတ်မှတ်မည်" : "Reset")">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <!-- Add Button -->
            <div class="col-auto">
                <NavLink href="/admin/payment/create" class="btn btn-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 38px; background-color: #0d6efd !important; border-color: #0d6efd !important;" title="@(LangService.IsMyanmar ? "အသစ်ထည့်မည်" : "Add Payment")">
                    <i class="bi bi-plus-lg"></i>
                </NavLink>
            </div>
        </div>
    </div>

    <div class="tech-card p-4">
        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="text-dark mt-3 small fw-bold">@(LangService.IsMyanmar ? "ဒေတာများကို ဆွဲယူနေပါသည်..." : "Loading payments...")</div>
            </div>
        }
        else if (FilteredPayments == null || !FilteredPayments.Any())
        {
            <div class="text-center my-5 text-dark">
                <i class="bi bi-folder-x display-4 text-secondary"></i>
                <p class="mt-3 mb-0 small fw-bold text-dark">@(LangService.IsMyanmar ? "ပြသရန် အချက်အလက် မရှိပါ။" : "No payments found.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive custom-table">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@(LangService.IsMyanmar ? "စဉ်" : "No.")</th>
                            <th>@(LangService.IsMyanmar ? "ပြေစာ" : "Receipt")</th>
                            <th>@(LangService.IsMyanmar ? "ကျောင်းအပ်အမှတ်" : "Reg ID")</th>
                            <th>@(LangService.IsMyanmar ? "ပမာဏ" : "Amount")</th>
                            <th>@(LangService.IsMyanmar ? "ပေးချေနည်း" : "Method")</th>
                            <th>@(LangService.IsMyanmar ? "အခြေအနေ" : "Status")</th>
                            <th class="text-center">@(LangService.IsMyanmar ? "လုပ်ဆောင်ချက်" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = (CurrentPage - 1) * PageSize + 1;
                        }
                        @foreach (var p in FilteredPayments)
                        {
                            <tr class="table-row-hover">
                                <td class="fw-bold text-dark">@count.ToString("D2")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.ReceiptImage))
                                    {
                                        <img src="@($"http://localhost:5077/{p.ReceiptImage}")" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="bi bi-receipt text-light"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@p.RegistrationId</td>
                                <td class="fw-bold text-dark">$ @p.AmountPaid</td>
                                <td class="fw-bold text-dark">@p.PaymentMethod</td>
                                <td>
                                    <span class="badge @(p.Status == "Approved" ? "bg-success" : p.Status == "Rejected" ? "bg-danger" : "bg-warning")">
                                        @(p.Status == "Approved" ? (LangService.IsMyanmar ? "အတည်ပြုပြီး" : "Approved") :
                                          p.Status == "Rejected" ? (LangService.IsMyanmar ? "ပယ်ချပြီး" : "Rejected") :
                                          (LangService.IsMyanmar ? "စောင့်ဆိုင်းဆဲ" : "Pending"))
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <NavLink href="@($"/admin/payment/edit/{p.PaymentId}")" class="btn btn-action-edit">
                                            <i class="bi bi-pencil"></i> @(LangService.IsMyanmar ? "ပြင်မည်" : "Edit")
                                        </NavLink>
                                        <button class="btn btn-action-delete" @onclick="() => OpenDeleteModal(p)">
                                            <i class="bi bi-trash"></i> @(LangService.IsMyanmar ? "ဖျက်မည်" : "Delete")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>

            <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
        }
    </div>
</div>

@* Delete Modal *@
@if (ShowModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tech-card">
                <div class="modal-header border-0">
                    <h5 class="text-danger">@(LangService.IsMyanmar ? "ဖျက်ရန် အတည်ပြုခြင်း" : "Confirm Delete")</h5>
                </div>
                <div class="modal-body text-center">
                    @(LangService.IsMyanmar ? $"ဤ ငွေပေးချေမှုမှတ်တမ်းကို ဖျက်ရန် သေချာပါသလား?" : $"Are you sure to delete this payment record?")

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="mt-3 p-3 rounded"
                             style="background: @(IsSuccess ? "rgba(25, 135, 84, 0.15)" : "rgba(220, 53, 69, 0.15)");
                            border: 1px solid @(IsSuccess ? "#198754" : "#dc3545");">

                            <span style="color: @(IsSuccess ? "#75b798" : "#ea868f"); font-size: 0.9rem;">
                                <i class="bi @(IsSuccess ? "bi-check-circle" : "bi-exclamation-circle") me-2"></i>
                                @statusMessage
                            </span>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal" disabled="@IsProcessing">
                        @(LangService.IsMyanmar ? "မလုပ်တော့ပါ" : "Cancel")
                    </button>
                    <button class="btn btn-danger" @onclick="DeletePayment" disabled="@(IsProcessing || IsSuccess)">
                        @(IsProcessing ? (LangService.IsMyanmar ? "ဖျက်နေသည်..." : "Deleting...") : (LangService.IsMyanmar ? "သေချာသည်၊ ဖျက်မည်" : "Yes, Delete"))
                    </button>
                </div>
            </div>
        </div>
    </div>
}