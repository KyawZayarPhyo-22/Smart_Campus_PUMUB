{
    private string currentLang = "en";
    private bool isLangDropdownOpen = false;
    private readonly List<RoleDistributionChartPoint> RoleDistributionData = new();
    private readonly List<RoleDistributionChartPoint> FacultyDistributionData = new();
    private Timer? _timer;
    private List<ActivityItem> recentActivities = new();
    private bool _isRendered = false; // JS Interop အတွက် အရေးကြီးသည်

    private void ToggleLangDropdown()
    {
        isLangDropdownOpen = !isLangDropdownOpen;
    }

    private void CloseLangDropdown()
    {
        isLangDropdownOpen = false;
    }

    private async Task SelectLanguage(string lang)
    {
        isLangDropdownOpen = false;
        await SetLanguage(lang);
    }

    private async Task SetLanguage(string lang)
    {
        currentLang = lang;
        LangService.SetLanguage(lang);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "admin_dashboard_lang", lang);
        }
        catch { }
        StateHasChanged();
        if (_isRendered)
        {
            await JS.InvokeVoidAsync("initCharts", RoleDistributionData, FacultyYearData, currentLang);
        }
    }

    private void HandleLanguageChanged()
    {
        if (currentLang != LangService.CurrentLanguage)
        {
            currentLang = LangService.CurrentLanguage;
            InvokeAsync(StateHasChanged);
            if (_isRendered)
            {
                InvokeAsync(async () => await JS.InvokeVoidAsync("initCharts", RoleDistributionData, FacultyYearData, currentLang));
            }
        }
    }

    private int activeStudentCount = 0;
    private int previousStudentCount = 0;
    private double percentage = 0;
    private int totalTutorCount = 0;
    private int previousTutorCount = 0;
    private double tutorPercentage = 0;
    private int bookCount = 0;
    private int previousBookCount = 0;
    private double bookPercentage = 0;
    private int activeAlertCount = 0;
    private bool isDataLoading = true;
    private SystemSummary summary = new();
    private List<StudentModel> completedStudents = new();
    private List<StudentModel> allStudents = new();

    // --- Student Directory filter state ---
    private string dirSearchQuery = "";
    private string dirFilterResult = "All";

    private List<StudentModel> FilteredDirectoryStudents
    {
        get
        {
            var q = allStudents.AsEnumerable();

            // Search by name or roll no
            if (!string.IsNullOrWhiteSpace(dirSearchQuery))
            {
                var search = dirSearchQuery.Trim().ToLower();
                q = q.Where(s =>
                    (s.FullName ?? s.UserName ?? "").ToLower().Contains(search) ||
                    (s.CurrentRollNo ?? "").ToLower().Contains(search));
            }

            // Filter by result
            q = dirFilterResult switch
            {
                "HasFail" => q.Where(s => new[] { s.Sem1_Result, s.Sem2_Result, s.Sem3_Result,
                    s.Sem4_Result, s.Sem5_Result, s.Sem6_Result, s.Sem7_Result,
                    s.Sem8_Result, s.Sem9_Result }.Any(r => string.Equals(r, "Fail", StringComparison.OrdinalIgnoreCase))),

                "AllPass" => q.Where(s => IsStudentGraduated(s)),

                "NoResult" => q.Where(s => new[] { s.Sem1_Result, s.Sem2_Result, s.Sem3_Result,
                    s.Sem4_Result, s.Sem5_Result, s.Sem6_Result, s.Sem7_Result,
                    s.Sem8_Result, s.Sem9_Result }.All(r => string.IsNullOrEmpty(r))),

                _ => q  // "All"
            };

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentLang = LangService.CurrentLanguage;
            LangService.OnLanguageChanged += HandleLanguageChanged;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            _timer = new Timer(TimerCallback, null, 0, 60000);
            var client = ClientFactory.CreateClient("SmartCampusApi");

        try
        {
            var res = await HttpClientService.ExecuteAsync<StudentCountResponse>("student/count/active", Smart_Campus_PUMUB.BlazorServer.Frontend.Services.EnumHttpMethod.Get);
            if (res != null)
            {
                activeStudentCount = res.Count;
            }
            else
            {
                var res2 = await client.GetFromJsonAsync<StudentCountResponse>("student/count/active");
                activeStudentCount = res2?.Count ?? 0;
            }
        }
        catch (Exception ex)
        {
            try
            {
                var res2 = await client.GetFromJsonAsync<StudentCountResponse>("student/count/active");
                activeStudentCount = res2?.Count ?? 0;
            }
            catch { }
            Console.WriteLine($"Error student count: {ex.Message}");
        }

        try
        {
            var res = await client.GetFromJsonAsync<TutorCountResponse>("tutor/count/active");
            totalTutorCount = res?.Count ?? 0;
        }
        catch (Exception ex) { Console.WriteLine($"Error tutor count: {ex.Message}"); }

        try
        {
            var res = await client.GetFromJsonAsync<BookCountResponse>("book/count/active");
            bookCount = res?.Count ?? 0;
        }
        catch (Exception ex) { Console.WriteLine($"Error book count: {ex.Message}"); }

        try
        {
            var res = await client.GetFromJsonAsync<ActivityCountResponse>("activity/count/active");
            activeAlertCount = res?.Count ?? 0;
        }
        catch (Exception ex) { Console.WriteLine($"Error activity count: {ex.Message}"); }

        try
        {
            summary = await client.GetFromJsonAsync<SystemSummary>("Home/summary") ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Error summary: {ex.Message}"); }

        // Load all students (used for both the Directory and Completed Students sections)
        try
        {
            var studentData = await HttpClientService.ExecuteAsync<List<StudentModel>>(
                "student",
                Smart_Campus_PUMUB.BlazorServer.Frontend.Services.EnumHttpMethod.Get);

            if (studentData != null)
            {
                allStudents = studentData;
                completedStudents = studentData.Where(s => IsStudentGraduated(s)).ToList();
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error loading students: {ex.Message}"); }

        await LoadRoleDistributionAsync();
        await LoadFacultyDistributionAsync();

        // Calculations
        if (previousStudentCount <= 0) previousStudentCount = activeStudentCount;
        if (previousTutorCount <= 0) previousTutorCount = totalTutorCount;
        if (previousBookCount <= 0) previousBookCount = bookCount;

        percentage = previousStudentCount > 0 ? ((double)(activeStudentCount - previousStudentCount) / previousStudentCount) * 100 : 0;
        tutorPercentage = previousTutorCount > 0 ? ((double)(totalTutorCount - previousTutorCount) / previousTutorCount) * 100 : 0;
        bookPercentage = previousBookCount > 0 ? ((double)(bookCount - previousBookCount) / previousBookCount) * 100 : 0;
        isDataLoading = false;

        }
        catch (Exception ex)
        {
            Console.WriteLine("Other Error: " + ex.Message);
        }
    }

    private async void TimerCallback(object? state)
    {
        try
        {
            await LoadActivities();
            await LoadRoleDistributionAsync();
            await LoadFacultyDistributionAsync();
            await InvokeAsync(StateHasChanged);
            if (_isRendered)
            {
                await InvokeAsync(async () => await JS.InvokeVoidAsync("initCharts", RoleDistributionData, FacultyYearData, currentLang));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Timer Error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        LangService.OnLanguageChanged -= HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = HttpContextAccessor.HttpContext?.Request.Cookies["authToken"];
            if (string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
            }

            try
            {
                var savedLang = await JS.InvokeAsync<string>("localStorage.getItem", "admin_dashboard_lang");
                if (!string.IsNullOrEmpty(savedLang))
                {
                    currentLang = savedLang;
                    LangService.SetLanguage(savedLang);
                    StateHasChanged();
                }
            }
            catch { }

            _isRendered = true;
            try
            {
                await JS.InvokeVoidAsync("initCharts", RoleDistributionData, FacultyYearData, currentLang);
            }
            catch
            {
                try
                {
                    await Task.Delay(500);
                    await JS.InvokeVoidAsync("initCharts", RoleDistributionData, FacultyYearData, currentLang);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"initCharts JS error (chart will not render): {ex.Message}");
                }
            }
        }
    }

    private async Task LoadRoleDistributionAsync()
    {
        try
        {
            var apiData = await HttpClientService.ExecuteAsync<List<RoleDistributionChartPoint>>(
                "user/count/by-role",
                Smart_Campus_PUMUB.BlazorServer.Frontend.Services.EnumHttpMethod.Get);

            if (apiData is not null && apiData.Any())
            {
                RoleDistributionData.Clear();
                RoleDistributionData.AddRange(apiData);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    private FacultyYearChartResponse? FacultyYearData;

    private async Task LoadFacultyDistributionAsync()
    {
        try
        {
            var apiData = await HttpClientService.ExecuteAsync<FacultyYearChartResponse>(
                "user/count/by-faculty-year",
                Smart_Campus_PUMUB.BlazorServer.Frontend.Services.EnumHttpMethod.Get);

            if (apiData is not null)
            {
                FacultyYearData = apiData;
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading faculty year data: {ex.Message}");
        }
    }

    private static bool IsStudentGraduated(StudentModel s)
    {
        if (string.Equals(s.Status, "Disqualified", StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.Equals(s.Status, "Graduated", StringComparison.OrdinalIgnoreCase))
            return true;

        string major = (s.CurrentMajor ?? s.FacultyName ?? "").ToLowerInvariant();
        bool isEngineering = major.Contains("civil") ||
                             major.Contains("electronic") ||
                             major.Contains("electrical") ||
                             major.Contains("mechanical") ||
                             major.Contains("engineering");

        bool sem1To8Passed = string.Equals(s.Sem1_Result, "Pass", StringComparison.OrdinalIgnoreCase) &&
                             string.Equals(s.Sem2_Result, "Pass", StringComparison.OrdinalIgnoreCase) &&
                             string.Equals(s.Sem3_Result, "Pass", StringComparison.OrdinalIgnoreCase) &&
                             string.Equals(s.Sem4_Result, "Pass", StringComparison.OrdinalIgnoreCase) &&
                             string.Equals(s.Sem5_Result, "Pass", StringComparison.OrdinalIgnoreCase) &&
                             string.Equals(s.Sem6_Result, "Pass", StringComparison.OrdinalIgnoreCase) &&
                             string.Equals(s.Sem7_Result, "Pass", StringComparison.OrdinalIgnoreCase) &&
                             string.Equals(s.Sem8_Result, "Pass", StringComparison.OrdinalIgnoreCase);

        if (isEngineering)
        {
            return sem1To8Passed && string.Equals(s.Sem9_Result, "Pass", StringComparison.OrdinalIgnoreCase) && string.Equals(s.Status, "Graduated", StringComparison.OrdinalIgnoreCase);
        }
        else
        {
            return sem1To8Passed && string.Equals(s.Status, "Graduated", StringComparison.OrdinalIgnoreCase);
        }
    }

