@page "/admin/dashboard"
@* @attribute [Authorize(Roles = "Admin")] *@
@layout AdminLayout
@implements IDisposable
@inject IJSRuntime JS
@rendermode InteractiveServer
@using Newtonsoft.Json
@using Smart_Campus_PUMUB.WebApi.Models
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@inject Smart_Campus_PUMUB.BlazorServer.Frontend.Services.HttpClientService HttpClientService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
<style>
    .kpi-card-modern {
        background: #ffffff;
        border: 1.5px solid #f1f5f9;
        border-radius: 18px;
        padding: 1.25rem 1.35rem;
        box-shadow: 0 4px 18px -4px rgba(0, 0, 0, 0.04);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .kpi-card-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 28px -6px rgba(90, 79, 207, 0.1);
        border-color: #cbd5e1;
    }

    .kpi-card-modern::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3.5px;
        border-radius: 0 0 18px 18px;
    }

    .kpi-theme-sky::after { background: linear-gradient(90deg, #0284c7, #38bdf8); }
    .kpi-theme-purple::after { background: linear-gradient(90deg, #7c3aed, #a855f7); }
    .kpi-theme-emerald::after { background: linear-gradient(90deg, #059669, #34d399); }
    .kpi-theme-rose::after { background: linear-gradient(90deg, #e11d48, #fb7185); }

    .kpi-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .kpi-theme-sky .kpi-icon-box { background: rgba(2, 132, 199, 0.1); color: #0284c7; }
    .kpi-theme-purple .kpi-icon-box { background: rgba(124, 58, 237, 0.1); color: #7c3aed; }
    .kpi-theme-emerald .kpi-icon-box { background: rgba(5, 150, 105, 0.1); color: #059669; }
    .kpi-theme-rose .kpi-icon-box { background: rgba(225, 29, 72, 0.1); color: #e11d48; }

    .kpi-pill {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        letter-spacing: 0.2px;
    }

    .kpi-pill-sky { background: #f0f9ff; color: #0284c7; border: 1px solid #bae6fd; }
    .kpi-pill-purple { background: #faf5ff; color: #7c3aed; border: 1px solid #e9d5ff; }
    .kpi-pill-emerald { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
    .kpi-pill-rose { background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; }

    .kpi-pulse-dot {
        width: 6px;
        height: 6px;
        background-color: #e11d48;
        border-radius: 50%;
        display: inline-block;
        animation: kpiPulseAnim 1.5s infinite;
    }

    @@keyframes kpiPulseAnim {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.3); }
    }

    .kpi-value {
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.1;
        margin-top: 0.6rem;
        letter-spacing: -0.5px;
    }

    .kpi-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        margin-top: 0.25rem;
        text-transform: capitalize;
    }

    .chart-card-modern {
        background: #ffffff;
        border: 1.5px solid #f1f5f9;
        border-radius: 18px;
        padding: 1.3rem;
        box-shadow: 0 4px 18px -4px rgba(0, 0, 0, 0.04);
        transition: all 0.2s ease;
    }

    .chart-card-modern:hover {
        border-color: #cbd5e1;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.07);
    }

    .chart-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .chart-header-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .chart-header-icon-cyan { background: rgba(6, 182, 212, 0.1); color: #0891b2; }
    .chart-header-icon-purple { background: rgba(124, 58, 237, 0.1); color: #7c3aed; }
    .chart-header-icon-blue { background: rgba(59, 130, 246, 0.1); color: #2563eb; }

    .chart-header-title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #0f172a;
    }

    .chart-badge {
        font-size: 0.72rem;
        font-weight: 700;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 3px 10px;
    }
</style>

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; background: rgba(90, 79, 207, 0.08); border: 1.5px solid rgba(90, 79, 207, 0.25);">
                <i class="bi bi-speedometer2 fs-5" style="color: #5A4FCF;"></i>
            </div>
            <div>
                <h3 class="fw-bolder mb-0 text-dark" style="letter-spacing: -0.3px;">Command Center</h3>
                <p class="text-muted mb-0 small">စနစ်တစ်ခုလုံးဆိုင်ရာ ခြုံငုံသုံးသပ်ချက်၊ ဇယားများနှင့် တိုက်ရိုက်အချက်အလက်များ</p>
            </div>
        </div>
        <div>
            <span class="badge px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2" style="background: #ecfdf5; color: #059669; font-weight: 700; border: 1px solid #a7f3d0; font-size: 0.8rem;">
                <span class="d-inline-block rounded-circle bg-success" style="width: 7px; height: 7px;"></span>
                Live System Telemetry
            </span>
        </div>
    </div>
</div>

<!-- KPI Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-sky">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-people-fill"></i>
                </div>
                <span class="kpi-pill kpi-pill-sky">
                    <i class="bi bi-person-check-fill"></i> Enrolled
                </span>
            </div>
            <div class="kpi-value">@activeStudentCount.ToString("N0")</div>
            <div class="kpi-label">Active Students</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-purple">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <span class="kpi-pill kpi-pill-purple">
                    <i class="bi bi-mortarboard-fill"></i> Faculty
                </span>
            </div>
            <div class="kpi-value">@totalTutorCount</div>
            <div class="kpi-label">Total Tutors</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-emerald">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-book-half"></i>
                </div>
                <span class="kpi-pill kpi-pill-emerald">
                    <i class="bi bi-journal-check"></i> E-Library
                </span>
            </div>
            <div class="kpi-value">@bookCount.ToString("N0")</div>
            <div class="kpi-label">Library PDF Files</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-rose">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-broadcast"></i>
                </div>
                <span class="kpi-pill kpi-pill-rose">
                    <span class="kpi-pulse-dot"></span> Live Logs
                </span>
            </div>
            <div class="kpi-value">@activeAlertCount</div>
            <div class="kpi-label">Activity Logs</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     Charts Row — Highcharts (div-based, Blazor SPA safe)
     ═══════════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">

    <!-- Pie / Donut — Role Distribution -->
    <div class="col-12 col-lg-5">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-cyan">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">Role Distribution</h6>
                        <small class="text-muted" style="font-size:0.75rem;">အသုံးပြုသူအခန်းကဏ္ဍ ခွဲခြမ်းစိတ်ဖြာမှု</small>
                    </div>
                </div>
                <span class="chart-badge">2026</span>
            </div>
            <!-- Highcharts renders into this div — NO canvas needed -->
            <div id="hc-pie-chart" style="min-height:260px; width:100%;"></div>
        </div>
    </div>

    <!-- Column — Students by Faculty -->
    <div class="col-12 col-lg-7">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-purple">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">Students by Faculty</h6>
                        <small class="text-muted" style="font-size:0.75rem;">ပညာသင်နှစ်အလိုက် FC နှင့် FE ကျောင်းသားအရေအတွက် နှိုင်းယှဉ်ချက်</small>
                    </div>
                </div>
                <span class="chart-badge">FC & FE</span>
            </div>
            <!-- Highcharts renders into this div — NO canvas needed -->
            <div id="hc-bar-chart" style="min-height:260px; width:100%;"></div>
        </div>
    </div>

</div>

<!-- Quick Stats Row -->
<div class="row g-3">
    <!-- Recent Activity -->
    <div class="col-12 col-md-6">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-blue">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">Recent Activity</h6>
                        <small class="text-muted" style="font-size:0.75rem;">နောက်ဆုံးလှုပ်ရှားမှုမှတ်တမ်းများ (Latest 6)</small>
                    </div>
                </div>
            </div>
            <ul class="list-unstyled mb-0">
                @if (recentActivities != null && recentActivities.Any())
                {
                    @foreach (var activity in recentActivities.Take(6))
                    {
                        <li class="d-flex align-items-center gap-3 py-2.5 border-bottom"
                            @onclick="() => activity.IsExpanded = !activity.IsExpanded" style="cursor: pointer; border-color: #f1f5f9 !important;">

                            <span class="stat-icon flex-shrink-0"
                                  style="width:38px;height:38px;background:rgba(90,79,207,0.08);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                                <i class="bi @activity.Icon @GetIconColor(activity.ActivityTitle)" style="font-size:1.1rem;"></i>
                            </span>

                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <p class="mb-0 fw-bold small text-truncate text-dark">@activity.ActivityTitle</p>
                                    <span class="badge bg-light text-secondary border flex-shrink-0" style="font-size: 0.65rem; padding: 2px 6px;">
                                        <i class="bi bi-person-fill me-1"></i>@(string.IsNullOrWhiteSpace(activity.CreatedBy) ? "Admin" : activity.CreatedBy)
                                    </span>
                                </div>

                                @if (activity.IsExpanded)
                                {
                                    <p class="mb-0 text-muted" style="font-size:0.78rem; white-space: normal; word-break: break-word;">
                                        @activity.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="mb-0 text-muted"
                                       style="font-size:0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px;">
                                        @activity.Description
                                    </p>
                                }
                            </div>
                            <div class="text-end flex-shrink-0 ms-2">
                                <small class="text-muted d-block" style="font-size: 0.72rem; font-weight: 500;">
                                    <i class="bi bi-calendar3 me-1"></i>@(activity.CreatedDateTime != default ? activity.CreatedDateTime.ToString("dd/MM/yyyy") : "")
                                </small>
                                <small class="text-muted d-block" style="font-size: 0.68rem;">
                                    <i class="bi bi-clock me-1"></i>@(activity.CreatedDateTime != default ? activity.CreatedDateTime.ToString("hh:mm tt") : "")
                                </small>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="p-4 text-center text-muted small">No recent activity found.</li>
                }
            </ul>
        </div>
    </div>

    <!-- System Summary -->
    <div class="col-12 col-md-6">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-purple">
                        <i class="bi bi-grid-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">System Summary</h6>
                        <small class="text-muted" style="font-size:0.75rem;">စနစ်ဆိုင်ရာ အချက်အလက်များ အကျဉ်းချုပ်</small>
                    </div>
                </div>
            </div>
            <div class="row g-2.5">
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(2,132,199,0.06);border:1px solid rgba(2,132,199,0.15);">
                        <div class="fw-bolder fs-4" style="color:#0284c7;">@summary.Faculties</div>
                        <div class="text-muted small fw-semibold">Faculties</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(124,58,237,0.06);border:1px solid rgba(124,58,237,0.15);">
                        <div class="fw-bolder fs-4" style="color:#7c3aed;">@summary.Departments</div>
                        <div class="text-muted small fw-semibold">Departments</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(5,150,105,0.06);border:1px solid rgba(5,150,105,0.15);">
                        <div class="fw-bolder fs-4" style="color:#059669;">@summary.Subjects</div>
                        <div class="text-muted small fw-semibold">Subjects</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15);">
                        <div class="fw-bolder fs-4" style="color:#d97706;">@summary.Semesters</div>
                        <div class="text-muted small fw-semibold">Semesters</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(225,29,72,0.06);border:1px solid rgba(225,29,72,0.15);">
                        <div class="fw-bolder fs-4" style="color:#e11d48;">@summary.Positions</div>
                        <div class="text-muted small fw-semibold">Positions</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(90,79,207,0.06);border:1px solid rgba(90,79,207,0.15);">
                        <div class="fw-bolder fs-4" style="color:#5A4FCF;">@summary.Rules</div>
                        <div class="text-muted small fw-semibold">Rules</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Completed Students Section -->
<div class="row g-3 mb-4 mt-2">
    <div class="col-12">
        <div class="chart-card-modern">
            <div class="chart-card-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon" style="background:rgba(245,158,11,0.12);color:#d97706;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">Completed Students</h6>
                        <small class="text-muted" style="font-size:0.75rem;">အောင်မြင်စွာ ဘွဲ့ရရှိပြီးသော ကျောင်းသားများ (All 9 Semesters Passed)</small>
                    </div>
                </div>
                <span class="badge px-3 py-1.5 rounded-pill" style="background:rgba(5,150,105,0.1);color:#059669;border:1px solid rgba(5,150,105,0.25);font-size:0.8rem;font-weight:700;">
                    @completedStudents.Count Graduates
                </span>
            </div>
            @if (completedStudents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:0.9rem;">
                        <thead style="background:rgba(241,245,249,0.6);">
                            <tr>
                                <th style="color:#64748b;font-weight:700;padding:12px 16px;border-bottom:1px solid #e2e8f0;">No.</th>
                                <th style="color:#64748b;font-weight:700;padding:12px 16px;border-bottom:1px solid #e2e8f0;">Roll No</th>
                                <th style="color:#64748b;font-weight:700;padding:12px 16px;border-bottom:1px solid #e2e8f0;">Full Name</th>
                                <th style="color:#64748b;font-weight:700;padding:12px 16px;border-bottom:1px solid #e2e8f0;">Major</th>
                                <th style="color:#64748b;font-weight:700;padding:12px 16px;border-bottom:1px solid #e2e8f0;">Class Year</th>
                                <th style="color:#64748b;font-weight:700;padding:12px 16px;border-bottom:1px solid #e2e8f0;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < completedStudents.Count; i++)
                            {
                                var stu = completedStudents[i];
                                var rowNum = i + 1;
                                <tr style="border-bottom:1px solid #f1f5f9;transition:background 0.15s;">
                                    <td style="padding:12px 16px;color:#94a3b8;font-weight:600;">@rowNum</td>
                                    <td style="padding:12px 16px;color:#0f172a;font-weight:700;">@(stu.CurrentRollNo ?? "-")</td>
                                    <td style="padding:12px 16px;color:#334155;font-weight:600;">@(stu.FullName ?? stu.UserName ?? "-")</td>
                                    <td style="padding:12px 16px;color:#64748b;">@(stu.CurrentMajor ?? "-")</td>
                                    <td style="padding:12px 16px;color:#64748b;">@(stu.CurrentClassYear ?? "-")</td>
                                    <td style="padding:12px 16px;">
                                        <span class="badge rounded-pill" style="background:rgba(245,158,11,0.12);color:#d97706;border:1px solid rgba(245,158,11,0.25);font-size:0.75rem;">
                                            <i class="bi bi-mortarboard me-1"></i>Graduated
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div style="text-align:center;padding:48px 24px;color:#94a3b8;">
                    <i class="bi bi-mortarboard" style="font-size:2.5rem;opacity:0.35;"></i>
                    <p class="mt-3 mb-0 fw-semibold" style="font-size:0.95rem;">No students have completed all 9 semesters yet.</p>
                </div>
            }
        </div>
    </div>
</div>
@* </Authorized>


<NotAuthorized>
                    <div class="alert alert-warning">သင်သည် ဤအချက်အလက်များကို ကြည့်ရှုခွင့်မရှိပါ။</div>
                </NotAuthorized>
    </AuthorizeView>
</div>
</Authorized>
</AuthorizeView> *@
@*
{
    private readonly List<RoleDistributionChartPoint> RoleDistributionData = new();
    private Timer? _timer;
    protected override void OnInitialized()
    {
        // Component စတင်ချိန်တွင် Timer ကို စတင်ပါ
        _timer = new Timer(TimerCallback, null, 0, 5000);
    }

    private async void TimerCallback(object? state)
    {
        await LoadRoleDistributionAsync();

        // UI ကို Update လုပ်ရန်အတွက်
        await InvokeAsync(StateHasChanged);

        // Chart ကို ပြန်ဆွဲရန် JS ကို ခေါ်ပါ
        await JS.InvokeVoidAsync("initCharts", RoleDistributionData);
    }
    public void Dispose()
    {
        _timer?.Dispose(); // Page ပိတ်သွားလျှင် Timer ကို ဖျက်ပစ်ပါ
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("initCharts", RoleDistributionData);
            }
            catch
            {
                await Task.Delay(250);
                await JS.InvokeVoidAsync("initCharts", RoleDistributionData);
            }
        }
    }

    private async Task LoadRoleDistributionAsync()
    {
        RoleDistributionData.Clear();

        try
        {
