@page "/admin/dashboard"
@* @attribute [Authorize(Roles = "Admin")] *@
@layout AdminLayout
@implements IDisposable
@inject IJSRuntime JS
@rendermode InteractiveServer
@using Newtonsoft.Json
@using Smart_Campus_PUMUB.WebApi.Models
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@inject Smart_Campus_PUMUB.BlazorServer.Frontend.Services.HttpClientService HttpClientService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject Smart_Campus_PUMUB.Components.Features.Services.AdminLanguageService LangService
<style>
    .kpi-card-modern {
        background: #ffffff;
        border: 1.5px solid #f1f5f9;
        border-radius: 18px;
        padding: 1.25rem 1.35rem;
        box-shadow: 0 4px 18px -4px rgba(0, 0, 0, 0.04);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .kpi-card-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.08);
    }

    .kpi-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .kpi-theme-sky .kpi-icon-box { background: rgba(56, 189, 248, 0.12); color: #0284c7; }
    .kpi-theme-purple .kpi-icon-box { background: rgba(139, 92, 246, 0.12); color: #7c3aed; }
    .kpi-theme-emerald .kpi-icon-box { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .kpi-theme-rose .kpi-icon-box { background: rgba(244, 63, 94, 0.12); color: #e11d48; }

    .kpi-pill {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .kpi-pill-sky { background: rgba(56, 189, 248, 0.12); color: #0284c7; }
    .kpi-pill-purple { background: rgba(139, 92, 246, 0.12); color: #7c3aed; }
    .kpi-pill-emerald { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .kpi-pill-rose { background: rgba(244, 63, 94, 0.12); color: #e11d48; }

    .kpi-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.5px;
        color: #0f172a;
        margin-top: 0.75rem;
        margin-bottom: 0.2rem;
    }

    .kpi-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #64748b;
    }

    .kpi-pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #e11d48;
        display: inline-block;
        animation: pulseLive 1.5s infinite;
    }

    @@keyframes pulseLive {
        0% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(225, 29, 72, 0); }
        100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); }
    }

    .chart-card-modern {
        background: #ffffff;
        border: 1.5px solid #f1f5f9;
        border-radius: 18px;
        padding: 1.35rem 1.5rem;
        box-shadow: 0 4px 18px -4px rgba(0, 0, 0, 0.04);
    }

    .chart-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

    .chart-header-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .chart-header-icon-cyan { background: rgba(6, 182, 212, 0.1); color: #0891b2; }
    .chart-header-icon-purple { background: rgba(124, 58, 237, 0.1); color: #7c3aed; }
    .chart-header-icon-blue { background: rgba(59, 130, 246, 0.1); color: #2563eb; }
</style>

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; background: rgba(90, 79, 207, 0.08); border: 1.5px solid rgba(90, 79, 207, 0.25);">
                <i class="bi bi-speedometer2 fs-5" style="color: #5A4FCF;"></i>
            </div>
            <div>
                <h3 class="fw-bolder mb-0 text-dark" style="letter-spacing: -0.3px;">
                    @(currentLang == "my" ? "ကွပ်ကဲမှုစင်တာ" : "Command Center")
                </h3>
                <p class="text-muted mb-0 small">
                    @(currentLang == "my" ? "စနစ်တစ်ခုလုံးဆိုင်ရာ ခြုံငုံသုံးသပ်ချက်နှင့် တိုက်ရိုက်အချက်အလက်များ" : "Complete system overview, analytics, and live telemetry")
                </p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <!-- Language Dropdown -->
            <div class="position-relative d-inline-block">
                <button type="button" class="btn btn-white shadow-sm border d-flex align-items-center gap-2 fw-bold"
                        style="border-color: #cbd5e1; border-radius: 10px; padding: 7px 14px; font-size: 0.85rem; color: #1e293b; background: #ffffff;"
                        @onclick="ToggleLangDropdown">
                    <i class="bi bi-translate" style="color: #5A4FCF; font-size: 0.95rem;"></i>
                    <span>@(currentLang == "my" ? "🇲🇲 မြန်မာ" : "🇬🇧 English")</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size: 0.72rem; transition: transform 0.2s ease; transform: @(isLangDropdownOpen ? "rotate(180deg)" : "rotate(0deg)");"></i>
                </button>

                @if (isLangDropdownOpen)
                {
                    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseLangDropdown"></div>
                    <div class="dropdown-menu show shadow-lg border-0 p-1.5"
                         style="position: absolute; right: 0; top: calc(100% + 6px); min-width: 175px; border-radius: 12px; z-index: 1050; background: #ffffff; border: 1px solid #e2e8f0 !important;">
                        <div class="px-2.5 py-1.5 small text-muted fw-bold" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;">
                            @(currentLang == "my" ? "ဘာသာစကား ရွေးချယ်ရန်" : "Select Language")
                        </div>
                        <button type="button" class="dropdown-item d-flex align-items-center justify-content-between rounded-2 px-3 py-2 fw-semibold @(currentLang == "en" ? "active" : "")"
                                style="@(currentLang == "en" ? "background-color: #5A4FCF; color: #ffffff;" : "color: #334155;") font-size: 0.84rem; cursor: pointer;"
                                @onclick='() => SelectLanguage("en")'>
                            <span class="d-flex align-items-center gap-2">
                                <span>🇬🇧</span> English
                            </span>
                            @if (currentLang == "en")
                            {
                                <i class="bi bi-check-lg fw-bold"></i>
                            }
                        </button>
                        <button type="button" class="dropdown-item d-flex align-items-center justify-content-between rounded-2 px-3 py-2 fw-semibold @(currentLang == "my" ? "active" : "")"
                                style="@(currentLang == "my" ? "background-color: #5A4FCF; color: #ffffff;" : "color: #334155;") font-size: 0.84rem; cursor: pointer;"
                                @onclick='() => SelectLanguage("my")'>
                            <span class="d-flex align-items-center gap-2">
                                <span>🇲🇲</span> မြန်မာ
                            </span>
                            @if (currentLang == "my")
                            {
                                <i class="bi bi-check-lg fw-bold"></i>
                            }
                        </button>
                    </div>
                }
            </div>

            <span class="badge px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2" style="background: #ecfdf5; color: #059669; font-weight: 700; border: 1px solid #a7f3d0; font-size: 0.8rem;">
                <span class="d-inline-block rounded-circle bg-success" style="width: 7px; height: 7px;"></span>
                @(currentLang == "my" ? "တိုက်ရိုက်စနစ်အချက်အလက်" : "Live System Telemetry")
            </span>
        </div>
    </div>
</div>

<!-- KPI Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-sky">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-people-fill"></i>
                </div>
                <span class="kpi-pill kpi-pill-sky">
                    <i class="bi bi-person-check-fill"></i> @(currentLang == "my" ? "စာရင်းသွင်းပြီး" : "Enrolled")
                </span>
            </div>
            <div class="kpi-value">@activeStudentCount.ToString("N0")</div>
            <div class="kpi-label">@(currentLang == "my" ? "ကျောင်းသားဦးရေ" : "Active Students")</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-purple">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <span class="kpi-pill kpi-pill-purple">
                    <i class="bi bi-mortarboard-fill"></i> @(currentLang == "my" ? "ဆရာ/ဆရာမ" : "Faculty")
                </span>
            </div>
            <div class="kpi-value">@totalTutorCount</div>
            <div class="kpi-label">@(currentLang == "my" ? "ဆရာ/ဆရာမ ဦးရေ" : "Total Tutors")</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-emerald">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-book-half"></i>
                </div>
                <span class="kpi-pill kpi-pill-emerald">
                    <i class="bi bi-journal-check"></i> @(currentLang == "my" ? "စာကြည့်တိုက်" : "E-Library")
                </span>
            </div>
            <div class="kpi-value">@bookCount.ToString("N0")</div>
            <div class="kpi-label">@(currentLang == "my" ? "စာကြည့်တိုက် စာအုပ်များ" : "Library PDF Files")</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card-modern kpi-theme-rose">
            <div class="d-flex align-items-center justify-content-between">
                <div class="kpi-icon-box">
                    <i class="bi bi-broadcast"></i>
                </div>
                <span class="kpi-pill kpi-pill-rose">
                    <span class="kpi-pulse-dot"></span> @(currentLang == "my" ? "တိုက်ရိုက်မှတ်တမ်း" : "Live Logs")
                </span>
            </div>
            <div class="kpi-value">@activeAlertCount</div>
            <div class="kpi-label">@(currentLang == "my" ? "လုပ်ဆောင်မှု မှတ်တမ်းများ" : "Activity Logs")</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     Charts Row — Highcharts (div-based, Blazor SPA safe)
     ═══════════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">

    <!-- Pie / Donut — Role Distribution -->
    <div class="col-12 col-lg-5">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-cyan">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">@(currentLang == "my" ? "အသုံးပြုသူ အခန်းကဏ္ဍ ခွဲခြမ်းစိတ်ဖြာမှု" : "Role Distribution")</h6>
                        <small class="text-muted" style="font-size:0.75rem;">@(currentLang == "my" ? "အသုံးပြုသူ အခန်းကဏ္ဍအလိုက် စာရင်းဇယား" : "User role breakdown & analysis")</small>
                    </div>
                </div>
                <span class="chart-badge">@(currentLang == "my" ? "၂၀၂၆" : "2026")</span>
            </div>
            <!-- Highcharts renders into this div — NO canvas needed -->
            <div id="hc-pie-chart" style="min-height:260px; width:100%;"></div>
        </div>
    </div>

    <!-- Column — Students by Faculty -->
    <div class="col-12 col-lg-7">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-purple">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">@(currentLang == "my" ? "မဟာဌာနအလိုက် ကျောင်းသားဦးရေ" : "Students by Faculty")</h6>
                        <small class="text-muted" style="font-size:0.75rem;">@(currentLang == "my" ? "ပညာသင်နှစ်အလိုက် ကျောင်းသားအရေအတွက် နှိုင်းယှဉ်ချက်" : "FC & FE student count comparison by academic year")</small>
                    </div>
                </div>
                <span class="chart-badge">@(currentLang == "my" ? "မဟာဌာနများ" : "FC & FE")</span>
            </div>
            <!-- Highcharts renders into this div — NO canvas needed -->
            <div id="hc-bar-chart" style="min-height:260px; width:100%;"></div>
        </div>
    </div>

</div>

<!-- Quick Stats Row -->
<div class="row g-3">
    <!-- Recent Activity -->
    <div class="col-12 col-md-6">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-blue">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">@(currentLang == "my" ? "လတ်တလော လှုပ်ရှားမှုများ" : "Recent Activity")</h6>
                        <small class="text-muted" style="font-size:0.75rem;">@(currentLang == "my" ? "နောက်ဆုံး လုပ်ဆောင်မှုမှတ်တမ်း (၆) ခု" : "Latest activity logs (Latest 6)")</small>
                    </div>
                </div>
            </div>
            <ul class="list-unstyled mb-0">
                @if (recentActivities != null && recentActivities.Any())
                {
                    @foreach (var activity in recentActivities.Take(6))
                    {
                        <li class="d-flex align-items-center gap-3 py-2.5 border-bottom"
                            @onclick="() => activity.IsExpanded = !activity.IsExpanded" style="cursor: pointer; border-color: #f1f5f9 !important;">

                            <span class="stat-icon flex-shrink-0"
                                  style="width:38px;height:38px;background:rgba(90,79,207,0.08);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                                <i class="bi @activity.Icon @GetIconColor(activity.ActivityTitle)" style="font-size:1.1rem;"></i>
                            </span>

                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <p class="mb-0 fw-bold small text-truncate text-dark">@activity.ActivityTitle</p>
                                    <span class="badge bg-light text-secondary border flex-shrink-0" style="font-size: 0.65rem; padding: 2px 6px;">
                                        <i class="bi bi-person-fill me-1"></i>@(currentLang == "my" ? (activity.CreatedBy == "Admin" || string.IsNullOrWhiteSpace(activity.CreatedBy) ? "စီမံခန့်ခွဲသူ" : activity.CreatedBy) : (string.IsNullOrWhiteSpace(activity.CreatedBy) ? "Admin" : activity.CreatedBy))
                                    </span>
                                </div>

                                @if (activity.IsExpanded)
                                {
                                    <p class="mb-0 text-muted" style="font-size:0.78rem; white-space: normal; word-break: break-word;">
                                        @activity.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="mb-0 text-muted"
                                       style="font-size:0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px;">
                                        @activity.Description
                                    </p>
                                }
                            </div>
                            <div class="text-end flex-shrink-0 ms-2">
                                <small class="text-muted d-block" style="font-size: 0.72rem; font-weight: 500;">
                                    <i class="bi bi-calendar3 me-1"></i>@(activity.CreatedDateTime != default ? activity.CreatedDateTime.ToString("dd/MM/yyyy") : "")
                                </small>
                                <small class="text-muted d-block" style="font-size: 0.68rem;">
                                    <i class="bi bi-clock me-1"></i>@(activity.CreatedDateTime != default ? activity.CreatedDateTime.ToString("hh:mm tt") : "")
                                </small>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="p-4 text-center text-muted small">@(currentLang == "my" ? "လတ်တလော လှုပ်ရှားမှုမှတ်တမ်း မရှိသေးပါ။" : "No recent activity found.")</li>
                }
            </ul>
        </div>
    </div>

    <!-- System Summary -->
    <div class="col-12 col-md-6">
        <div class="chart-card-modern h-100">
            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon chart-header-icon-purple">
                        <i class="bi bi-grid-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">@(currentLang == "my" ? "စနစ်ဆိုင်ရာ အကျဉ်းချုပ်" : "System Summary")</h6>
                        <small class="text-muted" style="font-size:0.75rem;">@(currentLang == "my" ? "စနစ်အတွင်းရှိ ဌာန၊ ဘာသာရပ်နှင့် စည်းမျဉ်းများ စုစုပေါင်း" : "Overview of registered campus entities")</small>
                    </div>
                </div>
            </div>
            <div class="row g-2.5">
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(2,132,199,0.06);border:1px solid rgba(2,132,199,0.15);">
                        <div class="fw-bolder fs-4" style="color:#0284c7;">@summary.Faculties</div>
                        <div class="text-muted small fw-semibold">@(currentLang == "my" ? "မဟာဌာန" : "Faculties")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(124,58,237,0.06);border:1px solid rgba(124,58,237,0.15);">
                        <div class="fw-bolder fs-4" style="color:#7c3aed;">@summary.Departments</div>
                        <div class="text-muted small fw-semibold">@(currentLang == "my" ? "ဌာနများ" : "Departments")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(5,150,105,0.06);border:1px solid rgba(5,150,105,0.15);">
                        <div class="fw-bolder fs-4" style="color:#059669;">@summary.Subjects</div>
                        <div class="text-muted small fw-semibold">@(currentLang == "my" ? "ဘာသာရပ်များ" : "Subjects")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15);">
                        <div class="fw-bolder fs-4" style="color:#d97706;">@summary.Semesters</div>
                        <div class="text-muted small fw-semibold">@(currentLang == "my" ? "စာသင်နှစ်ဝက်များ" : "Semesters")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(225,29,72,0.06);border:1px solid rgba(225,29,72,0.15);">
                        <div class="fw-bolder fs-4" style="color:#e11d48;">@summary.Positions</div>
                        <div class="text-muted small fw-semibold">@(currentLang == "my" ? "ရာထူးများ" : "Positions")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 rounded-3 text-center"
                         style="background:rgba(90,79,207,0.06);border:1px solid rgba(90,79,207,0.15);">
                        <div class="fw-bolder fs-4" style="color:#5A4FCF;">@summary.Rules</div>
                        <div class="text-muted small fw-semibold">@(currentLang == "my" ? "စည်းမျဉ်းများ" : "Rules")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Completed Students Section -->
<div class="row g-3 mb-4 mt-2">
    <div class="col-12">
        <div class="chart-card-modern">
            <div class="chart-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="chart-header-icon" style="background:rgba(245,158,11,0.12);color:#d97706;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div>
                        <h6 class="chart-header-title mb-0">@(currentLang == "my" ? "ဘွဲ့ရရှိပြီးသော ကျောင်းသားများ" : "Completed Students")</h6>
