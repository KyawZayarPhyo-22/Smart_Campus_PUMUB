@page "/admin/book/create"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Book
@using Smart_Campus_PUMUB.WebApi.Models
@rendermode InteractiveServer

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div style="width: 100%; max-width: 560px;">

        <div class="mb-4 text-center">
            <h3 class="fw-bold text-white">
                <i class="bi bi-book-half me-2 text-primary"></i>Add New Book
            </h3>
        </div>

        <div class="tech-card p-4">
            <EditForm Model="bookRequest" OnValidSubmit="SaveBook">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label text-light">Category</label>
                    <InputSelect @bind-Value="bookRequest.CategoryId" class="form-select">
                        <option value="0">-- Select Category --</option>
                        @foreach (var cat in CategoryList)
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => bookRequest.CategoryId)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Book Name</label>
                    <InputText @bind-Value="bookRequest.BookName" class="form-control" placeholder="Enter Book Title" />
                    <ValidationMessage For="@(() => bookRequest.BookName)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">
                        <i class="bi bi-file-earmark-pdf text-danger me-1"></i>Book PDF File
                    </label>
                    <InputFile OnChange="HandlePdfSelected" class="form-control" accept=".pdf" />
                    @if (!string.IsNullOrEmpty(PdfFileName))
                    {
                        <div class="mt-2 small text-success">
                            <i class="bi bi-check-circle me-1"></i>@PdfFileName
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label text-light">Book Cover Image</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    @if (!string.IsNullOrEmpty(PreviewImageUrl))
                    {
                        <div class="mt-2 text-center">
                            <img src="@PreviewImageUrl" class="rounded img-thumbnail" style="max-height: 150px; object-fit: cover;" />
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert @(isProcessing ? "alert-info" : "alert-danger") py-2 small">
                        @statusMessage
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-2">
                    <NavLink href="/admin/books" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </NavLink>
                    <button type="submit" class="btn btn-primary px-4" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @(isProcessing ? "Saving..." : "Create Book")
                    </button>
                </div>

            </EditForm>
        </div>

    </div>
</div>