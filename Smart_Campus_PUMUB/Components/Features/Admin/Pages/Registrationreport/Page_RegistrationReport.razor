@page "/admin/reports"
@layout AdminLayout
@rendermode InteractiveServer

<style>
    .material-card {
        background-color: #1e1e2d;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .material-input {
        background-color: #2b2b40;
        border: 1px solid #323248;
        color: #e4e6ef;
        border-radius: 10px;
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

        .material-input:focus {
            background-color: #323248;
            border-color: #696cff;
            box-shadow: 0 0 0 0.25rem rgba(105, 108, 255, 0.25);
            color: #ffffff;
            outline: none;
        }

    .table-container {
        border-radius: 16px;
        overflow: hidden;
    }

    .custom-table {
        margin-bottom: 0;
        background-color: transparent;
        color: #cdcdde;
    }

        .custom-table thead th {
            background-color: #1a1a27;
            color: #a1a5b7;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 1.2rem 1rem;
            border-bottom: 2px solid #2b2b40;
        }

        .custom-table tbody tr {
            border-bottom: 1px solid #2b2b40;
            transition: all 0.2s ease;
        }

            .custom-table tbody tr:hover {
                background-color: rgba(255, 255, 255, 0.03);
            }

        .custom-table td {
            padding: 1rem;
            vertical-align: middle;
            border: none;
        }

    .nav-tabs-custom .nav-link {
        color: #a1a5b7;
        border: none;
        border-bottom: 3px solid transparent;
        font-weight: 600;
        padding: 1rem 1.5rem;
        transition: all 0.3s;
        cursor: pointer;
    }

        .nav-tabs-custom .nav-link.active {
            color: #696cff;
            background: transparent;
            border-bottom: 3px solid #696cff;
        }

    .btn-action {
        border-radius: 8px;
        font-weight: 500;
        padding: 0.5rem 1.2rem;
        transition: all 0.3s;
    }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
        }

    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        max-height: 228px;
        overflow-y: auto;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        padding: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .dropdown-item-custom {
        padding: 8px 12px;
        font-size: 0.88rem;
        font-weight: 500;
        color: #374151;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 36px;
    }

    .dropdown-item-custom:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
        font-weight: 600;
    }

    .dropdown-item-custom.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        .printable-area, .printable-area * {
            visibility: visible;
        }

        .printable-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
        }

        .material-card {
            box-shadow: none;
            border: none;
        }

        .custom-table th {
            background-color: #f8f9fa !important;
            color: #000 !important;
        }

        .custom-table td {
            color: #000 !important;
            border-bottom: 1px solid #ddd !important;
        }
    }
</style>

@if (isAdmSemesterDropdownOpen || isAdmMajorDropdownOpen || isAdmStatusDropdownOpen || isPaySemesterDropdownOpen || isPayMethodDropdownOpen || isPayStatusDropdownOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseAllDropdowns"></div>
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2 no-print">
    <div class="d-flex align-items-center">
        <div class="rounded p-2 me-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: transparent; border: 1.5px solid #5A4FCF;">
            <i class="bi bi-file-earmark-bar-graph fs-5" style="color: #5A4FCF;"></i>
        </div>
        <div>
            <h4 class="fw-bolder text-white mb-0" style="letter-spacing: 0.5px;">System Reports</h4>
            <small class="text-secondary">ကျောင်းအပ်နှံမှုနှင့် ငွေပေးချေမှုဆိုင်ရာ အစီရင်ခံစာများ</small>
        </div>
    </div>

    <div>
        <button class="btn btn-secondary btn-action me-2 fw-bold" @onclick="PrintReport">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <button class="btn btn-success btn-action fw-bold" @onclick="@(ActiveTab == 1 ? ExportAdmissionToExcel : ExportPaymentToExcel)">
            <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
        </button>
    </div>
</div>

<div class="material-card mb-4 no-print">
    <ul class="nav nav-tabs nav-tabs-custom border-0 d-flex">
        <li class="nav-item">
            <a class="nav-link fw-bold @(ActiveTab == 1 ? "active" : "")" @onclick="() => ActiveTab = 1">
                <i class="bi bi-person-check me-2"></i> Admission Report
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-bold @(ActiveTab == 2 ? "active" : "")" @onclick="() => ActiveTab = 2">
                <i class="bi bi-wallet2 me-2"></i> Payment Report
            </a>
        </li>
    </ul>
</div>

@if (ActiveTab == 1)
{
    <div class="material-card p-4 mb-4 no-print" style="position: relative; z-index: 1045;">
        <div class="row g-3 align-items-end">
            <div class="col-xl-4 col-lg-4 col-md-6">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Date Range Filter</label>
                <div class="d-flex align-items-center gap-2">
                    <input type="date" class="form-control material-input flex-fill" style="padding: 0.55rem 0.6rem; font-size: 0.85rem;" @bind="AdmFromDate" />
                    <span class="fw-bold" style="color: #000000 !important;">~</span>
                    <input type="date" class="form-control material-input flex-fill" style="padding: 0.55rem 0.6rem; font-size: 0.85rem;" @bind="AdmToDate" />
                </div>
            </div>

            <!-- Semester Filter (was Academic Year) -->
            <div class="col-xl-2 col-lg-2 col-md-3">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Semester</label>
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="ToggleAdmSemesterDropdown" style="background-color: #ffffff; color: #374151; border-color: #e5e7eb;">
                        <span class="text-truncate">@(AdmSelectedYear == "All" ? "All Semesters" : AdmSelectedYear)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isAdmSemesterDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(AdmSelectedYear == "All" ? "selected" : "")" 
                                 @onclick='() => SelectAdmSemester("All")'>
                                <span>All Semesters</span>
                                @if (AdmSelectedYear == "All") { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var lvl in RawStudentList.Select(s => s.AcademicYearLevel).Distinct().Where(l => !string.IsNullOrEmpty(l)))
                            {
                                var currentLvl = lvl!;
                                <div class="dropdown-item-custom @(AdmSelectedYear == currentLvl ? "selected" : "")" 
                                     @onclick='() => SelectAdmSemester(currentLvl)'>
                                    <span>@currentLvl</span>
                                    @if (AdmSelectedYear == currentLvl) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Major Filter -->
            <div class="col-xl-2 col-lg-2 col-md-3">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Major</label>
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="ToggleAdmMajorDropdown" style="background-color: #ffffff; color: #374151; border-color: #e5e7eb;">
                        <span class="text-truncate">@(AdmSelectedMajor == "All" ? "All Majors" : AdmSelectedMajor)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isAdmMajorDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(AdmSelectedMajor == "All" ? "selected" : "")" 
                                 @onclick='() => SelectAdmMajor("All")'>
                                <span>All Majors</span>
                                @if (AdmSelectedMajor == "All") { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var maj in RawStudentList.Select(s => s.Major).Distinct().Where(l => !string.IsNullOrEmpty(l)))
                            {
                                var currentMaj = maj!;
                                <div class="dropdown-item-custom @(AdmSelectedMajor == currentMaj ? "selected" : "")" 
                                     @onclick='() => SelectAdmMajor(currentMaj)'>
                                    <span>@currentMaj</span>
                                    @if (AdmSelectedMajor == currentMaj) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Status Filter -->
            <div class="col-xl-2 col-lg-2 col-md-6">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Status</label>
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="ToggleAdmStatusDropdown" style="background-color: #ffffff; color: #374151; border-color: #e5e7eb;">
                        <span class="text-truncate">@(AdmSelectedStatus == "All" ? "All" : AdmSelectedStatus)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isAdmStatusDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(AdmSelectedStatus == "All" ? "selected" : "")" 
                                 @onclick='() => SelectAdmStatus("All")'>
                                <span>All</span>
                                @if (AdmSelectedStatus == "All") { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var st in new[] { "Approved", "Pending", "Rejected" })
                            {
                                <div class="dropdown-item-custom @(AdmSelectedStatus == st ? "selected" : "")" 
                                     @onclick='() => SelectAdmStatus(st)'>
                                    <span>@st</span>
                                    @if (AdmSelectedStatus == st) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary w-50 d-flex align-items-center justify-content-center" style="height: 38px;" type="button" @onclick="ApplyAdmissionFilter" title="Search">
                        <i class="bi bi-search"></i>
                    </button>
                    <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" style="height: 38px;" type="button" @onclick="ResetAdmissionFilter" title="Reset">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="material-card table-container printable-area mb-5">
        @if (IsLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 fw-bold" style="color: #000000 !important; font-size: 0.95rem;">Admission Report ဒေတာများကို ဆွဲယူနေပါသည်...</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table custom-table align-middle">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">No.</th>
                            <th class="fw-bold">Admission Date</th>
                            <th class="fw-bold">Roll No</th>
                            <th class="fw-bold">Name</th>
                            <th class="fw-bold">Major</th>
                            <th class="fw-bold">Semester</th>
                            <th class="text-center fw-bold">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = (CurrentPageAdm - 1) * PageSize + 1;
                        }
                        @foreach (var s in AdmissionReportData)
                        {
                            var currentStatus = string.IsNullOrEmpty(s.Status) ? "Pending" : s.Status;
                            <tr style="font-size: 0.9rem;">
                                <td class="text-center text-muted fw-bold">@count.ToString("D2")</td>
                                <td class="fw-bold text-white"><i class="bi bi-calendar-check me-2 text-muted"></i>@s.CreatedDatetime.ToString("dd-MM-yyyy")</td>
                                <td class="fw-bold text-info"><code class="text-info fw-bold">@s.RollNo</code></td>
                                <td class="text-white fw-bold">@s.StudentNameMm</td>
                                <td class="fw-bold text-white">@s.Major</td>
                                <td><span class="badge rounded-pill fw-bold" style="background: #4F46E5; color: #ffffff !important; font-size: 0.82rem; padding: 6px 12px; letter-spacing: 0.3px;">@s.AcademicYearLevel</span></td>
                                <td class="text-center">
                                    <span class="badge px-2 py-1 fw-bold @(currentStatus == "Approved" ? "bg-success text-white" : currentStatus == "Rejected" ? "bg-danger text-white" : "bg-warning text-dark")" style="border-radius: 6px;">
                                        @currentStatus
                                    </span>
                                </td>
                            </tr>
                            count++;
                        }

                        <tr style="background-color: #1a1a27; font-size: 0.9rem;" class="fw-bold">
                            <td colspan="7" class="text-center py-3">
                                <span class="me-4 text-info fw-bold"><i class="bi bi-people me-1"></i> Total Registrations: <strong class="text-white">@TotalRegistrations</strong></span>
                                <span class="me-4 text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Approved: <strong class="text-white">@TotalApprovedReg</strong></span>
                                <span class="text-danger fw-bold"><i class="bi bi-x-circle me-1"></i> Rejected: <strong class="text-white">@TotalRejectedReg</strong></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="p-3 no-print">
                <PaginationComponent CurrentPage="CurrentPageAdm" TotalPages="TotalPagesAdm" OnPageChanged="OnPageChangedAdm" />
            </div>
        }
    </div>
}

@if (ActiveTab == 2)
{
    <div class="material-card p-4 mb-4 no-print" style="position: relative; z-index: 1045;">
        <div class="row g-3 align-items-end">
            <div class="col-xl-4 col-lg-4 col-md-6">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Date Range Filter</label>
                <div class="d-flex align-items-center gap-2">
                    <input type="date" class="form-control material-input flex-fill" style="padding: 0.55rem 0.6rem; font-size: 0.85rem;" @bind="PayFromDate" />
                    <span class="fw-bold" style="color: #000000 !important;">~</span>
                    <input type="date" class="form-control material-input flex-fill" style="padding: 0.55rem 0.6rem; font-size: 0.85rem;" @bind="PayToDate" />
                </div>
            </div>

            <!-- Semester Filter -->
            <div class="col-xl-2 col-lg-2 col-md-3">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Semester</label>
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="TogglePaySemesterDropdown" style="background-color: #ffffff; color: #374151; border-color: #e5e7eb;">
                        <span class="text-truncate">@(PaySelectedYear == "All" ? "All Semesters" : PaySelectedYear)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isPaySemesterDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(PaySelectedYear == "All" ? "selected" : "")" 
                                 @onclick='() => SelectPaySemester("All")'>
                                <span>All Semesters</span>
                                @if (PaySelectedYear == "All") { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var lvl in RawStudentList.Select(s => s.AcademicYearLevel).Distinct().Where(l => !string.IsNullOrEmpty(l)))
                            {
                                var currentLvl = lvl!;
                                <div class="dropdown-item-custom @(PaySelectedYear == currentLvl ? "selected" : "")" 
                                     @onclick='() => SelectPaySemester(currentLvl)'>
                                    <span>@currentLvl</span>
                                    @if (PaySelectedYear == currentLvl) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Method Filter -->
            <div class="col-xl-2 col-lg-2 col-md-3">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Payment Method</label>
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="TogglePayMethodDropdown" style="background-color: #ffffff; color: #374151; border-color: #e5e7eb;">
                        <span class="text-truncate">@(PaySelectedMethod == "All" ? "All Methods" : PaySelectedMethod)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isPayMethodDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(PaySelectedMethod == "All" ? "selected" : "")" 
                                 @onclick='() => SelectPayMethod("All")'>
                                <span>All Methods</span>
                                @if (PaySelectedMethod == "All") { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var meth in new[] { "KBZPay", "WavePay", "Cash" })
                            {
                                <div class="dropdown-item-custom @(PaySelectedMethod == meth ? "selected" : "")" 
                                     @onclick='() => SelectPayMethod(meth)'>
                                    <span>@meth</span>
                                    @if (PaySelectedMethod == meth) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Status Filter -->
            <div class="col-xl-2 col-lg-2 col-md-6">
                <label class="small mb-2 fw-bold text-uppercase" style="color: #000000 !important;">Status</label>
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="TogglePayStatusDropdown" style="background-color: #ffffff; color: #374151; border-color: #e5e7eb;">
                        <span class="text-truncate">@(PaySelectedStatus == "All" ? "All" : PaySelectedStatus)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isPayStatusDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(PaySelectedStatus == "All" ? "selected" : "")" 
                                 @onclick='() => SelectPayStatus("All")'>
                                <span>All</span>
                                @if (PaySelectedStatus == "All") { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var st in new[] { "Approved", "Pending", "Rejected" })
                            {
                                <div class="dropdown-item-custom @(PaySelectedStatus == st ? "selected" : "")" 
                                 @onclick='() => SelectPayStatus(st)'>
                                    <span>@st</span>
                                    @if (PaySelectedStatus == st) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary w-50 d-flex align-items-center justify-content-center" style="height: 38px;" type="button" @onclick="ApplyPaymentFilter" title="Search">
                        <i class="bi bi-search"></i>
                    </button>
                    <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" style="height: 38px;" type="button" @onclick="ResetPaymentFilter" title="Reset">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="material-card table-container printable-area mb-5">
        @if (IsLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 fw-bold" style="color: #000000 !important; font-size: 0.95rem;">Payment Report ဒေတာများကို ဆွဲယူနေပါသည်...</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table custom-table align-middle">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">No.</th>
                            <th class="fw-bold">Date</th>
                            <th class="fw-bold">Roll No</th>
                            <th class="fw-bold">Name</th>
                            <th class="fw-bold">Method</th>
                            <th class="text-end fw-bold">Amount Paid</th>
                            <th class="text-center fw-bold">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = (CurrentPagePay - 1) * PageSize + 1;
                            decimal totalAmount = 0;
                        }
                        @foreach (var p in PaymentReportData)
                        {
                            totalAmount += p.AmountPaid;
                            <tr style="font-size: 0.9rem;">
                                <td class="text-center text-muted fw-bold">@count.ToString("D2")</td>
                                <td class="fw-bold text-white"><i class="bi bi-calendar-event me-2 text-muted"></i>@p.PaymentDate.ToString("dd-MM-yyyy")</td>
                                <td class="fw-bold text-info"><code class="text-info fw-bold">@p.RollNo</code></td>
                                <td class="text-white fw-bold">
                                    @p.StudentName
                                    <span class="d-block text-muted fw-bold mt-1" style="font-size: 0.8rem;">@p.Major | @p.AcademicYear</span>
                                </td>
                                <td class="fw-bold text-white">@p.PaymentMethod</td>
                                <td class="text-end text-success fw-bold">@p.AmountPaid.ToString("N0") <span class="text-muted fw-bold" style="font-size: 0.8rem;">MMK</span></td>
                                <td class="text-center">
                                    <span class="badge px-2 py-1 fw-bold @(p.Status == "Approved" ? "bg-success text-white" : p.Status == "Rejected" ? "bg-danger text-white" : "bg-warning text-dark")" style="border-radius: 6px;">
                                        @p.Status
                                    </span>
                                </td>
                            </tr>
                            count++;
                        }

                        <tr style="background-color: #1a1a27; font-size: 0.9rem;" class="fw-bold">
                            <td colspan="4" class="py-3 ps-4">
                                <span class="me-4 text-info fw-bold"><i class="bi bi-wallet2 me-1"></i> Total: <strong class="text-white">@TotalPayments</strong></span>
                                <span class="me-4 text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Approved: <strong class="text-white">@TotalApprovedPay</strong></span>
                                <span class="text-danger fw-bold"><i class="bi bi-x-circle me-1"></i> Rejected: <strong class="text-white">@TotalRejectedPay</strong></span>
                            </td>
                            <td colspan="3" class="text-end py-3 pe-4">
                                <span class="text-white fw-bold text-uppercase me-2" style="font-size: 0.8rem; letter-spacing: 1px;">Total Revenue:</span>
                                <span class="text-success fw-bold fs-5">@TotalRevenue.ToString("N0") <span class="text-muted fw-bold" style="font-size: 0.8rem;">MMK</span></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="p-3 no-print">
                <PaginationComponent CurrentPage="CurrentPagePay" TotalPages="TotalPagesPay" OnPageChanged="OnPageChangedPay" />
            </div>
        }
    </div>
}

<script>
    window.downloadFileFromBase64 = function(filename, contentType, content) {
        const link = document.createElement('a');
        link.download = filename;
        link.href = `data:${contentType};base64,${content}`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    window.printReportWindow = function() {
        window.print();
    }
</script>