@page "/admin/majors"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Major
@using Smart_Campus_PUMUB.WebApi.Models
@rendermode InteractiveServer

<PageTitle>Major Directory</PageTitle>

<style>
    .custom-table {
        background: rgba(20, 24, 33, 0.6);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

        .custom-table thead {
            background: rgba(13, 110, 253, 0.1);
            border-bottom: 2px solid rgba(13, 110, 253, 0.2);
        }

        .custom-table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            color: #0d6efd;
            padding: 16px 20px;
        }

        .custom-table td {
            padding: 16px 20px;
            color: #e2e8f0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

    .table-row-hover:hover {
        background: rgba(255, 255, 255, 0.02);
        box-shadow: inset 4px 0 0 #0d6efd;
    }

    .btn-action-edit {
        background: rgba(13, 110, 253, 0.1);
        color: #39b5ff;
        border: 1px solid rgba(13, 110, 253, 0.3);
        border-radius: 6px;
        padding: 6px 14px;
        transition: all 0.2s ease;
    }

        .btn-action-edit:hover {
            background: #0d6efd;
            color: #ffffff;
        }

    .btn-action-delete {
        background: rgba(220, 53, 69, 0.1);
        color: #ff6b6b;
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 6px;
        padding: 6px 14px;
        transition: all 0.2s ease;
    }

        .btn-action-delete:hover {
            background: #dc3545;
            color: #ffffff;
        }

    .badge-faculty {
        background: rgba(90, 79, 207, 0.12) !important;
        color: #1e1b4b !important;
        border: 1px solid rgba(90, 79, 207, 0.3) !important;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.84rem;
        font-weight: 700;
        display: inline-block;
    }

    .search-input {
        padding-left: 2.6rem !important;
    }

    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        max-height: 228px; /* Approximately 6 items */
        overflow-y: auto;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        padding: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .dropdown-item-custom {
        padding: 8px 12px;
        font-size: 0.88rem;
        font-weight: 500;
        color: #374151;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 36px;
    }

    .dropdown-item-custom:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
        font-weight: 600;
    }

    .dropdown-item-custom.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }
</style>

@if (isFacultyDropdownOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseAllDropdowns"></div>
}

<div class="tab-pane fade show active" id="v-pills-major">
    <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
        <div class="d-flex align-items-center">
            <div class="rounded p-2 me-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: transparent; border: 1.5px solid #5A4FCF;">
                <i class="bi bi-collection fs-5" style="color: #5A4FCF;"></i>
            </div>
            <div>
                <h4 class="fw-bolder text-white mb-0" style="letter-spacing: 0.5px;">Major Directory</h4>
                <small class="text-secondary">တက္ကသိုလ်အထူးပြုဘာသာရပ်များနှင့် သင်ရိုးများ စီမံခန့်ခွဲခြင်း</small>
            </div>
        </div>
    </div>

    <!-- 🔹 Filter Section -->
    <div class="material-card p-3 mb-4" style="position: relative; z-index: 1045;">
        <div class="row g-3 align-items-center">
            <!-- Search Input -->
            <div class="col">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute text-muted" style="top: 50%; left: 14px; transform: translateY(-50%); pointer-events: none; z-index: 5; font-size: 0.9rem;"></i>
                    <input type="text" class="form-control material-input search-input w-100" style="padding-left: 2.6rem !important;" placeholder="Search by Major Name or Faculty..." @bind="SearchInput" @onkeyup="HandleKeyUp" />
                </div>
            </div>

            <!-- Faculty Filter (approx 6 items height with scroll) -->
            <div class="col-md-3">
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="ToggleFacultyDropdown">
                        <span class="text-truncate">@GetSelectedFacultyName()</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isFacultyDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(string.IsNullOrEmpty(FacultyFilter) ? "selected" : "")" 
                                 @onclick='() => SelectFaculty("")'>
                                <span>All Faculties</span>
                                @if (string.IsNullOrEmpty(FacultyFilter)) { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var faculty in FacultyList)
                            {
                                <div class="dropdown-item-custom @(FacultyFilter == faculty.FacultyId.ToString() ? "selected" : "")" 
                                     @onclick='() => SelectFaculty(faculty.FacultyId.ToString())'>
                                    <span>@faculty.FacultyName</span>
                                    @if (FacultyFilter == faculty.FacultyId.ToString()) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Search and Reset Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary w-50 d-flex align-items-center justify-content-center" type="button" @onclick="ApplyFilter" title="Search">
                    <i class="bi bi-search"></i>
                </button>
                <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" type="button" @onclick="ResetFilter" title="Reset">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <!-- Add Button -->
            <div class="col-auto">
                <NavLink href="/admin/major/create" class="btn btn-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 38px;" title="Add Major">
                    <i class="bi bi-plus-lg"></i>
                </NavLink>
            </div>
        </div>
    </div>

    <div class="tech-card p-4">

        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="text-dark mt-3 small fw-bold">Major စာရင်းများကို ဆွဲယူနေပါသည်...</div>
            </div>
        }
        else
        {
            <div class="table-responsive custom-table">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 10%;">No.</th>
                            <th style="width: 45%;">Major Name</th>
                            <th style="width: 25%;">Faculty</th>
                            <th style="width: 20%; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = (CurrentPage - 1) * PageSize + 1;
                        }
                        @foreach (var major in FilteredMajors)
                        {
                            <tr class="table-row-hover">
                                <td class="fw-bold text-dark">@count.ToString("D2")</td>
                                <td class="fw-bold text-dark">@major.MajorName</td>
                                <td><span class="badge-faculty" style="background: rgba(90, 79, 207, 0.12) !important; color: #1e1b4b !important; border: 1px solid rgba(90, 79, 207, 0.3) !important; border-radius: 20px; padding: 4px 14px; font-size: 0.84rem; font-weight: 700; display: inline-block;">@major.FacultyName</span></td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <NavLink href="@($"/admin/major/edit/{major.MajorId}")" class="btn btn-action-edit"><i class="bi bi-pencil me-1"></i> Edit</NavLink>
                                        <button class="btn btn-action-delete" @onclick="() => OpenDeleteModal(major)"><i class="bi bi-trash me-1"></i> Delete</button>
                                    </div>
                                </td>
                            </tr>
                            count++;
                        }

                        @if (!FilteredMajors.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-dark fw-bold py-4" style="text-align: center !important;">
                                    <div class="d-flex flex-column align-items-center justify-content-center w-100">
                                        <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                        <span>Major မရှိသေးပါ သို့မဟုတ် ရှာဖွေမှုမတွေ့ပါ။</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
        }
    </div>
</div>

@* Delete Confirmation Modal *@
@if (ShowModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tech-card">

                <div class="modal-header border-0 pb-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded p-2" style="background: rgba(220,53,69,0.15);">
                            <i class="bi bi-exclamation-triangle text-danger fs-5"></i>
                        </div>
                        <h5 class="text-danger mb-0 fw-bold">Delete Major</h5>
                    </div>
                </div>

                <div class="modal-body text-center pt-2">
                    <p class="text-white mb-1">Are you sure you want to delete</p>
                    <p class="fw-bold fs-6" style="color:#a78bfa;">@SelectedMajor?.MajorName</p>
                    <p class="text-muted small">This action cannot be undone.</p>

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="mt-3 p-3 rounded"
                             style="background: @(IsSuccess ? "rgba(25, 135, 84, 0.15)" : "rgba(220, 53, 69, 0.15)");
                            border: 1px solid @(IsSuccess ? "#198754" : "#dc3545");">
                            <span style="color: @(IsSuccess ? "#75b798" : "#ea868f"); font-size: 0.9rem;">
                                <i class="bi @(IsSuccess ? "bi-check-circle" : "bi-exclamation-circle") me-2"></i>
                                @statusMessage
                            </span>
                        </div>
                    }
                </div>

                <div class="modal-footer border-0">
                    <button class="btn btn-secondary"
                            @onclick="CloseDeleteModal"
                            disabled="@IsProcessing">
                        Cancel
                    </button>

                    <button class="btn btn-danger"
                            @onclick="DeleteMajor"
                            disabled="@(IsProcessing || IsSuccess)">
                        @(IsProcessing ? "Deleting..." : "Yes, Delete")
                    </button>
                </div>

            </div>
        </div>
    </div>
}
