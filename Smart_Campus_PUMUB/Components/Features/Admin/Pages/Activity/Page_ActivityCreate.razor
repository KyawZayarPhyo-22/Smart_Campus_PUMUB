@page "/admin/activity/create"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Activity
@using Smart_Campus_PUMUB.WebApi.Models
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<AuthorizeView Policy="Activity.Create" Context="authContext">
    <Authorized>
        <div class="modal-dialog modal-lg mt-4">
            <div class="modal-content tech-card shadow-lg" style="border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="modal-header border-0 pb-0 pt-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background: rgba(13, 110, 253, 0.12); width: 40px; height: 40px;">
                            <i class="bi bi-calendar-plus fs-5 text-primary"></i>
                        </div>
                        <h5 class="modal-title fw-bold mb-0 text-white">Add New Activity</h5>
                    </div>
                    <NavLink href="/admin/activities" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-x-lg"></i>
                    </NavLink>
                </div>

                <EditForm Model="activityModel" OnValidSubmit="SaveActivity" FormName="CreateActivityForm">
                    <DataAnnotationsValidator />
                    <div class="modal-body px-4 py-3">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label text-light fw-semibold">Activity Title <span class="text-danger">*</span></label>
                                <InputText @bind-Value="activityModel.ActivityTitle" class="form-control" placeholder="Enter Activity Title" required />
                            </div>
                            
                            <div class="col-md-5">
                                <label class="form-label text-light fw-semibold">Activity Date (ကျင်းပသည့်ရက်စွဲ) <span class="text-danger">*</span></label>
                                <InputDate @bind-Value="activityModel.ActivityDate" class="form-control" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-light fw-semibold">Location</label>
                                <InputText @bind-Value="activityModel.Location" class="form-control" placeholder="e.g. Main Hall, Campus Sports Ground" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-light fw-semibold">Description</label>
                                <InputTextArea @bind-Value="activityModel.Description" class="form-control" rows="4" placeholder="Enter detailed description of the activity..." />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-light fw-semibold d-flex justify-content-between align-items-center">
                                    <span>Activity Images (ပုံများစွာ ရွေးချယ်နိုင်ပါသည်)</span>
                                    <small class="text-muted">JPG, PNG, WEBP (Max 5MB each)</small>
                                </label>
                                
                                <div class="upload-dropzone p-3 rounded-3 text-center mb-3" style="border: 2px dashed rgba(13, 110, 253, 0.4); background: rgba(13, 110, 253, 0.04); cursor: pointer; position: relative;">
                                    <i class="bi bi-cloud-arrow-up fs-2 text-primary d-block mb-1"></i>
                                    <span class="text-light fw-semibold">Click to browse or drag and drop images</span>
                                    <p class="text-muted small mb-0 mt-1">Select one or multiple photos to upload</p>
                                    <InputFile OnChange="HandleFilesSelected" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer;" accept=".jpg,.jpeg,.png,.webp" multiple />
                                </div>

                                @if (activityModel.Images != null && activityModel.Images.Any())
                                {
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-primary px-3 py-1.5 rounded-pill">
                                            <i class="bi bi-images me-1"></i> @activityModel.Images.Count Image(s) selected
                                        </span>
                                        <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0" @onclick="ClearAllImages">
                                            <i class="bi bi-trash me-1"></i> Clear all
                                        </button>
                                    </div>

                                    <div class="row g-2">
                                        @for (int i = 0; i < activityModel.Images.Count; i++)
                                        {
                                            var imgIndex = i;
                                            var img = activityModel.Images[i];
                                            <div class="col-4 col-sm-3 position-relative">
                                                <div class="card h-100 border-0 rounded-3 overflow-hidden shadow-sm position-relative" style="background: rgba(255,255,255,0.05); height: 110px;">
                                                    <img src="@img.PreviewUrl" alt="@img.FileName" class="w-100 h-100" style="object-fit: cover;" />
                                                    @if (imgIndex == 0)
                                                    {
                                                        <span class="badge bg-primary position-absolute top-0 start-0 m-1" style="font-size: 0.65rem;">Cover</span>
                                                    }
                                                    <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle p-0 d-flex align-items-center justify-content-center" 
                                                            style="width: 24px; height: 24px; font-size: 0.7rem;" 
                                                            @onclick="() => RemoveImage(imgIndex)" 
                                                            title="Remove image">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="alert alert-info py-2 mt-3 mb-0 d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>
                                <span>@statusMessage</span>
                            </div>
                        }
                    </div>
                    
                    <div class="modal-footer border-0 pt-0 pb-4 px-4">
                        <NavLink href="/admin/activities" class="btn btn-secondary px-4 me-2">Cancel</NavLink>
                        <button type="submit" class="btn btn-primary px-4 fw-bold" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span><span class="spinner-border spinner-border-sm me-2" role="status"></span>Creating...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-check2-circle me-1.5"></i> Create Activity</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="text-center mt-5 p-5 tech-card">
            <i class="bi bi-shield-slash text-danger fs-1"></i>
            <h2 class="text-danger fw-bold mt-3">Access Denied</h2>
            <p class="text-muted">သင့်တွင် ဤစာမျက်နှာကို ဝင်ရောက်ကြည့်ရှုရန် ခွင့်ပြုချက် (Activity.Create Policy) မရှိပါ။</p>
            <NavLink href="/admin/activities" class="btn btn-primary mt-2">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>