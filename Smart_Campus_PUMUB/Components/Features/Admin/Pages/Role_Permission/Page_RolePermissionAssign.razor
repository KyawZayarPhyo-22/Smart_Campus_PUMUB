    private string ParseFallbackMyanmar(string permName)
    {
        var parts = permName.Split('.');
        if (parts.Length == 2)
        {
            var entity = parts[0];
            var action = parts[1].ToLower();
            string actionMm = action switch
            {
                "create" => "ထည့်သွင်း",
                "edit" => "ပြင်ဆင်",
                "delete" => "ဖျက်ပစ်",
                "view" => "ကြည့်ရှု",
                "manage" => "စီမံခန့်ခွဲ",
                "approve" => "အတည်ပြု",
                _ => parts[1]
            };
            return $"{entity} {actionMm}";
        }
        return permName;
    }

    private string ParseFallbackEnglish(string permName)
    {
        var parts = permName.Split('.');
        if (parts.Length == 2)
        {
            return $"{parts[1]} {parts[0]}";
        }
        return permName;
    }

    private List<Permission> GetPermissionsForCategory(string categoryKey)
    {
        if (AllPermissions == null) return new();
        return AllPermissions.Where(p => GetCategoryKey(p.PermissionName) == categoryKey).ToList();
    }

    private List<CategoryGroup> FilteredCategoryGroups
    {
        get
        {
            if (AllPermissions == null) return new();

            var groups = new List<CategoryGroup>();

            var categoriesToProcess = SelectedCategoryKey == "all"
                ? Categories
                : Categories.Where(c => c.Key == SelectedCategoryKey).ToList();

            foreach (var cat in categoriesToProcess)
            {
                var perms = AllPermissions
                    .Where(p => GetCategoryKey(p.PermissionName) == cat.Key)
                    .OrderBy(p => p.PermissionName)
                    .ToList();

                if (perms.Any())
                {
                    groups.Add(new CategoryGroup
                    {
                        Category = cat,
                        Permissions = perms
                    });
                }
            }

            return groups;
        }
    }

    private void SetCategory(string key)
    {
        SelectedCategoryKey = key;
    }

    private void ToggleSinglePermission(int id)
    {
        if (SelectedIds.Contains(id))
            SelectedIds.Remove(id);
        else
            SelectedIds.Add(id);
    }

    private void ToggleCategory(string categoryKey, bool selectAll)
    {
        var categoryPerms = GetPermissionsForCategory(categoryKey);
        foreach (var p in categoryPerms)
        {
            if (selectAll && !SelectedIds.Contains(p.PermissionId))
                SelectedIds.Add(p.PermissionId);
            else if (!selectAll && SelectedIds.Contains(p.PermissionId))
                SelectedIds.Remove(p.PermissionId);
        }
    }

    private void SelectAll()
    {
        if (AllPermissions == null) return;
        SelectedIds = AllPermissions.Select(p => p.PermissionId).ToList();
    }

    private void DeselectAll()
    {
        SelectedIds.Clear();
    }

    private async Task SavePermissions()
    {
        IsProcessing = true;
        try
        {
            await PermissionService.UpdateRolePermissionsAsync(RoleId, SelectedIds);

            try
            {
                await JS.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "success",
                    title = LangService.IsMyanmar ? "အောင်မြင်ပါသည်" : "Success",
                    text = LangService.IsMyanmar 
                        ? $"{CurrentRole?.RoleName ?? "Role"} အတွက် Permissions များကို အောင်မြင်စွာ သိမ်းဆည်းလိုက်ပါပြီ။" 
                        : $"Permissions for {CurrentRole?.RoleName ?? "Role"} have been saved successfully.",
                    timer = 2000,
                    showConfirmButton = false
                });
            }
            catch { }

            await Task.Delay(1000);
            Nav.NavigateTo("/admin/roles");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving permissions: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
        }
    }
