@page "/admin/acc-register"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Features.Admin.Pages.RegisterAcc
@using Smart_Campus_PUMUB.WebApi.Models
@using Smart_Campus_PUMUB.Components.Features.Admin.Layout
@rendermode InteractiveServer

<style>
    /* ── Status Badges ─────────────────────────────── */
    .badge-approved {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 50px;
        padding: 4px 14px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .badge-rejected {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.25);
        border-radius: 50px;
        padding: 4px 14px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .badge-pending {
        background: rgba(234, 179, 8, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(234, 179, 8, 0.3);
        border-radius: 50px;
        padding: 4px 14px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    /* Action Buttons */
    .btn-action-approve {
        background: #10b981;
        color: #ffffff;
        border: 1px solid #10b981;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-action-approve:hover {
            background: #059669;
            color: #ffffff;
            border-color: #059669;
        }

        .btn-action-approve:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

    .btn-action-reject {
        background: #dc3545;
        color: #ffffff;
        border: 1px solid #dc3545;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-action-reject:hover {
            background: #bb2d3b;
            color: #ffffff;
            border-color: #bb2d3b;
        }

        .btn-action-reject:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }


    /* ── Table ─────────────────────────────────────── */
    .acc-table {
        background: rgba(20, 24, 33, 0.6);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .acc-table thead {
        background: rgba(13, 110, 253, 0.1);
        border-bottom: 2px solid rgba(13, 110, 253, 0.2);
    }

    .acc-table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.78rem;
        color: #0d6efd;
        padding: 14px 16px;
        letter-spacing: 0.04em;
    }

    .acc-table td {
        padding: 14px 16px;
        color: #e2e8f0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        font-size: 0.88rem;
    }

    .acc-table tr:hover {
        background: rgba(255, 255, 255, 0.02);
        box-shadow: inset 4px 0 0 #0d6efd;
    }

    /* ── Toast ─────────────────────────────────────── */
    .acc-toast {
        position: fixed;
        bottom: 28px;
        right: 28px;
        min-width: 300px;
        max-width: 440px;
        padding: 16px 20px;
        border-radius: 14px;
        font-size: 0.88rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 9999;
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    }

    .acc-toast.success {
        background: #064e3b;
        border: 1px solid #065f46;
        color: #6ee7b7;
    }

    .acc-toast.error {
        background: #7f1d1d;
        border: 1px solid #991b1b;
        color: #fca5a5;
    }

    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
    }

    /* ── Modal fields ──────────────────────────────── */
    .reject-textarea {
        background: rgba(30, 35, 50, 0.8) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        border-radius: 10px !important;
        color: #e2e8f0 !important;
        font-size: 0.9rem !important;
        resize: vertical;
    }

    .reject-textarea:focus {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239,68,68,0.15) !important;
        outline: none !important;
    }

    /* info row inside modals */
    .modal-info-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 0.87rem;
    }

    .modal-info-row:last-child { border-bottom: none; }
    .modal-info-label { color: #64748b; font-weight: 500; }
    .search-input {
        padding-left: 2.6rem !important;
    }

    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        max-height: 228px;
        overflow-y: auto;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        padding: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .dropdown-item-custom {
        padding: 8px 12px;
        font-size: 0.88rem;
        font-weight: 500;
        color: #374151;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 36px;
    }

    .dropdown-item-custom:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
        font-weight: 600;
    }

    .dropdown-item-custom.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }
</style>

@if (isStatusDropdownOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseAllDropdowns"></div>
}

<!-- ── Page Header ──────────────────────────────────────────────────── -->
<div class="d-flex align-items-center justify-content-between mb-4 mt-2">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded p-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: transparent; border: 1.5px solid #5A4FCF;">
            <i class="bi bi-person-check fs-5" style="color: #5A4FCF;"></i>
        </div>
        <div>
            <h4 class="fw-bolder text-white mb-0" style="letter-spacing: 0.5px;">Account Register Requests</h4>
            <small class="text-secondary">Semester I ကျောင်းသားများ Account Request စီမံချက်</small>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge-pending" style="font-size:0.82rem; padding:6px 16px;">
            Total: @TotalCount records
        </span>
    </div>
</div>

<!-- ── Filter Row ───────────────────────────────────────────────────── -->
<div class="material-card p-3 mb-4" style="position: relative; z-index: 1045;">
    <div class="row g-3 align-items-center">

        <!-- Search -->
        <div class="col">
            <div class="position-relative">
                <i class="bi bi-search position-absolute text-muted" style="top:50%;left:14px;transform:translateY(-50%); pointer-events: none; z-index: 5; font-size: 0.9rem;"></i>
                <input type="text" class="form-control material-input search-input w-100" style="padding-left: 2.6rem !important;"
                       placeholder="Search by name, email, form no..." @bind="SearchInput" @onkeyup="HandleKeyUp" />
            </div>
        </div>

        <!-- Status filter (Custom Dropdown) -->
        <div class="col-md-3">
            <div class="custom-dropdown-container">
                <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                        @onclick="ToggleStatusDropdown">
                    <span class="text-truncate">@(SelectedStatusInput == "All" ? "All Status" : SelectedStatusInput)</span>
                    <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                </button>

                @if (isStatusDropdownOpen)
                {
                    <div class="custom-dropdown-menu shadow">
                        <div class="dropdown-item-custom @(SelectedStatusInput == "All" ? "selected" : "")" 
                             @onclick='() => SelectStatus("All")'>
                            <span>All Status</span>
                            @if (SelectedStatusInput == "All") { <i class="bi bi-check2 text-primary"></i> }
                        </div>
                        <div class="dropdown-item-custom @(SelectedStatusInput == "Pending" ? "selected" : "")" 
                             @onclick='() => SelectStatus("Pending")'>
                            <span>Pending</span>
                            @if (SelectedStatusInput == "Pending") { <i class="bi bi-check2 text-primary"></i> }
                        </div>
                        <div class="dropdown-item-custom @(SelectedStatusInput == "Approved" ? "selected" : "")" 
                             @onclick='() => SelectStatus("Approved")'>
                            <span>Approved</span>
                            @if (SelectedStatusInput == "Approved") { <i class="bi bi-check2 text-primary"></i> }
                        </div>
                        <div class="dropdown-item-custom @(SelectedStatusInput == "Rejected" ? "selected" : "")" 
                             @onclick='() => SelectStatus("Rejected")'>
                            <span>Rejected</span>
                            @if (SelectedStatusInput == "Rejected") { <i class="bi bi-check2 text-primary"></i> }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Buttons -->
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary w-50 d-flex align-items-center justify-content-center" @onclick="ApplyFilter" title="Search">
                <i class="bi bi-search"></i>
            </button>
            <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" @onclick="ResetFilter" title="Reset">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
</div>

<!-- Table Section -->
<div class="tech-card p-4">
    @if (IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary"></div>
            <div class="text-dark mt-3 small fw-bold">Account Register Request စာရင်းများကို ဆွဲယူနေပါသည်...</div>
        </div>
    }
    else if (Items == null || !Items.Any())
    {
        <div class="text-center py-5 text-dark fw-bold">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
            ပြသရန် Account Request မရှိသေးပါ သို့မဟုတ် ရှာဖွေမှုမတွေ့ပါ။
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 acc-table">
                <thead>
                    <tr>
                        <th style="width: 5%;">NO.</th>
                        <th>Name</th>
                        <th>Email / Phone</th>
                        <th>Form No</th>
                        <th>Exam Seat No</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th class="text-center">Actions</th>
                        <th class="text-center">Acc Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNo = (CurrentPage - 1) * PageSize + 1;
                    }
                    @foreach (var item in Items)
                    {
                        <tr class="table-row-hover">
                            <td class="fw-bold text-dark">@rowNo.ToString("D2")</td>
                            <td>
                                <div class="fw-bold text-dark">@item.FullName</div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary" style="font-size:0.83rem;">@item.Email</div>
                                @if (!string.IsNullOrEmpty(item.Phone))
                                {
                                    <div class="fw-bold text-secondary small">@item.Phone</div>
                                }
                            </td>
                            <td><code class="fw-bold text-info">@(item.FormNo ?? "-")</code></td>
                            <td><code class="fw-bold text-warning">@(item.ExamSeatNo ?? "-")</code></td>
                            <td>
                                <span class="@StatusBadgeClass(item.Status) fw-bold">@item.Status</span>
                                @if (item.Status == "Rejected" && !string.IsNullOrEmpty(item.RejectionReason))
                                {
                                    <div class="fw-bold text-secondary" style="font-size:0.74rem; margin-top:3px; max-width:180px;" title="@item.RejectionReason">
                                        @(item.RejectionReason.Length > 40 ? item.RejectionReason[..40] + "…" : item.RejectionReason)
                                    </div>
                                }
                            </td>
                            <td class="fw-bold text-dark">@item.CreatedDateTime?.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                     @if (item.Status == "Pending")
                                     {
                                         <button class="btn-action-approve fw-bold" @onclick="() => OpenApproveModal(item)" disabled="@IsProcessing">
                                              <i class="bi bi-check-circle-fill"></i> Approve
                                         </button>
                                         <button class="btn-action-reject fw-bold" @onclick="() => OpenRejectModal(item)" disabled="@IsProcessing">
                                              <i class="bi bi-x-circle-fill"></i> Reject
                                         </button>
                                     }
                                     else
                                     {
                                         <span class="fw-bold text-dark" style="font-size:0.8rem;">
                                             @item.ReviewedBy — @item.ReviewedDateTime?.ToString("dd-MM-yyyy")
                                         </span>
                                     }
                                 </div>
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Approved")
                                {
                                    @if ((item.AccountStatus ?? "Active") == "Active")
                                    {
                                        <button class="btn btn-sm btn-success fw-bold text-white" style="font-size:0.78rem; font-weight:700; padding:4px 10px; border-radius:6px; min-width: 90px; color: #ffffff !important;" @onclick="() => OpenStatusModal(item)" disabled="@IsProcessing">
                                            <i class="bi bi-shield-check me-1 text-white"></i> Active
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-danger fw-bold text-white" style="font-size:0.78rem; font-weight:700; padding:4px 10px; border-radius:6px; min-width: 90px; color: #ffffff !important;" @onclick="() => OpenStatusModal(item)" disabled="@IsProcessing">
                                            <i class="bi bi-shield-slash me-1 text-white"></i> Inactive
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fw-bold" style="font-size:0.8rem;">-</span>
                                }
                            </td>
                        </tr>
                        rowNo++;
                    }
                </tbody>
            </table>
        </div>

        <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
    }
</div>

<!-- ── Approve Confirmation Modal ──────────────────────────────────── -->
@if (ShowApproveModal && SelectedItem != null)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tech-card">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:36px;height:36px;background:rgba(16,185,129,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                            <i class="bi bi-check-circle-fill text-success"></i>
                        </div>
                        <h5 class="text-success mb-0">Confirm Approve</h5>
                    </div>
                </div>
                <div class="modal-body">
                    <p class="text-secondary mb-3" style="font-size:0.87rem;">
                        ဤ Request ကို Approve လုပ်မည်။ Student Account အသစ် auto-create ဖြစ်ပြီး Login credentials ကို Email ဖြင့် ပေးပို့မည်။
                    </p>
                    <div class="p-3" style="background:rgba(255,255,255,0.03);border-radius:10px;">
                        <div class="modal-info-row">
                            <span class="modal-info-label">Name</span>
                            <span class="modal-info-val">@SelectedItem.FullName</span>
                        </div>
                        <div class="modal-info-row">
                            <span class="modal-info-label">Email</span>
                            <span class="modal-info-val" style="color:#93c5fd;">@SelectedItem.Email</span>
                        </div>
                        <div class="modal-info-row">
                            <span class="modal-info-label">Form No</span>
                            <span class="modal-info-val">@SelectedItem.FormNo</span>
                        </div>
                        <div class="modal-info-row">
                            <span class="modal-info-label">Exam Seat No</span>
                            <span class="modal-info-val">@SelectedItem.ExamSeatNo</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-secondary" @onclick="CloseApproveModal" disabled="@IsProcessing">Cancel</button>
                    <button class="btn btn-success" @onclick="ConfirmApprove" disabled="@IsProcessing">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>Yes, Approve</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Reject Modal ─────────────────────────────────────────────────── -->
@if (ShowRejectModal && SelectedItem != null)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tech-card">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:36px;height:36px;background:rgba(239,68,68,0.12);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                        </div>
                        <h5 class="text-danger mb-0">Confirm Reject</h5>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="mb-3 p-3" style="background:rgba(255,255,255,0.03);border-radius:10px;">
                        <div class="modal-info-row">
                            <span class="modal-info-label">Name</span>
                            <span class="modal-info-val">@SelectedItem.FullName</span>
                        </div>
                        <div class="modal-info-row">
                            <span class="modal-info-label">Email</span>
                            <span class="modal-info-val" style="color:#93c5fd;">@SelectedItem.Email</span>
                        </div>
                    </div>
                    <label class="form-label text-secondary mb-1" style="font-size:0.85rem; font-weight:600;">
                        Rejection Reason <span style="color:#64748b;">(Optional)</span>
                    </label>
                    <textarea class="form-control reject-textarea" rows="3"
                              placeholder="ငြင်းပယ်ရတဲ့ အကြောင်းရင်းကို ဖော်ပြနိုင်ပါသည်..."
                              @bind="RejectReason"></textarea>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-secondary" @onclick="CloseRejectModal" disabled="@IsProcessing">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmReject" disabled="@IsProcessing">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-x-lg me-1"></i>
                            <span>Yes, Reject</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Status Modal ─────────────────────────────────────────────────── -->
@if (ShowStatusModal && SelectedItem != null)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tech-card">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:36px;height:36px;background:rgba(13,110,253,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                            <i class="bi bi-shield-check text-primary"></i>
                        </div>
                        <h5 class="text-primary mb-0">Confirm Status Change</h5>
                    </div>
                </div>
                <div class="modal-body text-center text-white">
                    <p class="text-secondary mb-3" style="font-size:0.87rem;">
                        ဤအသုံးပြုသူ <strong>@SelectedItem.FullName</strong> ၏ Account Status အား 
                        <strong class="@(string.Equals(SelectedItem.AccountStatus, "Active", StringComparison.OrdinalIgnoreCase) ? "text-danger" : "text-success")">
                            @(string.Equals(SelectedItem.AccountStatus, "Active", StringComparison.OrdinalIgnoreCase) ? "Inactive" : "Active")
                        </strong> သို့ ပြောင်းလဲရန် သေချာပါသလား?
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-secondary" @onclick="CloseStatusModal" disabled="@IsProcessing">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmToggleStatus" disabled="@IsProcessing">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>Confirm</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Toast Notification ──────────────────────────────────────────── -->
@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div class="acc-toast @(ToastIsSuccess ? "success" : "error")">
        <i class="bi @(ToastIsSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill") fs-5"></i>
        <span>@ToastMessage</span>
    </div>
}
