@page "/admin/semester/create"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Semester
@using Smart_Campus_PUMUB.WebApi.Models
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<AuthorizeView Policy="Semester.Create" Context="authContext">
    <Authorized>
        <div class="modal-dialog modal-md mt-5">
    <div class="modal-content tech-card">
        <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-bold">Add New Semester</h5>
        </div>
        <EditForm Model="semesterModel" OnValidSubmit="SaveSemester" FormName="CreateSemesterForm">
            <DataAnnotationsValidator />
            <div class="modal-body">
                <div class="col-12 mb-3">
                    <label class="form-label text-light">Semester Name</label>
                    <InputText @bind-Value="semesterModel.SemesterName" class="form-control" placeholder="Enter Semester Name (e.g., First Semester 2026)" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label text-light">Max Elective (CS)</label>
                        <InputNumber @bind-Value="semesterModel.MaxElectiveCS" class="form-control" placeholder="0" min="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-light">Max Elective (CT)</label>
                        <InputNumber @bind-Value="semesterModel.MaxElectiveCT" class="form-control" placeholder="0" min="0" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="small text-info mt-2">@statusMessage</div>
                }
            </div>
            <div class="modal-footer border-0 pt-0">
                <NavLink href="/admin/semesters" class="nav-link me-3"><span class="sidebar-text text-muted">Cancel</span></NavLink>
                <button type="submit" class="btn btn-primary" disabled="@isProcessing">
                    @(isProcessing ? "Creating..." : "Create Semester")
                </button>
            </div>
        </EditForm>
    </div>
</div>
    </Authorized>
    <NotAuthorized>
        <div class="text-center mt-5 p-5 tech-card">
            <i class="bi bi-shield-slash text-danger fs-1"></i>
            <h2 class="text-danger fw-bold mt-3">Access Denied</h2>
            <p class="text-muted">သင့်တွင် ဤစာမျက်နှာကို ဝင်ရောက်ကြည့်ရှုရန် ခွင့်ပြုချက် (Semester.Create Policy) မရှိပါ။</p>
            <NavLink href="/admin/semesters" class="btn btn-primary mt-2">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>