@page "/admin/subject/edit/{SubjectId:int}"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Subject
@using Smart_Campus_PUMUB.WebApi.Models
@using Smart_Campus_PUMUB.Database.AppDbContext
@rendermode InteractiveServer

<div class="mb-4">
    <h3 class="fw-bold text-white">Edit Subject</h3>
</div>

<div class="tech-card p-4">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ErrorMessage
        </div>
    }
    @if (subject == null)
    {
        <div class="text-center text-muted">Loading...</div>
    }
    else
    {
        <EditForm Model="subject" OnValidSubmit="UpdateSubject">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-light">Semester</label>
                    <InputSelect @bind-Value="subject.SemesterId" class="form-select bg-dark text-white border-secondary">
                        @foreach (var sem in SemesterList)
                        {
                            <option value="@sem.SemesterId">@sem.SemesterName</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light">Faculty <span class="text-muted small">(Optional)</span></label>
                    <InputSelect @bind-Value="subject.FacultyId" class="form-select bg-dark text-white border-secondary">
                        <option value="">-- Faculty မရွေးချယ် --</option>
                        @foreach (var fac in FacultyList)
                        {
                            <option value="@fac.FacultyId">@fac.FacultyName</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light">Major <span class="text-muted small">(Optional)</span></label>
                    <InputSelect @bind-Value="subject.MajorId" class="form-select bg-dark text-white border-secondary">
                        <option value="">-- Major မရွေးချယ် --</option>
                        @foreach (var maj in FilteredMajors)
                        {
                            <option value="@maj.MajorId">@maj.MajorName</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light">Subject Name</label>
                    <InputText @bind-Value="subject.SubjectName" class="form-control bg-dark text-white border-secondary" />
                    <ValidationMessage For="@(() => subject.SubjectName)" class="text-danger" />
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light">Subject Code</label>
                    <InputText @bind-Value="subject.SubjectCode" class="form-control bg-dark text-white border-secondary" />
                    <ValidationMessage For="@(() => subject.SubjectCode)" class="text-danger" />
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light">Subject Type</label>
                    <InputSelect @bind-Value="subject.SubjectType" class="form-select bg-dark text-white border-secondary">
                        @foreach (var type in Enum.GetValues<EnumSubjectType>())
                        {
                            if (type == EnumSubjectType.None)
                            {
                                <option value="@type">-- Subject Type ရွေးချယ်ပါ --</option>
                            }
                            else
                            {
                                <option value="@type">@type.ToString()</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => subject.SubjectType)" class="text-danger" />
                </div>

                <div class="col-md-4">
                    <label class="form-label text-light">Credit Point (ခရက်ဒစ်မှတ်)</label>
                    <InputNumber @bind-Value="subject.Credit" class="form-control bg-dark text-white border-secondary" min="0" max="15" placeholder="ဥပမာ - 3" />
                    <ValidationMessage For="@(() => subject.Credit)" class="text-danger" />
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-12">
                    <label class="form-label text-light">Prerequisite Subjects <span class="text-muted small">(Optional)</span></label>
                    <InputSelect @bind-Value="SelectedPrerequisiteId" class="form-select bg-dark text-white border-secondary">
                        <option value="0">-- Prerequisite ဘာသာရပ်ကို ရွေးပါ --</option>
                        @foreach (var sub in SubjectList)
                        {
                            @if (sub.SubjectId != SubjectId)
                            {
                                <option value="@sub.SubjectId">@sub.SubjectCode - @sub.SubjectName</option>
                            }
                        }
                    </InputSelect>
                    <div class="form-text text-muted">Prerequisite ဘာသာရပ်မရှိပါက မရွေးချယ်ဘဲ ထားနိုင်ပါသည်။</div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4" disabled="@IsProcessing">
                    @(IsProcessing ? "Updating..." : "Save Changes")
                </button>
                <NavLink href="/admin/subjects" class="btn btn-secondary px-4">Cancel</NavLink>
            </div>
        </EditForm>
    }
</div>