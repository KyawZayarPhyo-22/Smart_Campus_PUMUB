@page "/admin/subject/create"
@layout AdminLayout
@using Smart_Campus_PUMUB.WebApi.Models
@using Smart_Campus_PUMUB.Database.AppDbContext
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Subject
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<AuthorizeView Policy="Subject.Create" Context="authContext">
    <Authorized>
        <div class="page-header">
    <h3><i class="bi bi-plus-lg me-2 text-info"></i>ဘာသာရပ် အသစ်ထည့်ရန်</h3>
</div>

<div class="tech-card">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ErrorMessage
        </div>
    }
    <EditForm Model="subject" OnValidSubmit="SaveSubject" FormName="CreateSubjectForm">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Semester ရွေးချယ်ရန်</label>
                <InputSelect @bind-Value="subject.SemesterId" class="form-select">
                    <option value="0">-- Semester တစ်ခုကို ရွေးပါ --</option>
                    @foreach (var sem in SemesterList)
                    {
                        <option value="@sem.SemesterId">@sem.SemesterName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => subject.SemesterId)" class="text-danger" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Faculty ရွေးချယ်ရန် <span class="text-muted small">(Optional)</span></label>
                <InputSelect @bind-Value="subject.FacultyId" class="form-select">
                    <option value="">-- Faculty ရွေးပါ (မဖြစ်မနေ မဟုတ်) --</option>
                    @foreach (var fac in FacultyList)
                    {
                        <option value="@fac.FacultyId">@fac.FacultyName</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-4">
                <label class="form-label">Major ရွေးချယ်ရန် <span class="text-muted small">(Optional)</span></label>
                <InputSelect @bind-Value="subject.MajorId" class="form-select">
                    <option value="">-- Major ရွေးပါ (မဖြစ်မနေ မဟုတ်) --</option>
                    @foreach (var maj in FilteredMajors)
                    {
                        <option value="@maj.MajorId">@maj.MajorName</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-4">
                <label class="form-label">Subject Name</label>
                <InputText @bind-Value="subject.SubjectName" class="form-control"
                           placeholder="ဥပမာ - Engineering Mathematics I" />
                <ValidationMessage For="@(() => subject.SubjectName)" class="text-danger" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Subject Code</label>
                <InputText @bind-Value="subject.SubjectCode" class="form-control" placeholder="ဥပမာ - MATH-101" />
                <ValidationMessage For="@(() => subject.SubjectCode)" class="text-danger" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Subject Type</label>
                <InputSelect @bind-Value="subject.SubjectType" class="form-select">
                    @foreach (var type in Enum.GetValues<EnumSubjectType>())
                    {
                        if (type == EnumSubjectType.None)
                        {
                            <option value="@type">-- Subject Type ရွေးချယ်ပါ --</option>
                        }
                        else
                        {
                            <option value="@type">@type.ToString()</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="@(() => subject.SubjectType)" class="text-danger" />
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-12">
                <label class="form-label">Prerequisite Subjects <span class="text-muted small">(Optional)</span></label>
                <InputSelect @bind-Value="SelectedPrerequisiteId" class="form-select bg-white">
                    <option value="0">-- Prerequisite ဘာသာရပ်ကို ရွေးပါ --</option>
                    @foreach (var sub in SubjectList)
                    {
                        <option value="@sub.SubjectId">@sub.SubjectCode - @sub.SubjectName</option>
                    }
                </InputSelect>
                <div class="form-text">Prerequisite ဘာသာရပ်မရှိပါက မရွေးချယ်ဘဲ ထားနိုင်ပါသည်။</div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-info text-dark fw-semibold" disabled="@IsProcessing">
                @(IsProcessing ? "သိမ်းဆည်းနေသည်..." : "သိမ်းဆည်းရန်")
            </button>
            <NavLink href="/admin/subjects" class="btn btn-secondary">နောက်သို့</NavLink>
        </div>
    </EditForm>
</div>
    </Authorized>
    <NotAuthorized>
        <div class="text-center mt-5 p-5 tech-card">
            <i class="bi bi-shield-slash text-danger fs-1"></i>
            <h2 class="text-danger fw-bold mt-3">Access Denied</h2>
            <p class="text-muted">သင့်တွင် ဤစာမျက်နှာကို ဝင်ရောက်ကြည့်ရှုရန် ခွင့်ပြုချက် (Subject.Create Policy) မရှိပါ။</p>
            <NavLink href="/admin/subjects" class="btn btn-primary mt-2">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>