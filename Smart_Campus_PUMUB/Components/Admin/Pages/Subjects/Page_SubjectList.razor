@page "/admin/subjects"
@layout AdminLayout
@namespace Smart_Campus_PUMUB.Components.Admin.Pages.Subject
@using Smart_Campus_PUMUB.WebApi.Models
@using Smart_Campus_PUMUB.Database.AppDbContext
@rendermode InteractiveServer

<style>
    .custom-table {
        background: rgba(20, 24, 33, 0.6);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .custom-table thead {
        background: rgba(13, 110, 253, 0.1);
        border-bottom: 2px solid rgba(13, 110, 253, 0.2);
    }
    .custom-table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        color: #0d6efd;
        padding: 16px 20px;
    }
    .custom-table td {
        padding: 16px 20px;
        color: #e2e8f0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .table-row-hover:hover {
        background: rgba(255, 255, 255, 0.02);
        box-shadow: inset 4px 0 0 #0d6efd;
    }
    .btn-action-edit {
        background: rgba(13, 110, 253, 0.1);
        color: #39b5ff;
        border: 1px solid rgba(13, 110, 253, 0.3);
        border-radius: 6px;
        padding: 6px 14px;
        transition: all 0.2s ease;
    }
    .btn-action-edit:hover { background: #0d6efd; color: #ffffff; }
    .btn-action-delete {
        background: rgba(220, 53, 69, 0.1);
        color: #ff6b6b;
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 6px;
        padding: 6px 14px;
        transition: all 0.2s ease;
    }
    .btn-action-delete:hover { background: #dc3545; color: #ffffff; }

    .badge-faculty {
        background: rgba(90, 79, 207, 0.12) !important;
        color: #1e1b4b !important;
        border: 1px solid rgba(90, 79, 207, 0.3) !important;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.84rem;
        font-weight: 700;
        display: inline-block;
    }

    .search-input {
        padding-left: 2.6rem !important;
    }

    .custom-dropdown-container {
        position: relative;
    }

    .custom-dropdown-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        max-height: 228px; /* Approximately 6 items */
        overflow-y: auto;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        padding: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .custom-dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .dropdown-item-custom {
        padding: 8px 12px;
        font-size: 0.88rem;
        font-weight: 500;
        color: #374151;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 36px;
    }

    .dropdown-item-custom:hover {
        background-color: #f3f4f6;
        color: #5A4FCF;
        font-weight: 600;
    }

    .dropdown-item-custom.selected {
        background-color: rgba(90, 79, 207, 0.08);
        color: #5A4FCF;
        font-weight: 700;
    }
</style>

@if (isSemesterDropdownOpen)
{
    <div style="position: fixed; inset: 0; z-index: 1040; background: transparent;" @onclick="CloseAllDropdowns"></div>
}

<div class="tab-pane fade show active" id="v-pills-subject">
    <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
        <div class="d-flex align-items-center">
            <div class="rounded p-2 me-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: transparent; border: 1.5px solid #5A4FCF;">
                <i class="bi bi-journal-bookmark fs-5" style="color: #5A4FCF;"></i>
            </div>
            <div>
                <h4 class="fw-bolder text-white mb-0" style="letter-spacing: 0.5px;">Subject Directory</h4>
                <small class="text-secondary">သင်ရိုးညွှန်းတမ်း ဘာသာရပ်များနှင့် သင်ကြားမှုကဏ္ဍများ စီမံခန့်ခွဲခြင်း</small>
            </div>
        </div>
    </div>

    <!-- 🔹 Filter Section -->
    <div class="material-card p-3 mb-4" style="position: relative; z-index: 1045;">
        <div class="row g-3 align-items-center">
            <!-- Search Input -->
            <div class="col">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute text-muted" style="top: 50%; left: 14px; transform: translateY(-50%); pointer-events: none; z-index: 5; font-size: 0.9rem;"></i>
                    <input type="text" class="form-control material-input search-input w-100" style="padding-left: 2.6rem !important;" placeholder="Search by Subject Name or Code..." @bind="SearchInput" @onkeyup="HandleKeyUp" />
                </div>
            </div>

            <!-- Semester Dropdown (approx 6 items height with scroll) -->
            <div class="col-md-3">
                <div class="custom-dropdown-container">
                    <button type="button" class="form-select material-input fw-semibold text-start d-flex justify-content-between align-items-center w-100" 
                            @onclick="ToggleSemesterDropdown">
                        <span class="text-truncate">@(SelectedSemesterInput == "All" ? "All Semesters" : SelectedSemesterInput)</span>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>

                    @if (isSemesterDropdownOpen)
                    {
                        <div class="custom-dropdown-menu shadow">
                            <div class="dropdown-item-custom @(SelectedSemesterInput == "All" ? "selected" : "")" 
                                 @onclick='() => SelectSemester("All")'>
                                <span>All Semesters</span>
                                @if (SelectedSemesterInput == "All") { <i class="bi bi-check2 text-primary"></i> }
                            </div>
                            @foreach (var sem in SubjectList.Select(s => s.SemesterName).Distinct().Where(se => !string.IsNullOrEmpty(se)))
                            {
                                <div class="dropdown-item-custom @(SelectedSemesterInput == sem ? "selected" : "")" 
                                     @onclick='() => SelectSemester(sem)'>
                                    <span>@sem</span>
                                    @if (SelectedSemesterInput == sem) { <i class="bi bi-check2 text-primary"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Search and Reset Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary w-50 d-flex align-items-center justify-content-center" type="button" @onclick="ApplyFilter" title="Search">
                    <i class="bi bi-search"></i>
                </button>
                <button class="btn btn-secondary w-50 d-flex align-items-center justify-content-center" type="button" @onclick="ResetFilter" title="Reset">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <!-- Add Button -->
            <AuthorizeView Policy="Subject.Create">
                <div class="col-auto">
                    <NavLink href="/admin/subject/create" class="btn btn-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 38px;" title="Add Subject">
                        <i class="bi bi-plus-lg"></i>
                    </NavLink>
                </div>
            </AuthorizeView>
        </div>
    </div>

    <div class="tech-card p-4">

        @if (IsLoading) {
            <div class="text-center my-5">
                <div class="spinner-border text-primary"></div>
                <div class="text-dark mt-3 small fw-bold">Subject စာရင်းများကို ဆွဲယူနေပါသည်...</div>
            </div>
        } else {
            <div class="table-responsive custom-table">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 8%;">No.</th>
                            <th style="width: 25%;">Subject Name</th>
                            <th style="width: 10%;">Code</th>
                            <th style="width: 12%;">Type</th>
                            <th style="width: 12%;">Semester</th>
                            <th style="width: 15%;">Faculty</th>
                            <th style="width: 18%;">Major</th>
                            @if (canManageSubject)
                            {
                                <th style="text-align: center;">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ int count = (CurrentPage - 1) * PageSize + 1; }
                        @foreach (var item in FilteredSubjects) {
                            <tr class="table-row-hover">
                                <td class="fw-bold text-dark">@count.ToString("D2")</td>
                                <td class="fw-bold text-dark">@item.SubjectName</td>
                                <td><code class="text-dark fw-bold">@item.SubjectCode</code></td>
                                <td>
                                    @if (item.SubjectType == EnumSubjectType.Core)
                                    {
                                        <span class="badge px-3 py-1.5 fw-bold d-inline-flex align-items-center shadow-sm" style="background-color: #4F46E5; color: #ffffff !important; font-size: 0.82rem; border-radius: 6px; letter-spacing: 0.3px;">
                                            <i class="bi bi-star-fill me-1.5 small" style="color: #ffffff !important;"></i>Core
                                        </span>
                                    }
                                    else if (item.SubjectType == EnumSubjectType.Elective)
                                    {
                                        <span class="badge px-3 py-1.5 fw-bold d-inline-flex align-items-center shadow-sm" style="background-color: #d97706; color: #ffffff !important; font-size: 0.82rem; border-radius: 6px; letter-spacing: 0.3px;">
                                            <i class="bi bi-puzzle-fill me-1.5 small" style="color: #ffffff !important;"></i>Elective
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-dark fw-bold small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill fw-bold" style="background: #4F46E5; color: #ffffff !important; font-size: 0.82rem; padding: 6px 12px; letter-spacing: 0.3px;">
                                        @item.SemesterName
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.FacultyName))
                                    {
                                        <span class="badge-faculty" style="background: rgba(90, 79, 207, 0.12) !important; color: #1e1b4b !important; border: 1px solid rgba(90, 79, 207, 0.3) !important; border-radius: 20px; padding: 4px 14px; font-size: 0.84rem; font-weight: 700; display: inline-block;">@item.FacultyName</span>
                                    }
                                    else
                                    {
                                        <span class="text-dark fw-bold small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.MajorName))
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info fw-bold border border-info border-opacity-25">
                                            <i class="bi bi-mortarboard me-1"></i>@item.MajorName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-dark fw-bold small">—</span>
                                    }
                                </td>
                                @if (canManageSubject)
                                {
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <AuthorizeView Policy="Subject.Edit">
                                                <NavLink href="@($"/admin/subject/edit/{item.SubjectId}")" class="btn btn-action-edit">
                                                    <i class="bi bi-pencil me-1"></i> Edit
                                                </NavLink>
                                            </AuthorizeView>
                                            <AuthorizeView Policy="Subject.Delete">
                                                <button class="btn btn-action-delete" @onclick="() => OpenDeleteModal(item)">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </AuthorizeView>
                                        </div>
                                    </td>
                                }
                            </tr>
                            count++;
                        }

                        @if (!FilteredSubjects.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5" style="text-align: center;">
                                    <div class="d-flex flex-column align-items-center justify-content-center py-4 w-100 text-center" style="min-height: 180px;">
                                        <div class="rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center" style="background: rgba(90, 79, 207, 0.08); width: 64px; height: 64px;">
                                            <i class="bi bi-folder-x fs-1" style="color: #5A4FCF;"></i>
                                        </div>
                                        <div class="fw-bold text-dark fs-6 mb-1">ပြသရန် Subject မရှိသေးပါ သို့မဟုတ် ရှာဖွေမှုမတွေ့ပါ။</div>
                                        <small class="text-muted">ရှာဖွေမှုစကားလုံး သို့မဟုတ် Filter များကို ပြောင်းလဲရှာဖွေကြည့်ပါ</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <PaginationComponent CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="OnPageChanged" />
        }
    </div>
</div>

@* Delete Confirmation Modal *@
@if (ShowModal)
{
    <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tech-card">

                <div class="modal-header border-0">
                    <h5 class="text-danger">Confirm Delete</h5>
                </div>

                <div class="modal-body text-center">
                    Are you sure to delete <strong>@SelectedSubject?.SubjectName</strong>?

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="mt-3 p-3 rounded"
                             style="background: @(IsSuccess ? "rgba(25, 135, 84, 0.15)" : "rgba(220, 53, 69, 0.15)");
                            border: 1px solid @(IsSuccess ? "#198754" : "#dc3545");">

                            <span style="color: @(IsSuccess ? "#75b798" : "#ea868f"); font-size: 0.9rem;">
                                <i class="bi @(IsSuccess ? "bi-check-circle" : "bi-exclamation-circle") me-2"></i>
                                @statusMessage
                            </span>
                        </div>
                    }
                </div>

                <div class="modal-footer border-0">
                    <button class="btn btn-secondary"
                            @onclick="CloseDeleteModal"
                            disabled="@IsProcessing">
                        Cancel
                    </button>

                    <button class="btn btn-danger"
                            @onclick="DeleteSubject"
                            disabled="@(IsProcessing || IsSuccess)">
                        @(IsProcessing ? "Deleting..." : "Yes, Delete")
                    </button>
                </div>

            </div>
        </div>
    </div>
}