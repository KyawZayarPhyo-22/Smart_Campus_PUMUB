@using Microsoft.AspNetCore.Components.Authorization
@using Smart_Campus_PUMUB.Components.Features.Services
@using Smart_Campus_PUMUB.BlazorServer.Frontend.Services
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject StudentRegistrationNotifierService NotifierService
@inject IHttpClientFactory HttpClientFactory
@inject HttpClientService HttpClientService
@rendermode InteractiveServer

<style>
    /* Navbar White Theme Styling */
    #navbar,
    #navbar.scrolled {
        background: #ffffff !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid #e2e8f0 !important;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03) !important;
    }

    #navbar .nav-brand-text span:first-child,
    #navbar.scrolled .nav-brand-text span:first-child {
        color: #0f172a !important;
        font-weight: 800;
    }

    #navbar .nav-brand-text span:last-child,
    #navbar.scrolled .nav-brand-text span:last-child {
        color: #64748b !important;
        font-weight: 600;
    }

    .nav-links a,
    .nav-link,
    #navbar .nav-links a,
    #navbar.scrolled .nav-links a,
    #navbar .nav-link,
    #navbar.scrolled .nav-link {
        color: #334155 !important;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 8px 16px !important;
        border-radius: 12px !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
    }

    .nav-links a:hover,
    .nav-link:hover,
    #navbar .nav-links a:hover,
    #navbar.scrolled .nav-links a:hover,
    #navbar .nav-link:hover,
    #navbar.scrolled .nav-link:hover {
        color: #2563eb !important;
        background: #eff6ff !important;
    }

    /* Active Pill State - Always Persistent Regardless of Scroll */
    .nav-links a.active,
    .nav-link.active,
    #navbar .nav-links a.active,
    #navbar.scrolled .nav-links a.active,
    #navbar .nav-link.active,
    #navbar.scrolled .nav-link.active,
    ul.nav-links li a.active,
    ul.nav-links li .nav-link.active {
        color: #ffffff !important;
        background-color: #2563eb !important;
        background: #2563eb !important;
        font-weight: 700 !important;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4) !important;
        border-radius: 12px !important;
    }

    .btn-apply {
        background: linear-gradient(135deg, #2563eb, #1d4ed8) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3) !important;
        border-radius: 50px !important;
        padding: 9px 22px !important;
        font-weight: 600 !important;
    }

    .btn-apply:hover {
        background: linear-gradient(135deg, #1d4ed8, #1e40af) !important;
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45) !important;
        transform: translateY(-2px);
    }

    .notification-trigger,
    #navbar.scrolled .notification-trigger {
        position: relative;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f1f5f9 !important;
        color: #475569 !important;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
        margin-left: 8px;
        margin-right: 8px;
    }

    .notification-trigger:hover,
    #navbar.scrolled .notification-trigger:hover {
        background: #e2e8f0 !important;
        color: #1e293b !important;
    }

    /* User Profile Card Styling */
    .profile-trigger {
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #1e293b;
        font-size: 0.95rem;
        padding: 5px 10px;
        border-radius: 8px;
        transition: 0.2s;
    }

    .user-circle {
        width: 46px;
        height: 46px;
        background-color: #2563eb;
        border: 2px solid #e2e8f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 1rem;
        transition: 0.3s;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .profile-card {
        position: absolute;
        top: 70px;
        right: 20px;
        background: white !important;
        padding: 20px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        border: 1px solid #e2e8f0;
        width: 220px;
        z-index: 1000;
        text-align: left;
    }

    .user-name-text {
        font-weight: 800;
        color: #1e293b;
        display: block;
        margin-bottom: 2px;
    }

    .status-text {
        font-size: 0.85rem;
        color: #10b981 !important;
        margin-bottom: 15px;
        display: block;
    }

    .btn-logout-custom {
        background-color: #fef2f2 !important;
        color: #ef4444 !important;
        border: 1px solid #fee2e2 !important;
        padding: 10px 15px !important;
        border-radius: 12px !important;
        font-weight: 600 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center;
        gap: 8px !important;
        cursor: pointer !important;
        width: 100%;
        transition: 0.3s;
    }

    .btn-logout-custom:hover {
        background-color: #ef4444 !important;
        color: white !important;
    }
</style>

<nav id="navbar" class="scrolled">
    <div class="nav-container">
        <a href="/" class="nav-brand">
            <div class="brand-emblem-sphere"
                 style="width: 54px; height: 54px; color: aliceblue; backdrop-filter: blur(8px); border-radius: 20px; display: flex; align-items: center; justify-content: center;">
                <div class="logo"
                     style="background-color: white; border-radius: 50%; width: 60px; height: 60px; align-items: center;">
                    <img src="/puu.png" alt="img" style="width: 60px; height: 60px">
                </div>
            </div>
            <div class="nav-brand-text">
                <span style="margin-bottom: 10px;">Polytechnic University</span>
                <span style="text-transform:capitalize !important;color:#F59E0B !important;font-weight: bold;">(Maubin)</span>
            </div>
        </a>

        <ul class="nav-links">
            <li style="margin-bottom: -1rem;">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home</NavLink>
            </li>
            <li style="margin-bottom: -1rem;">
                <NavLink class="nav-link" href="/department" Match="NavLinkMatch.Prefix">Departments</NavLink>
            </li>
            <li style="margin-bottom: -1rem;">
                <NavLink class="nav-link" href="/library" Match="NavLinkMatch.Prefix">Library</NavLink>
            </li>
            <li style="margin-bottom: -1rem;">
                <NavLink class="nav-link" href="/activities" Match="NavLinkMatch.Prefix">Activities</NavLink>
            </li>
            <li style="margin-bottom: -1rem;">
                <NavLink class="nav-link" href="/rules" Match="NavLinkMatch.Prefix">Rules</NavLink>
            </li>
            <AuthorizeView>
                <Authorized>
                    <li style="margin-bottom: -1rem;">
                        <NavLink class="nav-link" href="/tutors" Match="NavLinkMatch.Prefix">Tutors</NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>
        </ul>

        <div class="nav-actions">
            <AuthorizeView>
                <Authorized>
                    @if (isApplyNowEnabled && !context.User.IsInRole("Admin") && !context.User.IsInRole("admin") && !context.User.IsInRole("Super Admin") && !context.User.IsInRole("super_admin") && !context.User.IsInRole("SuperAdmin") && !context.User.IsInRole("Tutor") && !context.User.IsInRole("tutor") && !context.User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && (c.Value.ToLower().Contains("admin") || c.Value.ToLower().Contains("super") || c.Value.ToLower().Contains("tutor"))))
                    {
                        <NavLink href="register" class="btn-apply"><i class="fas fa-graduation-cap"></i> Apply Now</NavLink>

                        <!-- 🔔 Notification Bell Icon -->
                        <div class="notification-trigger" @onclick="ToggleNotificationMenu">
                            <i class="fas fa-bell" style="font-size: 1.15rem;"></i>
                            @if (unreadCount > 0)
                            {
                                <span class="notification-badge" style="position: absolute; top: -2px; right: -2px; width: 18px; height: 18px; background-color: #ef4444; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: bold; border: 2px solid #5a4fcf;">
                                    @unreadCount
                                </span>
                            }
                        </div>

                        @if (isNotificationMenuOpen)
                        {
                            <div class="notification-dropdown" style="position: absolute; top: 70px; right: 80px; background: white; border-radius: 16px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); width: 320px; z-index: 1001; padding: 15px; text-align: left; animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Notifications</h6>
                                    @if (unreadCount > 0)
                                    {
                                        <button class="btn btn-link p-0 text-decoration-none" style="font-size: 0.8rem; color: #2563eb;" @onclick="MarkNotificationsAsRead">Mark all as read</button>
                                    }
                                </div>
                                <div class="notification-list" style="max-height: 250px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
                                    @if (!notifications.Any())
                                    {
                                        <div class="text-center text-muted py-4" style="font-size: 0.85rem;">
                                            <i class="far fa-bell-slash d-block fs-4 mb-2"></i>
                                            No notifications yet
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var noti in notifications.OrderByDescending(n => n.Timestamp))
                                        {
                                            <div class="rounded-3 d-flex gap-2 align-items-start" style="background-color: @(noti.IsRead ? "transparent" : "#f1f5f9"); font-size: 0.85rem; border-bottom: 1px solid #f1f5f9; padding: 10px; transition: 0.2s;">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 28px; height: 28px; background-color: @(noti.Type == "success" ? "#10b981" : "#ef4444"); flex-shrink: 0; margin-top: 2px;">
                                                    <i class="fas @(noti.Type == "success" ? "fa-check" : "fa-exclamation")" style="font-size: 0.75rem;"></i>
                                                </div>
                                                <div class="flex-grow-1 text-dark">
                                                    <div style="font-weight: @(noti.IsRead ? "normal" : "bold");">@noti.Message</div>
                                                    <small class="text-muted">@noti.Timestamp.ToString("hh:mm tt")</small>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                    <div class="profile-trigger" @onclick="ToggleProfileMenu" style="cursor: pointer; display: flex; align-items: center;">
                        @if (!string.IsNullOrEmpty(userProfileImage))
                        {
                            <img src="@(userProfileImage.StartsWith("data:") || userProfileImage.StartsWith("http") ? userProfileImage : $"http://localhost:5077{userProfileImage}")" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255, 255, 255, 0.8);" />
                        }
                        else
                        {
                            <div class="user-circle">
                                @(string.IsNullOrEmpty(context.User.Identity?.Name) ? "S" : context.User.Identity.Name.Substring(0, 1).ToUpper())
                            </div>
                        }
                    </div>
                    @if (isProfileMenuOpen)
                    {
                        <div class="profile-card">
                            <span class="user-name-text">@context.User.Identity?.Name</span>
                            <span class="status-text">Access Granted</span>
                            
                            @if (context.User.IsInRole("Admin") || context.User.IsInRole("admin") || context.User.IsInRole("Super Admin") || context.User.IsInRole("super_admin") || context.User.IsInRole("SuperAdmin") || context.User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && (c.Value.ToLower().Contains("admin") || c.Value.ToLower().Contains("super"))))
                            {
                                <a href="/admin/dashboard" style="display:flex; align-items:center; gap:8px; padding:10px 15px; border-radius:12px; background:#f0f4ff; color:#0d6efd; text-decoration:none; font-weight:600; font-size:0.88rem; margin-bottom:8px; transition:0.2s;" @onclick="ToggleProfileMenu">
                                    <i class="fas fa-tachometer-alt"></i> Dashboard
                                </a>
                            }

                            @if (context.User.IsInRole("Student") || context.User.IsInRole("student") || context.User.IsInRole("NewStudent") || context.User.IsInRole("newstudent") || context.User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && c.Value.ToLower().Contains("student")))
                            {
                                <a href="/profile" style="display:flex; align-items:center; gap:8px; padding:10px 15px; border-radius:12px; background:#f0f4ff; color:#5a4fcf; text-decoration:none; font-weight:600; font-size:0.88rem; margin-bottom:8px; transition:0.2s;" @onclick="ToggleProfileMenu">
                                    <i class="fas fa-user-circle"></i> My Profile
                                </a>
                                <a href="/student/personal-info" style="display:flex; align-items:center; gap:8px; padding:10px 15px; border-radius:12px; background:#f0f4ff; color:#0ea5e9; text-decoration:none; font-weight:600; font-size:0.88rem; margin-bottom:8px; transition:0.2s;" @onclick="ToggleProfileMenu">
                                    <i class="fas fa-user-edit"></i> Personal Info
                                </a>
                            }
                            @if (context.User.IsInRole("Tutor") || context.User.IsInRole("tutor") || context.User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && c.Value.ToLower().Contains("tutor")))
                            {
                                <a href="/tutor/profile" style="display:flex; align-items:center; gap:8px; padding:10px 15px; border-radius:12px; background:#f0f4ff; color:#2563eb; text-decoration:none; font-weight:600; font-size:0.88rem; margin-bottom:8px; transition:0.2s;" @onclick="ToggleProfileMenu">
                                    <i class="fas fa-id-badge"></i> My Profile
                                </a>
                            }
                            <button class="btn-logout-custom" @onclick="Logout">
                                <i class="fas fa-sign-out-alt"></i> Log Out
                            </button>
                        </div>
                    }
                </Authorized>
                <NotAuthorized>
                    <NavLink href="login" class="btn-apply"><i class="fas fa-sign-in-alt"></i> Login</NavLink>
                </NotAuthorized>
            </AuthorizeView>

            <div class="hamburger" @onclick="ToggleMobile">
                <span></span><span></span><span></span>
            </div>
        </div>
    </div>
</nav>

<div class="mobile-menu @(isMobileMenuOpen ? "open" : "")" id="mobileMenu">
    <button class="mobile-close" @onclick="ToggleMobile"><i class="fas fa-times"></i></button>
    <NavLink href="" Match="NavLinkMatch.All" @onclick="ToggleMobile">🏠 Home</NavLink>
    <NavLink href="department" @onclick="ToggleMobile">🏛️ Faculties</NavLink>
    <NavLink href="activities" @onclick="ToggleMobile">📅 Activities</NavLink>
    <NavLink href="library" @onclick="ToggleMobile">📖 Library</NavLink>
    <NavLink href="rules" @onclick="ToggleMobile">⚖️ Rules</NavLink>

    <AuthorizeView>
        <Authorized>
            <NavLink href="tutors" @onclick="ToggleMobile">👨‍🏫 Tutors</NavLink>
            @if (isApplyNowEnabled && !context.User.IsInRole("Admin") && !context.User.IsInRole("admin") && !context.User.IsInRole("Super Admin") && !context.User.IsInRole("super_admin") && !context.User.IsInRole("SuperAdmin") && !context.User.IsInRole("Tutor") && !context.User.IsInRole("tutor") && !context.User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && (c.Value.ToLower().Contains("admin") || c.Value.ToLower().Contains("super") || c.Value.ToLower().Contains("tutor"))))
            {
                <NavLink href="register" @onclick="ToggleMobile">👤 Register</NavLink>
            }
            <button class="nav-link" @onclick="Logout"
                    style="background:none; border:none; color:inherit; text-align:left;">🚪 Logout</button>
        </Authorized>
        <NotAuthorized>
            <NavLink href="login" @onclick="ToggleMobile">🔐 Login</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool isMobileMenuOpen = false;
    private bool isProfileMenuOpen = false;
    private bool isNotificationMenuOpen = false;
    private bool isApplyNowEnabled = true;

    private int currentUserId = 0;
    private int unreadCount = 0;
    private List<NotificationItem> notifications = new();
    private string? userProfileImage;

    private void ToggleMobile() => isMobileMenuOpen = !isMobileMenuOpen;
    private void ToggleProfileMenu() => isProfileMenuOpen = !isProfileMenuOpen;

    private async Task ToggleNotificationMenu()
    {
        isNotificationMenuOpen = !isNotificationMenuOpen;
        if (isNotificationMenuOpen)
        {
            isProfileMenuOpen = false; // close profile menu if open
            await MarkNotificationsAsRead();
        }
    }

    private async Task MarkNotificationsAsRead()
    {
        foreach (var noti in notifications)
        {
            noti.IsRead = true;
        }
        unreadCount = 0;
        await SaveNotifications();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        NotifierService.OnRegistrationStatusChanged += HandleRegistrationStatusChanged;
        NotifierService.OnPaymentStatusChanged += HandlePaymentStatusChanged;
        NotifierService.OnProfileImageChanged += HandleProfileImageChanged;

        await CheckAndLoadUser();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckAndLoadUser();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () =>
        {
            await CheckAndLoadUser();
            StateHasChanged();
        });
    }

    private async Task CheckAndLoadUser()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var userIdClaim = user.FindFirst("UserId")?.Value
                                  ?? user.FindFirst("User_Id")?.Value
                                  ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                                  ?? user.FindFirst("id")?.Value
                                  ?? user.FindFirst("uid")?.Value;
                if (int.TryParse(userIdClaim, out var id))
                {
                    bool userChanged = currentUserId != id;
                    currentUserId = id;
                    if (userChanged || string.IsNullOrEmpty(userProfileImage))
                    {
                        await LoadUserProfileImage();
                    }
                }
            }
            else
            {
                currentUserId = 0;
                userProfileImage = null;
            }

            await CheckApplyNowVisibility();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking user state: {ex.Message}");
        }
    }

    private async Task CheckApplyNowVisibility()
    {
        try
        {
            var res = await HttpClientService.ExecuteAsync<Smart_Campus_PUMUB.Components.Admin.Pages.Permission.ApplyNowStatusResponseModel>(
                "permission/student-apply-now-status", EnumHttpMethod.Get);
            if (res != null)
            {
                isApplyNowEnabled = res.IsEnabled;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching Apply Now visibility: {ex.Message}");
        }
    }

    private async Task LoadUserProfileImage()
    {
        if (currentUserId <= 0) return;

        try
        {
            var studentData = await HttpClientService.ExecuteAsync<StudentProfileResponse>(
                $"student/profile/{currentUserId}/image", EnumHttpMethod.Get);
            if (studentData != null && !string.IsNullOrEmpty(studentData.StudentImage))
            {
                userProfileImage = studentData.StudentImage;
                StateHasChanged();
                return;
            }

            var tutorData = await HttpClientService.ExecuteAsync<TutorProfileResponse>(
                $"tutor/profile/{currentUserId}", EnumHttpMethod.Get);
            if (tutorData != null && !string.IsNullOrEmpty(tutorData.Profile))
            {
                userProfileImage = tutorData.Profile;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading navbar profile image: {ex.Message}");
        }
    }

    private async Task HandleProfileImageChanged(int userId, string newImage)
    {
        if (userId == currentUserId)
        {
            await InvokeAsync(() =>
            {
                userProfileImage = newImage;
                StateHasChanged();
                return Task.CompletedTask;
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAndLoadUser();

            if (currentUserId > 0)
            {
                try
                {
                    var notiJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"notifications_{currentUserId}");
                    if (!string.IsNullOrEmpty(notiJson))
                    {
                        notifications = System.Text.Json.JsonSerializer.Deserialize<List<NotificationItem>>(notiJson) ?? new();
                        unreadCount = notifications.Count(n => !n.IsRead);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading notifications: {ex.Message}");
                }
            }

            StateHasChanged();
        }
    }

    private async Task SaveNotifications()
    {
        try
        {
            var notiJson = System.Text.Json.JsonSerializer.Serialize(notifications);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"notifications_{currentUserId}", notiJson);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving notifications: {ex.Message}");
        }
    }

    private async Task HandleRegistrationStatusChanged(StudentRegistrationStatusChangedEventArgs args)
    {
        if (args.UserId == currentUserId || args.UserId == null)
        {
            await InvokeAsync(async () =>
            {
                var newNoti = new NotificationItem
                {
                    Message = $"ကျောင်းအပ်နှံမှု အခြေအနေ: သင်၏ကျောင်းအပ်နှံမှုအချက်အလက်ကို {(args.Status == "Approved" ? "အတည်ပြုပြီးပါပြီ" : args.Status == "Rejected" ? "ငြင်းပယ်လိုက်ပါသည်" : args.Status)} ဖြစ်ပါသည်။",
                    Type = args.Status == "Approved" ? "success" : "danger",
                    Timestamp = DateTime.Now,
                    IsRead = false
                };
                notifications.Insert(0, newNoti);
                unreadCount = notifications.Count(n => !n.IsRead);
                await SaveNotifications();
                StateHasChanged();
            });
        }
    }

    private async Task HandlePaymentStatusChanged(StudentPaymentStatusChangedEventArgs args)
    {
        if (args.UserId == currentUserId || args.UserId == null)
        {
            await InvokeAsync(async () =>
            {
                var newNoti = new NotificationItem
                {
                    Message = $"ငွေပေးချေမှု အခြေအနေ: သင်၏ KBZPay (MMQR) ကျောင်းလခငွေပေးချေမှုကို {(args.Status == "Approved" ? "အောင်မြင်စွာ အတည်ပြုပြီးပါပြီ" : args.Status == "Rejected" ? "ငြင်းပယ်လိုက်ပါသည်" : args.Status)} ဖြစ်ပါသည်။",
                    Type = args.Status == "Approved" ? "success" : "danger",
                    Timestamp = DateTime.Now,
                    IsRead = false
                };
                notifications.Insert(0, newNoti);
                unreadCount = notifications.Count(n => !n.IsRead);
                await SaveNotifications();
                StateHasChanged();
            });
        }
    }

    private async Task Logout()
    {
        var customAuth = (CustomAuthStateProvider)AuthStateProvider;
        await customAuth.MarkUserAsLoggedOut();
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "false");
        NavigationManager.NavigateTo("/", true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        NotifierService.OnRegistrationStatusChanged -= HandleRegistrationStatusChanged;
        NotifierService.OnPaymentStatusChanged -= HandlePaymentStatusChanged;
        NotifierService.OnProfileImageChanged -= HandleProfileImageChanged;
    }

    public class NotificationItem
    {
        public string Message { get; set; } = "";
        public string Type { get; set; } = "info"; // "success" or "danger"
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public bool IsRead { get; set; } = false;
    }

    private class StudentProfileResponse
    {
        public string? StudentImage { get; set; }
    }

    private class TutorProfileResponse
    {
        public string? Profile { get; set; }
    }
}